package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// listHiddenInputs repeats the page's state (search, sort and the filters of every
// column except skip) as hidden form fields, so submitting a form keeps it.
templ listHiddenInputs(lv ListView, skip string) {
	for k, vals := range lv.values(skip) {
		<input type="hidden" name={ k } value={ vals[0] }/>
	}
}

// listActiveFilters is the line above a table that says whether column filters are on.
// It's always there, in one of two states, so turning a filter on or off doesn't move the
// table.
templ listActiveFilters(lv ListView) {
	<p class="active-filters">
		if lv.HasFilters() {
			Filtros activos en la tabla.
			<a href={ templ.URL(lv.ClearHref("")) }>Quitar todos</a>
		} else {
			Sin filtros. Usa el embudo de cada columna para filtrar.
		}
	</p>
}

// columnHeader renders one <th>: a click-to-sort link and a funnel that opens that
// column's filter, typed after the column (text, choice, number range or date range).
// The filter is a popover, which renders in the top layer, so the table can sit in a
// scroll container without clipping it; app.js positions it under the funnel. The
// popover gives light dismiss, Escape and focus return for free.
// Both are plain full-page GETs, not htmx — htmx's live search only swaps the tbody, so
// a swapped header click would leave the arrows and next-toggle hrefs stale.
templ columnHeader(lv ListView, label, col string, f ColumnFilter) {
	<th class={ "col-header", templ.KV("num", f.Kind == store.FilterNumber) }>
		<a href={ templ.URL(lv.SortHref(col)) }>{ label } { lv.SortIndicator(col) }</a>
		<span class={ "col-filter", templ.KV("active", lv.FilterActive(col)) }>
			<button type="button" class="col-filter-toggle" popovertarget={ "filtro-" + col } title={ "Filtrar por " + label } aria-label={ "Filtrar por " + label }>
				<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M1 2h14l-5.5 6.5V14l-3-1.5V8.5z" fill="currentColor"></path></svg>
			</button>
			<form method="get" action={ templ.URL(lv.Base) } class="col-filter-panel" id={ "filtro-" + col } popover>
				@listHiddenInputs(lv, col)
				// Names the column: a panel wider than its column hangs under the
				// neighbours' headers, so position alone doesn't say whose filter it is.
				<p class="col-filter-title">Filtrar por { label }</p>
				switch f.Kind {
					case store.FilterText:
						if len(f.Options) > 0 {
							@filterChoices(lv, label, col+".is", f.Options)
						} else {
							<label>
								{ label } contiene
								<input type="text" name={ filterParam(col) } value={ lv.FilterValue(col) }/>
							</label>
						}
					case store.FilterEnum:
						@filterChoices(lv, label, col, f.Options)
					case store.FilterNumber:
						<label>
							Desde
							<input type="number" step="any" name={ filterParam(col + ".min") } value={ lv.FilterValue(col + ".min") }/>
						</label>
						<label>
							Hasta
							<input type="number" step="any" name={ filterParam(col + ".max") } value={ lv.FilterValue(col + ".max") }/>
						</label>
					case store.FilterDate:
						<label>
							Desde
							<input type="date" name={ filterParam(col + ".min") } value={ lv.FilterValue(col + ".min") }/>
						</label>
						<label>
							Hasta
							<input type="date" name={ filterParam(col + ".max") } value={ lv.FilterValue(col + ".max") }/>
						</label>
				}
				<div class="col-filter-actions">
					<button type="submit" class="primary">Aplicar</button>
					<a href={ templ.URL(lv.ClearHref(col)) }>Limpiar</a>
				</div>
			</form>
		</span>
	</th>
}

// filterChoices is a column's list of options as checkboxes: tick any number, or none
// for no filter.
templ filterChoices(lv ListView, label, key string, opts []FilterOption) {
	<fieldset class="filter-choices">
		<legend>{ label }</legend>
		for _, o := range opts {
			<label>
				<input type="checkbox" name={ filterParam(key) } value={ o.Value } checked?={ lv.FilterSelected(key, o.Value) }/>
				{ o.Label }
			</label>
		}
	</fieldset>
}

// listPager is the page navigation under a table (an empty placeholder when everything
// fits on one page). oob marks it as an out-of-band htmx swap, so the live search
// response can refresh it alongside the table body.
templ listPager(lv ListView, oob bool) {
	<nav id="pager" class="pager" aria-label="Paginación" { pagerAttrs(oob)... }>
		if lv.Pager.Total > PerPageChoices[0] {
			<span>
				{ strconv.Itoa((lv.Pager.Page-1)*lv.Pager.PerPage + 1) }–{ strconv.Itoa(min(lv.Pager.Page*lv.Pager.PerPage, lv.Pager.Total)) } de { strconv.Itoa(lv.Pager.Total) }
			</span>
			if lv.Pager.Page > 1 {
				<a href={ templ.URL(lv.PageHref(lv.Pager.Page - 1)) } rel="prev">← Anterior</a>
			}
			<span>Página { strconv.Itoa(lv.Pager.Page) } de { strconv.Itoa(lv.Pager.Pages) }</span>
			if lv.Pager.Page < lv.Pager.Pages {
				<a href={ templ.URL(lv.PageHref(lv.Pager.Page + 1)) } rel="next">Siguiente →</a>
			}
			<form method="get" action={ templ.URL(lv.Base + lv.fragment()) } class="per-page">
				@listHiddenInputs(lv, "per")
				<label>
					Filas por página
					<select name="per" class="per-page-select">
						for _, n := range PerPageChoices {
							<option value={ strconv.Itoa(n) } selected?={ lv.Pager.PerPage == n }>{ strconv.Itoa(n) }</option>
						}
					</select>
				</label>
				<noscript><button type="submit">Aplicar</button></noscript>
			</form>
		}
	</nav>
}

func pagerAttrs(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return nil
}

// ListPagerOOB is the pager as an out-of-band swap, for htmx table-body responses.
templ ListPagerOOB(lv ListView) {
	@listPager(lv, true)
}
