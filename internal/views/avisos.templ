package views

import "github.com/gerrygoo/cladex-web/internal/store"

// ContactForm is Mi cuenta's Avisos form: the user's email and WhatsApp, which of them to
// be notified on, and which avisos (kinds) they get, among those offered to their role
// (an admin sees the AdminOnly ones too). It posts to action. Only the user sets their
// own (#69).
templ ContactForm(action string, c store.UserContact, kinds map[string]bool, errs map[string]string, role string) {
	<form method="post" action={ templ.URL(action) }>
		<label>
			Correo
			<input type="email" name="email" value={ c.Email } autocomplete="email" placeholder="p. ej. ana@cladex.com.mx" { errAttrs(errs, "email")... }/>
		</label>
		@FieldError(errs, "email")
		<label>
			WhatsApp <span class="hint">(10 dígitos; con lada de país si no es de México)</span>
			<input type="tel" name="whatsapp" value={ c.WhatsApp } autocomplete="tel" placeholder="p. ej. 33 1234 5678" { errAttrs(errs, "whatsapp")... }/>
		</label>
		@FieldError(errs, "whatsapp")
		<fieldset>
			<legend>Recibir avisos por</legend>
			<label>
				<input type="checkbox" name="notify_email" value="1" checked?={ c.NotifyEmail }/>
				Correo
			</label>
			<label>
				<input type="checkbox" name="notify_whatsapp" value="1" checked?={ c.NotifyWhatsApp }/>
				WhatsApp
			</label>
		</fieldset>
		<fieldset>
			<legend>Avisos</legend>
			for _, k := range store.AvisoKinds {
				if k.Offered(role) {
					<label>
						<input type="checkbox" name="aviso" value={ k.Key } checked?={ kinds[k.Key] }/>
						{ k.Label }
						<span class="hint">{ k.Description }</span>
					</label>
				}
			}
		</fieldset>
		<button type="submit" class="primary">Guardar avisos</button>
	</form>
}
