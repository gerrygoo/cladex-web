package views

import (
	"strconv"
	"time"

	"github.com/gerrygoo/cladex-web/internal/facturoporti"
	"github.com/gerrygoo/cladex-web/internal/store"
)

func materialFormID(m store.Material) string {
	return "material-" + strconv.FormatInt(m.ID, 10)
}

func marginFormID(o store.MarginOption) string {
	return "margen-" + strconv.FormatInt(o.ID, 10)
}

func marginPath(o store.MarginOption, action string) string {
	path := "/ajustes/margenes/" + strconv.FormatInt(o.ID, 10)
	if action != "" {
		path += "/" + action
	}
	return path
}

// Ajustes is the admin settings page, shown as "Configuración del sistema" (it sets what
// everyone's quotes use, not the admin's own preferences): the margin options, each
// edited, made default, retired or restored by its own small form, then the materials
// and their prices.
// errorMsg is a refused margin or material action.
templ Ajustes(margins []store.MarginOption, materials []store.Material, units []store.Unit, facturacion facturoporti.Status, emisor store.Emisor, emisorErrs map[string]string, successMsg string, errorMsg string, user *NavUser) {
	@Layout("Configuración del sistema", user) {
		<div class="page-title">
			<h1>Configuración del sistema</h1>
			@HelpLink(HelpAjustes)
		</div>
		@Flash(successMsg)
		@FormError(errorMsg)
		<h2>Márgenes</h2>
		<p>Cada cotización se calcula con uno de estos márgenes; el vendedor lo elige al armarla.</p>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Margen (%)</th>
						<th>Estado</th>
						<th><span class="visually-hidden">Acciones</span></th>
					</tr>
				</thead>
				<tbody>
					for _, m := range margins {
						<tr>
							// The inputs sit in their own cells and join the row's edit form, which
							// lives in the actions cell, through the form attribute.
							<td>
								<input type="text" form={ marginFormID(m) } name="name" value={ m.Name } aria-label={ "Nombre del margen " + m.Name } required/>
							</td>
							<td>
								<input type="text" form={ marginFormID(m) } name="value" value={ MarginPercent(m.ValueMicros) } size="8" aria-label={ "Porcentaje del margen " + m.Name } required/>
							</td>
							<td>
								if !m.Active() {
									Retirado
								} else if m.IsDefault {
									<strong>Predeterminado</strong>
								} else {
									Activo
								}
							</td>
							<td class="actions">
								<form id={ marginFormID(m) } method="post" action={ templ.URL(marginPath(m, "")) }>
									<button type="submit">Guardar<span class="visually-hidden">{ " " + m.Name }</span></button>
								</form>
								if !m.Active() {
									<form method="post" action={ templ.URL(marginPath(m, "restaurar")) }>
										<button type="submit">Restaurar<span class="visually-hidden">{ " " + m.Name }</span></button>
									</form>
								} else if !m.IsDefault {
									<form method="post" action={ templ.URL(marginPath(m, "predeterminado")) }>
										<button type="submit">Hacer predeterminado<span class="visually-hidden">{ " " + m.Name }</span></button>
									</form>
									<form method="post" action={ templ.URL(marginPath(m, "retirar")) }>
										<button type="submit" class="danger">Retirar<span class="visually-hidden">{ " " + m.Name }</span></button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h3>Nuevo margen</h3>
		<form method="post" action="/ajustes/margenes">
			<label>
				Nombre
				<input type="text" name="name" placeholder="p. ej. Distribuidor" required/>
			</label>
			<label>
				Margen (%)
				<input type="text" name="value" placeholder="p. ej. 12.34" required/>
			</label>
			<button type="submit">Agregar</button>
		</form>
		<div class="section-title">
			<h2>Materiales</h2>
			@SectionHelpLink(HelpMateriales, "materiales")
		</div>
		<p>Costo de cada material, sin margen. Los productos hechos de un material se cotizan con su contenido × este precio, más el margen de la cotización.</p>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Precio (pesos por unidad)</th>
						<th>Unidad</th>
						<th>Actualizado</th>
						<th><span class="visually-hidden">Acciones</span></th>
					</tr>
				</thead>
				<tbody>
					if len(materials) == 0 {
						<tr>
							<td colspan="5">No hay materiales.</td>
						</tr>
					}
					for _, m := range materials {
						<tr>
							<td>
								<input type="text" form={ materialFormID(m) } name="name" value={ m.Name } aria-label={ "Nombre del material " + m.Name } required/>
							</td>
							<td>
								<input type="text" form={ materialFormID(m) } name="price" value={ m.PriceMicros.String() } size="10" aria-label={ "Precio del material " + m.Name } required/>
							</td>
							<td>{ m.UnitCode }</td>
							<td>{ MaterialAge(m.UpdatedAt, time.Now()) }</td>
							<td class="actions">
								<form id={ materialFormID(m) } method="post" action={ templ.URL("/ajustes/materiales/" + strconv.FormatInt(m.ID, 10)) }>
									<button type="submit">Guardar<span class="visually-hidden">{ " " + m.Name }</span></button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h3>Nuevo material</h3>
		<form method="post" action="/ajustes/materiales">
			<label>
				Nombre
				<input type="text" name="name" placeholder="p. ej. Cobre" required/>
			</label>
			<label>
				Unidad
				<select name="unit_id" required>
					for _, u := range units {
						<option value={ strconv.FormatInt(u.ID, 10) } selected?={ u.Code == "kg" }>{ u.Name } ({ u.Code })</option>
					}
				</select>
			</label>
			<label>
				Precio (pesos por unidad)
				<input type="text" name="price" placeholder="p. ej. 160.00" required/>
			</label>
			<button type="submit">Agregar</button>
		</form>
		<h2>Facturación</h2>
		<p>Los datos para timbrar con Facturoporti (token y certificado de sello digital) se instalan en el servidor, no aquí.</p>
		<dl class="facturacion-status">
			<dt>Ambiente</dt>
			<dd>
				if facturacion.Sandbox {
					Pruebas (los timbres no son válidos)
				} else {
					Producción
				}
			</dd>
			<dt>Estado</dt>
			<dd>
				if facturacion.Enabled {
					Lista para timbrar
				} else {
					Apagada: { facturacion.Problem }
				}
			</dd>
			if facturacion.RFC != "" {
				<dt>Certificado</dt>
				<dd>RFC { facturacion.RFC } · No. { facturacion.Number } · vence el { facturacion.Expires.Format("2006-01-02") }</dd>
			}
		</dl>
		<h3 id="emisor">Emisor</h3>
		<p>Los datos de Cladex como aparecen en su constancia de situación fiscal. El RFC debe ser el del certificado instalado.</p>
		<form method="post" action="/ajustes/emisor">
			<label>
				RFC
				<input type="text" name="rfc" value={ emisor.RFC } maxlength="13" autocapitalize="characters" required { errAttrs(emisorErrs, "rfc")... }/>
			</label>
			@FieldError(emisorErrs, "rfc")
			<label>
				Razón social (sin el régimen de capital, p. ej. sin «S.A. de C.V.»)
				<input type="text" name="nombre" value={ emisor.Name } required { errAttrs(emisorErrs, "nombre")... }/>
			</label>
			@FieldError(emisorErrs, "nombre")
			<label>
				Régimen fiscal
				<select name="regimen" required { errAttrs(emisorErrs, "regimen")... }>
					<option value="">Elige…</option>
					for _, c := range store.TaxRegimes {
						<option value={ c.Code } selected?={ c.Code == emisor.TaxRegime }>{ c.Code } - { c.Description }</option>
					}
				</select>
			</label>
			@FieldError(emisorErrs, "regimen")
			<label>
				Código postal del lugar de expedición
				<input type="text" name="cp" value={ emisor.PostalCode } inputmode="numeric" maxlength="5" required { errAttrs(emisorErrs, "cp")... }/>
			</label>
			@FieldError(emisorErrs, "cp")
			<label>
				Serie de las facturas
				<input type="text" name="serie_factura" value={ emisor.SerieFactura } maxlength="10" required { errAttrs(emisorErrs, "serie_factura")... }/>
			</label>
			@FieldError(emisorErrs, "serie_factura")
			<label>
				Serie de los comprobantes de pago
				<input type="text" name="serie_pago" value={ emisor.SeriePago } maxlength="10" required { errAttrs(emisorErrs, "serie_pago")... }/>
			</label>
			@FieldError(emisorErrs, "serie_pago")
			<button type="submit">Guardar emisor</button>
		</form>
	}
}
