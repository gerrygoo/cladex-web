package views

import (
	"strconv"
	"time"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// SettingFieldView is one row of the /ajustes form: a settings.key, its current
// display value (a plain decimal string, already converted from stored micros), and
// any validation error for it.
type SettingFieldView struct {
	Key         string
	Label       string
	Placeholder string
	Value       string
	Error       string
}

func materialFormID(m store.Material) string {
	return "material-" + strconv.FormatInt(m.ID, 10)
}

func marginFormID(o store.MarginOption) string {
	return "margen-" + strconv.FormatInt(o.ID, 10)
}

func marginPath(o store.MarginOption, action string) string {
	path := "/ajustes/margenes/" + strconv.FormatInt(o.ID, 10)
	if action != "" {
		path += "/" + action
	}
	return path
}

// Ajustes is the admin settings page: the single-value knobs (the FX rate) in one
// all-or-nothing form, then the margin options, each edited, made default, retired or
// restored by its own small form, then the materials and their prices. errorMsg is a
// refused margin or material action.
templ Ajustes(fields []SettingFieldView, margins []store.MarginOption, materials []store.Material, units []store.Unit, successMsg string, errorMsg string, user *NavUser) {
	@Layout("Ajustes", user) {
		<h1>
			Ajustes
			@HelpLink(HelpAjustes)
		</h1>
		if successMsg != "" {
			<p class="success">{ successMsg }</p>
		}
		if errorMsg != "" {
			<p class="error">{ errorMsg }</p>
		}
		<form method="post" action="/ajustes">
			for _, f := range fields {
				<label>
					{ f.Label }
					<input type="text" name={ f.Key } value={ f.Value } placeholder={ f.Placeholder } required/>
				</label>
				if f.Error != "" {
					<p class="error">{ f.Error }</p>
				}
			}
			<button type="submit">Guardar</button>
		</form>
		<h2>
			Márgenes
			@HelpLink(HelpMargenes)
		</h2>
		<p>Cada cotización se calcula con uno de estos márgenes; el vendedor lo elige al armarla.</p>
		<table>
			<thead>
				<tr>
					<th>Nombre</th>
					<th>Margen (%)</th>
					<th>Estado</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, m := range margins {
					<tr>
						// The inputs sit in their own cells and join the row's edit form, which
						// lives in the actions cell, through the form attribute.
						<td>
							<input type="text" form={ marginFormID(m) } name="name" value={ m.Name } aria-label="Nombre" required/>
						</td>
						<td>
							<input type="text" form={ marginFormID(m) } name="value" value={ MarginPercent(m.ValueMicros) } size="8" aria-label="Margen (%)" required/>
						</td>
						<td>
							if !m.Active() {
								Retirado
							} else if m.IsDefault {
								<strong>Predeterminado</strong>
							} else {
								Activo
							}
						</td>
						<td>
							<form id={ marginFormID(m) } method="post" action={ templ.URL(marginPath(m, "")) } style="display:inline">
								<button type="submit">Guardar</button>
							</form>
							if !m.Active() {
								<form method="post" action={ templ.URL(marginPath(m, "restaurar")) } style="display:inline">
									<button type="submit">Restaurar</button>
								</form>
							} else if !m.IsDefault {
								<form method="post" action={ templ.URL(marginPath(m, "predeterminado")) } style="display:inline">
									<button type="submit">Hacer predeterminado</button>
								</form>
								<form method="post" action={ templ.URL(marginPath(m, "retirar")) } style="display:inline">
									<button type="submit">Retirar</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<h3>Nuevo margen</h3>
		<form method="post" action="/ajustes/margenes">
			<label>
				Nombre
				<input type="text" name="name" placeholder="p. ej. Distribuidor" required/>
			</label>
			<label>
				Margen (%)
				<input type="text" name="value" placeholder="p. ej. 12.34" required/>
			</label>
			<button type="submit">Agregar</button>
		</form>
		<h2>
			Materiales
			@HelpLink(HelpMateriales)
		</h2>
		<p>Costo de cada material, sin margen. Los productos hechos de un material se cotizan con su contenido × este precio, más el margen de la cotización.</p>
		<table>
			<thead>
				<tr>
					<th>Nombre</th>
					<th>Precio (pesos por unidad)</th>
					<th>Unidad</th>
					<th>Actualizado</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				if len(materials) == 0 {
					<tr>
						<td colspan="5">No hay materiales.</td>
					</tr>
				}
				for _, m := range materials {
					<tr>
						<td>
							<input type="text" form={ materialFormID(m) } name="name" value={ m.Name } aria-label="Nombre" required/>
						</td>
						<td>
							<input type="text" form={ materialFormID(m) } name="price" value={ m.PriceMicros.String() } size="10" aria-label="Precio" required/>
						</td>
						<td>{ m.UnitCode }</td>
						<td>{ MaterialAge(m.UpdatedAt, time.Now()) }</td>
						<td>
							<form id={ materialFormID(m) } method="post" action={ templ.URL("/ajustes/materiales/" + strconv.FormatInt(m.ID, 10)) } style="display:inline">
								<button type="submit">Guardar</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<h3>Nuevo material</h3>
		<form method="post" action="/ajustes/materiales">
			<label>
				Nombre
				<input type="text" name="name" placeholder="p. ej. Cobre" required/>
			</label>
			<label>
				Unidad
				<select name="unit_id" required>
					for _, u := range units {
						<option value={ strconv.FormatInt(u.ID, 10) } selected?={ u.Code == "kg" }>{ u.Name } ({ u.Code })</option>
					}
				</select>
			</label>
			<label>
				Precio (pesos por unidad)
				<input type="text" name="price" placeholder="p. ej. 160.00" required/>
			</label>
			<button type="submit">Agregar</button>
		</form>
	}
}
