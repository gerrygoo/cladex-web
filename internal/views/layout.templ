package views

// NavUser is the trimmed view-model Layout needs to render the signed-in state —
// callers build it from store.AuthenticatedUser without views importing internal/store.
type NavUser struct {
	Username string
	IsAdmin  bool
}

templ Layout(title string, user *NavUser) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Cladex</title>
			<link rel="icon" href={ Asset("favicon.svg") } type="image/svg+xml"/>
			<link rel="icon" href={ Asset("favicon.ico") } sizes="48x48"/>
			<link rel="apple-touch-icon" href={ Asset("apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ Asset("app.css") }/>
			<script src={ Asset("htmx.min.js") } defer></script>
			<script src={ Asset("filters.js") } defer></script>
			<script src={ Asset("time.js") } defer></script>
			<script src={ Asset("app.js") } defer></script>
		</head>
		<body>
			<a class="skip-link" href="#contenido">Saltar al contenido</a>
			// Shown only when app.css didn't load (app.css hides it): the page still works,
			// but looks broken, so it says how to fix it (issues #79, #80).
			<p class="css-check">
				<strong>Esta página no cargó su diseño.</strong> Presiona <kbd>Ctrl</kbd> + <kbd>F5</kbd> para recargarla. Si sigue igual, consulta <a href="/ayuda/acceso#la-página-se-ve-sin-diseño">La página se ve sin diseño</a> en el Manual de usuario.
			</p>
			if banner := environmentBanner(ctx); banner != "" {
				<p class="env-banner" role="note">{ banner }</p>
			}
			<noscript>
				<p class="noscript-banner">
					JavaScript está desactivado. La aplicación funciona igual, pero cada acción recarga la página completa; actívalo para una experiencia más rápida.
				</p>
			</noscript>
			<header class="app-header">
				<div class="brand">
					<a href="/" class="brand-link"><img src={ Asset("cladex-logo.svg") } alt="Cladex" width="168" height="32"/></a>
					if user != nil {
						<nav class="app-nav">
							// Each section is a disclosure menu so the bar stays short on a phone. A
							// native <details>: it opens and closes without JS; static/app.js only
							// closes it on Escape or a click elsewhere.
							<details class="nav-menu">
								<summary>Dashboard</summary>
								<ul>
									<li><a href="/">Mis pendientes</a></li>
									if user.IsAdmin {
										<li><a href="/dashboard/equipo">Equipo</a></li>
									}
								</ul>
							</details>
							<details class="nav-menu">
								<summary>Leads</summary>
								<ul>
									<li><a href="/leads/nuevo">Nuevo lead</a></li>
									<li><a href="/leads">Ver leads</a></li>
									<li><a href="/listas-de-precios">Listas de precios</a></li>
								</ul>
							</details>
							<details class="nav-menu">
								<summary>Cotizaciones</summary>
								<ul>
									<li><a href="/cotizaciones/nueva">Nueva cotización</a></li>
									<li><a href="/cotizaciones">Ver cotizaciones</a></li>
								</ul>
							</details>
							<details class="nav-menu">
								<summary>Proyectos</summary>
								<ul>
									<li><a href="/proyectos">Ver proyectos</a></li>
									<li><a href="/pronostico">Pronóstico</a></li>
									<li><a href="/facturas">Facturas</a></li>
								</ul>
							</details>
							// The supporting tables.
							<details class="nav-menu">
								<summary>Catálogos</summary>
								<ul>
									<li><a href="/productos">Productos</a></li>
									<li><a href="/clientes">Clientes</a></li>
									<li><a href="/proveedores">Proveedores</a></li>
									if user.IsAdmin {
										<li><a href="/usuarios">Usuarios</a></li>
										<li><a href="/familias">Familias y tipos de cotización</a></li>
										<li><a href="/unidades">Unidades</a></li>
										<li><a href="/ajustes">Configuración del sistema</a></li>
									}
								</ul>
							</details>
							<a href="/documentos">Documentos oficiales</a>
						</nav>
					}
				</div>
				if user != nil {
					<div class="nav-user">
						<a href="/ayuda">Manual de usuario</a>
						<a href="/mi-cuenta">{ user.Username }</a>
					</div>
				}
			</header>
			<main class="app-main" id="contenido" tabindex="-1">
				{ children... }
			</main>
			// Announces what htmx swaps change (a recalculated total, search results); see
			// data-announce in static/app.js.
			<div id="live-status" class="visually-hidden" role="status"></div>
		</body>
	</html>
}
