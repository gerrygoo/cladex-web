package views

// NavUser is the trimmed view-model Layout needs to render the signed-in state —
// callers build it from store.AuthenticatedUser without views importing internal/store.
type NavUser struct {
	Username string
	IsAdmin  bool
}

templ Layout(title string, user *NavUser) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Cladex</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<noscript>
				<p class="noscript-banner">
					JavaScript está desactivado. La aplicación funciona igual, pero cada acción recarga la página completa; actívalo para una experiencia más rápida.
				</p>
			</noscript>
			<header class="app-header">
				<div class="brand">
					<strong>Cladex</strong>
					if user != nil {
						<nav class="app-nav">
							<a href="/cotizaciones">Cotizaciones</a>
							<a href="/productos">Productos</a>
							<a href="/clientes">Clientes</a>
							if user.IsAdmin {
								<a href="/usuarios">Usuarios</a>
								<a href="/unidades">Unidades</a>
								<a href="/ajustes">Ajustes</a>
							}
						</nav>
					}
				</div>
				if user != nil {
					<div class="nav-user">
						<a href="/ayuda">Ayuda</a>
						<a href="/mi-cuenta">{ user.Username }</a>
						<form method="post" action="/logout">
							<button type="submit">Salir</button>
						</form>
					</div>
				}
			</header>
			<main class="app-main">
				{ children... }
			</main>
		</body>
	</html>
}
