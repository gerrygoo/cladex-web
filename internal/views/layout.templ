package views

// NavUser is the trimmed view-model Layout needs to render the signed-in state —
// callers build it from store.AuthenticatedUser without views importing internal/store.
type NavUser struct {
	Username string
}

templ Layout(title string, user *NavUser) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Cladex</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			<header class="app-header">
				<strong>Cladex</strong>
				if user != nil {
					<form method="post" action="/logout" class="nav-user">
						<span>{ user.Username }</span>
						<button type="submit">Salir</button>
					</form>
				}
			</header>
			<main class="app-main">
				{ children... }
			</main>
		</body>
	</html>
}
