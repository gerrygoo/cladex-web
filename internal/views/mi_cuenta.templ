package views

import "github.com/gerrygoo/cladex-web/internal/store"

// MiCuentaView is what /mi-cuenta shows: the password form's errors, the user's Avisos
// (saved, or a refused submission with ContactErrors) and a success message. ContactSaved
// shows the Avisos' own, next to the form the page scrolls to.
type MiCuentaView struct {
	PasswordErrors map[string]string
	Contact        store.UserContact
	Avisos         map[string]bool
	ContactErrors  map[string]string
	ContactSaved   bool
	Success        string
}

templ MiCuenta(m MiCuentaView, user *NavUser) {
	@Layout("Mi cuenta", user) {
		<div class="page-title">
			<h1>Mi cuenta</h1>
			@HelpLink(HelpMiCuenta)
		</div>
		@Flash(m.Success)
		<h2>Sesión</h2>
		<p>
			Entraste como
			<strong>{ user.Username }</strong>.
			Cierra la sesión al terminar si la computadora es compartida.
		</p>
		<form method="post" action="/logout">
			<button type="submit">Cerrar sesión</button>
		</form>
		<h2>Cambiar contraseña</h2>
		<form method="post" action="/mi-cuenta">
			<label>
				Contraseña actual
				<input type="password" name="current_password" required autocomplete="current-password" { errAttrs(m.PasswordErrors, "current_password")... }/>
			</label>
			@FieldError(m.PasswordErrors, "current_password")
			<label>
				Contraseña nueva <span class="hint">(mínimo 8 caracteres)</span>
				<input type="password" name="new_password" required autocomplete="new-password" minlength="8" { errAttrs(m.PasswordErrors, "new_password")... }/>
			</label>
			@FieldError(m.PasswordErrors, "new_password")
			<label>
				Confirmar contraseña nueva
				<input type="password" name="confirm_password" required autocomplete="new-password" minlength="8" { errAttrs(m.PasswordErrors, "confirm_password")... }/>
			</label>
			@FieldError(m.PasswordErrors, "confirm_password")
			<button type="submit" class="primary">Cambiar contraseña</button>
		</form>
		<div class="section-title">
			<h2 id="avisos">Avisos</h2>
			@SectionHelpLink(HelpAvisos, "avisos")
		</div>
		if m.ContactSaved {
			@Flash("Avisos guardados.")
		}
		<p>Dónde y de qué quieres que la app te avise. Todos los avisos empiezan apagados: marca los que te sirvan.</p>
		@ContactForm("/mi-cuenta/avisos", m.Contact, m.Avisos, m.ContactErrors, navRole(user))
	}
}

// navRole is the signed-in user's role, for what Avisos offers them.
func navRole(user *NavUser) string {
	if user != nil && user.IsAdmin {
		return store.RoleAdmin
	}
	return store.RoleVendedor
}
