package views

templ MiCuenta(fieldErrors map[string]string, successMsg string, user *NavUser) {
	@Layout("Mi cuenta", user) {
		<div class="page-title">
			<h1>Mi cuenta</h1>
			@HelpLink(HelpMiCuenta)
		</div>
		@Flash(successMsg)
		<h2>Sesión</h2>
		<p>
			Entraste como
			<strong>{ user.Username }</strong>.
			Cierra la sesión al terminar si la computadora es compartida.
		</p>
		<form method="post" action="/logout">
			<button type="submit">Cerrar sesión</button>
		</form>
		<h2>Cambiar contraseña</h2>
		<form method="post" action="/mi-cuenta">
			<label>
				Contraseña actual
				<input type="password" name="current_password" required autocomplete="current-password" { errAttrs(fieldErrors, "current_password")... }/>
			</label>
			@FieldError(fieldErrors, "current_password")
			<label>
				Contraseña nueva <span class="hint">(mínimo 8 caracteres)</span>
				<input type="password" name="new_password" required autocomplete="new-password" minlength="8" { errAttrs(fieldErrors, "new_password")... }/>
			</label>
			@FieldError(fieldErrors, "new_password")
			<label>
				Confirmar contraseña nueva
				<input type="password" name="confirm_password" required autocomplete="new-password" minlength="8" { errAttrs(fieldErrors, "confirm_password")... }/>
			</label>
			@FieldError(fieldErrors, "confirm_password")
			<button type="submit" class="primary">Cambiar contraseña</button>
		</form>
	}
}
