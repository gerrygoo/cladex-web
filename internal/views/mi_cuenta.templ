package views

templ MiCuenta(fieldErrors map[string]string, successMsg string, user *NavUser) {
	@Layout("Mi cuenta", user) {
		<h1>Mi cuenta</h1>
		if successMsg != "" {
			<p class="success">{ successMsg }</p>
		}
		<form method="post" action="/mi-cuenta">
			<label>
				Contraseña actual
				<input type="password" name="current_password" required/>
			</label>
			if fieldErrors["current_password"] != "" {
				<p class="error">{ fieldErrors["current_password"] }</p>
			}
			<label>
				Contraseña nueva
				<input type="password" name="new_password" required minlength="8"/>
			</label>
			if fieldErrors["new_password"] != "" {
				<p class="error">{ fieldErrors["new_password"] }</p>
			}
			<label>
				Confirmar contraseña nueva
				<input type="password" name="confirm_password" required minlength="8"/>
			</label>
			if fieldErrors["confirm_password"] != "" {
				<p class="error">{ fieldErrors["confirm_password"] }</p>
			}
			<button type="submit">Cambiar contraseña</button>
		</form>
	}
}
