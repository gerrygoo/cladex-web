package views

import (
	"strconv"
	"strings"

	"github.com/gerrygoo/cladex-web/internal/cfdi"
	"github.com/gerrygoo/cladex-web/internal/money"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// FacturaView is everything the page of one comprobante (factura or comprobante de pago)
// shows. Related is the factura a pago pays or a replacement replaces; Replacement is the
// factura that replaces this one, Pago the comprobante de pago of this P.P.D. factura.
// Problems is what a draft still needs before it can be validated. Enabled and Sandbox
// describe this instance's facturación; WrongEnv marks a comprobante made for the other
// Facturoporti host, which can't be stamped or cancelled here.
type FacturaView struct {
	C           store.Comprobante
	Related     *store.Comprobante
	Replacement *store.Comprobante
	Pago        *store.Comprobante
	// Pagos are every complemento de pago of this factura, cancelled ones included, oldest
	// first; Saldo is what they still leave unpaid. Unlinked are the proyecto's payments in
	// Cobro that no comprobante covers, which a complemento recorded by hand can link to.
	Pagos    []store.Comprobante
	Saldo    money.Centavos
	Unlinked []store.Payment
	Problems []string
	Events   []store.ComprobanteEvent
	Enabled  bool
	Sandbox  bool
	WrongEnv bool
	Today    string
	Success  string
	Error    string
}

func facturaPath(id int64) string { return "/facturas/" + strconv.FormatInt(id, 10) }

// ComprobanteTitle names a comprobante for headings and links: "Factura F-12",
// "Comprobante de pago P-3", or "Factura (borrador)" before its folio.
func ComprobanteTitle(c store.Comprobante) string {
	kind := "Factura"
	if c.Tipo == store.TipoPago {
		kind = "Comprobante de pago"
	}
	if sf := c.SerieFolio(); sf != "" {
		return kind + " " + sf
	}
	if c.Origen == store.OrigenManual {
		return kind + " registrada"
	}
	return kind + " (borrador)"
}

func comprobanteBadge(status string) string {
	switch status {
	case store.CompTimbrada:
		return "emitida"
	case store.CompRechazada, store.CompCancelada:
		return "perdido"
	case store.CompIncierto, store.CompTimbrando, store.CompCancelPend:
		return "en_entrega"
	case store.CompLista:
		return "oc_recibida"
	}
	return "borrador"
}

templ ComprobanteBadge(status string) {
	<span class={ "badge", "badge-" + comprobanteBadge(status) }>{ store.ComprobanteStatusLabels[status] }</span>
}

var eventLabels = map[string]string{
	"created":           "Borrador creado",
	"edited":            "Regresó a borrador para editar",
	"validated":         "Validada: lista para timbrar",
	"stamp_requested":   "Se pidió el timbre",
	"stamp_succeeded":   "Timbrada",
	"stamp_refused":     "Rechazada",
	"stamp_unknown":     "Sin respuesta clara: timbrado incierto",
	"project_not_moved": "El proyecto no se movió",
	"cancel_requested":  "Se pidió la cancelación",
	"cancel_cancelled":  "Cancelada",
	"cancel_pending":    "Cancelación en espera del receptor",
	"cancel_refused":    "Cancelación rechazada",
	"cancel_unknown":    "Sin respuesta clara sobre la cancelación",
	"cancel_vigente":    "El receptor rechazó la cancelación: sigue vigente",
	"manual_recorded":   "Registrada a mano con su XML",
	"manual_cancelled":  "Marcada como cancelada",
}

func eventLabel(e string) string {
	if l, ok := eventLabels[e]; ok {
		return l
	}
	return e
}

func methodLabel(m string) string {
	switch m {
	case "PUE":
		return "PUE - Pago en una sola exhibición"
	case "PPD":
		return "PPD - Pago en parcialidades o diferido"
	case "":
		return "Sin elegir"
	}
	return m
}

func microsInput(m *store.Comprobante) string {
	if m.TipoCambioMicros == nil {
		return ""
	}
	return m.TipoCambioMicros.String()
}

templ FacturaPage(v FacturaView, user *NavUser) {
	{{ c := v.C }}
	{{ admin := user != nil && user.IsAdmin }}
	@Layout(ComprobanteTitle(c), user) {
		<div class="page-title">
			<h1>{ ComprobanteTitle(c) }</h1>
			@HelpLink(HelpFactura)
		</div>
		@Flash(v.Success)
		@FormError(v.Error)
		<dl class="quote-info">
			<dt>Estado</dt>
			<dd>
				@ComprobanteBadge(c.Status)
				if c.Sandbox || (c.Status == store.CompBorrador && v.Sandbox) {
					<span class="badge badge-revisada">Pruebas: sin validez fiscal</span>
				}
			</dd>
			<dt>Proyecto</dt>
			<dd><a href={ templ.URL(projectPath(c.ProjectFolio)) }>{ c.ProjectFolio }</a></dd>
			if c.QuoteFolio != "" {
				<dt>Cotización</dt>
				<dd><a href={ templ.URL("/cotizaciones/" + c.QuoteFolio) }>{ c.QuoteFolio }</a></dd>
			}
			<dt>Cliente</dt>
			<dd><a href={ templ.URL("/clientes/" + strconv.FormatInt(c.Customer.ID, 10)) }>{ c.Customer.Name }</a></dd>
			if c.Tipo == store.TipoFactura {
				<dt>Método de pago</dt>
				<dd>{ methodLabel(c.MetodoPago) }</dd>
			}
			if v.Related != nil {
				if c.Tipo == store.TipoPago {
					<dt>Paga la factura</dt>
				} else {
					<dt>Sustituye a</dt>
				}
				<dd><a href={ templ.URL(facturaPath(v.Related.ID)) }>{ ComprobanteTitle(*v.Related) }</a></dd>
			}
			if v.Replacement != nil {
				<dt>Sustituida por</dt>
				<dd><a href={ templ.URL(facturaPath(v.Replacement.ID)) }>{ ComprobanteTitle(*v.Replacement) }</a> · { store.ComprobanteStatusLabels[v.Replacement.Status] }</dd>
			}
			if v.Pago != nil {
				<dt>Comprobante de pago</dt>
				<dd><a href={ templ.URL(facturaPath(v.Pago.ID)) }>{ ComprobanteTitle(*v.Pago) }</a> · { store.ComprobanteStatusLabels[v.Pago.Status] }</dd>
			}
			if c.UUID != "" {
				<dt>Folio fiscal (UUID)</dt>
				<dd><code>{ c.UUID }</code></dd>
				<dt>Timbrada</dt>
				<dd>
					@Timestamp(c.StampedAt)
					if c.Origen == store.OrigenManual {
						{ " · fuera de la app, registrada a mano" }
					}
				</dd>
				if c.Recipients != "" {
					<dt>Enviada por correo</dt>
					<dd>
						if c.EmailSent {
							{ "Sí, a " + c.Recipients }
						} else {
							{ "No se pudo enviar a " + c.Recipients }
						}
					</dd>
				}
			}
			if c.Tipo == store.TipoPago && c.PagoFecha != "" {
				<dt>Fecha del pago</dt>
				<dd>{ dateText(c.PagoFecha) }</dd>
			}
			if c.Tipo == store.TipoPago {
				<dt>Monto pagado</dt>
			} else {
				<dt>Total</dt>
			}
			<dd>{ c.Total.String() } { c.Moneda }</dd>
		</dl>
		if v.WrongEnv {
			<p class="error" role="alert">Este comprobante se validó para el otro ambiente de Facturoporti (pruebas o producción) y aquí no se puede timbrar ni cancelar.</p>
		}
		if c.Error != "" && (c.Status == store.CompRechazada || c.Status == store.CompIncierto) {
			<div class="error" role="alert">
				if c.Status == store.CompRechazada {
					<p><strong>Facturoporti la rechazó; no se timbró nada.</strong></p>
				} else {
					<p><strong>No sabemos si se timbró.</strong></p>
				}
				<p>{ c.Error }</p>
			</div>
		}
		switch c.Status {
			case store.CompBorrador:
				if admin {
					@facturaDraftForm(v)
				} else {
					<p>Un administrador la está preparando.</p>
					@conceptosTable(c)
				}
			case store.CompLista:
				@conceptosTable(c)
				if admin && v.Enabled && !v.WrongEnv {
					<form method="post" action={ templ.URL(facturaPath(c.ID) + "/timbrar") } class="stage-form">
						<p>Está validada y lista. Al timbrarla se vuelve un CFDI ante el SAT: ya no se puede editar, solo cancelar.</p>
						if c.Recipients != "" {
							<p>Facturoporti la enviará a { c.Recipients }.</p>
						}
						<button type="submit" class="primary" data-confirm="¿Timbrar? Ya no se podrá editar.">Timbrar</button>
					</form>
				}
				if admin {
					@facturaBackToDraft(c)
				}
			case store.CompTimbrando, store.CompIncierto:
				@conceptosTable(c)
				if c.Status == store.CompTimbrando {
					<p>Se está timbrando. Si esto no cambia en unos minutos, recarga la página.</p>
				} else {
					<p>Facturoporti no contestó claramente. Reintentar manda exactamente la misma solicitud, y Facturoporti responde a una solicitud idéntica con el timbre que ya hizo, así que no se timbra dos veces.</p>
				}
				if admin && v.Enabled && !v.WrongEnv {
					<form method="post" action={ templ.URL(facturaPath(c.ID) + "/timbrar") } class="stage-form">
						<button type="submit" class="primary">Reintentar con la misma solicitud</button>
					</form>
				}
			case store.CompRechazada:
				@conceptosTable(c)
				if admin {
					@facturaBackToDraft(c)
				}
			default:
				if c.Origen == store.OrigenManual {
					@manualFacturaBody(v, admin)
				} else {
					@conceptosTable(c)
					if c.UUID != "" {
						<p>
							<a href={ templ.URL(facturaPath(c.ID) + "/pdf") } target="_blank">Descargar PDF</a>
							· <a href={ templ.URL(facturaPath(c.ID) + "/xml") }>Descargar XML</a>
						</p>
					}
					if admin && v.Enabled && !v.WrongEnv {
						@facturaStampedActions(v)
					}
				}
		}
		if c.Tipo == store.TipoFactura && c.MetodoPago == "PPD" && (c.Status == store.CompTimbrada || len(v.Pagos) > 0) {
			@complementosSection(v, admin)
		}
		<section id="historial">
			<h2>Historial</h2>
			<ul class="comprobante-events">
				for _, e := range v.Events {
					<li>
						@Timestamp(e.CreatedAt)
						{ " · " + eventLabel(e.Event) }
						if e.UserName != "" {
							{ " · " + e.UserName }
						}
					</li>
				}
			</ul>
		</section>
	}
}

templ facturaBackToDraft(c store.Comprobante) {
	<form method="post" action={ templ.URL(facturaPath(c.ID) + "/editar") } class="stage-form">
		<button type="submit">Regresar a borrador para corregir</button>
	</form>
}

templ conceptosTable(c store.Comprobante) {
	if c.Tipo == store.TipoFactura {
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th class="num">Partida</th>
						<th>Clave SAT</th>
						<th>Unidad</th>
						<th>Descripción</th>
						<th class="num">Cantidad</th>
						<th class="num">Valor unitario</th>
						<th class="num">Importe</th>
					</tr>
				</thead>
				<tbody>
					for _, l := range c.Conceptos {
						<tr>
							<td class="num">{ strconv.Itoa(l.LineNo) }</td>
							<td>{ l.SATProductCode }</td>
							<td>{ l.SATUnitCode } { l.UnitName }</td>
							<td>{ l.Description }</td>
							<td class="num">{ l.QtyMilli.String() }</td>
							<td class="num">{ "$" + l.UnitPriceMicros.String() }</td>
							<td class="num">{ l.Importe.String() }</td>
						</tr>
					}
				</tbody>
				@quoteTotals(pricingTotals(c), 6, 0)
			</table>
		</div>
	} else {
		<dl class="quote-info">
			<dt>Fecha del pago</dt>
			<dd>{ dateText(c.PagoFecha) }</dd>
			<dt>Forma de pago</dt>
			<dd>{ store.SATLabel(store.PaymentForms, c.FormaPago) }</dd>
			<dt>Monto</dt>
			<dd>{ c.Total.String() } { c.Moneda }</dd>
		</dl>
	}
}

templ facturaDraftForm(v FacturaView) {
	{{ c := v.C }}
	<form method="post" action={ templ.URL(facturaPath(c.ID)) } class="factura-form">
		<h2>Receptor</h2>
		<p>
			Los datos fiscales se toman del cliente. Para corregirlos,
			<a href={ templ.URL("/clientes/" + strconv.FormatInt(c.Customer.ID, 10)) }>edita el cliente</a>.
		</p>
		<dl class="quote-info">
			<dt>RFC</dt>
			<dd>{ orDash(c.Customer.RFC) }</dd>
			<dt>Razón social</dt>
			<dd>{ orDash(c.Customer.LegalName) }</dd>
			<dt>Régimen fiscal</dt>
			<dd>{ orDash(store.SATLabel(store.TaxRegimes, c.Customer.TaxRegime)) }</dd>
			<dt>Código postal fiscal</dt>
			<dd>{ orDash(c.Customer.PostalCode) }</dd>
		</dl>
		if c.Tipo == store.TipoFactura {
			<label>
				Uso de CFDI
				<select name="uso_cfdi">
					<option value="">Elige…</option>
					for _, u := range store.CFDIUses {
						<option value={ u.Code } selected?={ u.Code == c.UsoCFDI }>{ u.Code } - { u.Description }</option>
					}
				</select>
			</label>
			if c.RelatedID == 0 {
				<fieldset class="probability">
					<legend>Método de pago</legend>
					for _, m := range store.PaymentMethods {
						<label>
							<input type="radio" name="metodo_pago" value={ m } checked?={ m == c.MetodoPago } required/>
							{ methodLabel(m) }
						</label>
					}
				</fieldset>
				<p class="hint">P.U.E.: el cliente ya pagó; al timbrarla el proyecto queda pagado. P.P.D.: el pago se completa después con un comprobante de pago, y la forma de pago es 99 - Por definir.</p>
			}
			if c.MetodoPago == "PPD" {
				<input type="hidden" name="forma_pago" value="99"/>
				<p>Forma de pago: 99 - Por definir (la factura es P.P.D.; el pago se documenta después con un comprobante de pago).</p>
			} else {
				<label>
					Forma de pago (cómo pagó el cliente)
					<select name="forma_pago">
						<option value="">Elige…</option>
						for _, f := range store.PaymentForms {
							if f.Code != "99" {
								<option value={ f.Code } selected?={ f.Code == c.FormaPago }>{ f.Code } - { f.Description }</option>
							}
						}
					</select>
				</label>
			}
		} else {
			<label>
				Fecha en que se recibió el pago
				<input type="date" name="pago_fecha" value={ c.PagoFecha } max={ v.Today }/>
			</label>
			<label>
				Forma de pago
				<select name="forma_pago">
					<option value="">Elige…</option>
					for _, f := range store.PaymentForms {
						if f.Code != "99" {
							<option value={ f.Code } selected?={ f.Code == c.FormaPago }>{ f.Code } - { f.Description }</option>
						}
					}
				</select>
			</label>
			<p>Monto: { c.Total.String() } { c.Moneda }, el total de la factura, en un solo pago.</p>
		}
		if c.Moneda == "USD" {
			<label>
				Tipo de cambio (pesos por dólar)
				<input type="text" name="tipo_cambio" value={ microsInput(&c) } inputmode="decimal" placeholder="p. ej. 18.4520"/>
			</label>
		}
		<label>
			Enviar por correo a (opcional; separa varios con punto y coma)
			<input type="text" name="recipients" value={ c.Recipients } placeholder="compras@cliente.com"/>
		</label>
		<p class="hint">Facturoporti la manda con su XML y su PDF al timbrarla.</p>
		if c.Tipo == store.TipoFactura {
			<h2>Conceptos</h2>
			<p class="hint">Cantidades y precios son los de la cotización y no cambian aquí. Las claves SAT salen de la familia y de la unidad de cada producto.</p>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th class="num">Partida</th>
							<th>Clave de producto SAT</th>
							<th>Clave de unidad SAT</th>
							<th>Unidad</th>
							<th>Descripción</th>
							<th class="num">Cantidad</th>
							<th class="num">Valor unitario</th>
							<th class="num">Importe</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range c.Conceptos {
							<tr>
								<td class="num">
									{ strconv.Itoa(l.LineNo) }
									<input type="hidden" name="concepto_id" value={ strconv.FormatInt(l.ID, 10) }/>
								</td>
								<td><input type="text" name={ "sat_product_" + strconv.FormatInt(l.ID, 10) } value={ l.SATProductCode } size="9" maxlength="8" inputmode="numeric" aria-label={ "Clave de producto SAT, partida " + strconv.Itoa(l.LineNo) }/></td>
								<td><input type="text" name={ "sat_unit_" + strconv.FormatInt(l.ID, 10) } value={ l.SATUnitCode } size="4" maxlength="3" aria-label={ "Clave de unidad SAT, partida " + strconv.Itoa(l.LineNo) }/></td>
								<td><input type="text" name={ "unit_name_" + strconv.FormatInt(l.ID, 10) } value={ l.UnitName } size="8" aria-label={ "Unidad, partida " + strconv.Itoa(l.LineNo) }/></td>
								<td><input type="text" name={ "description_" + strconv.FormatInt(l.ID, 10) } value={ l.Description } aria-label={ "Descripción, partida " + strconv.Itoa(l.LineNo) }/></td>
								<td class="num">{ l.QtyMilli.String() }</td>
								<td class="num">{ "$" + l.UnitPriceMicros.String() }</td>
								<td class="num">{ l.Importe.String() }</td>
							</tr>
						}
					</tbody>
					@quoteTotals(pricingTotals(c), 7, 0)
				</table>
			</div>
		}
		if len(v.Problems) > 0 {
			<div class="hint" role="status">
				<p>Para validarla falta:</p>
				<ul>
					for _, p := range v.Problems {
						<li>{ p }</li>
					}
				</ul>
			</div>
		}
		<div class="quote-actions">
			<button type="submit">Guardar borrador</button>
			<button type="submit" class="primary" formaction={ templ.URL(facturaPath(c.ID) + "/validar") }>Guardar y validar</button>
		</div>
	</form>
}

templ facturaStampedActions(v FacturaView) {
	{{ c := v.C }}
	if c.Status == store.CompTimbrada {
		if c.Tipo == store.TipoFactura && c.MetodoPago == "PPD" && v.Pago == nil {
			<form method="post" action={ templ.URL(facturaPath(c.ID) + "/pago") } class="stage-form">
				<h2>Pago</h2>
				<p>Cuando el cliente termine de pagar, emite el comprobante de pago. Al timbrarlo, el proyecto queda pagado.</p>
				<button type="submit" class="primary">Crear comprobante de pago</button>
			</form>
		}
		<section id="cancelar">
			<h2>Corregir o cancelar</h2>
			if c.Tipo == store.TipoFactura && v.Replacement == nil {
				<form method="post" action={ templ.URL(facturaPath(c.ID) + "/sustituir") } class="stage-form">
					<p>Para corregir una factura timbrada se hace una nueva que la sustituye: se timbra la nueva y después se cancela esta con el motivo 01.</p>
					<button type="submit">Crear factura que la sustituye</button>
				</form>
			}
			<form method="post" action={ templ.URL(facturaPath(c.ID) + "/cancelar") } class="stage-form">
				<label>
					Motivo de cancelación
					<select name="motivo" required>
						<option value="">Elige…</option>
						for _, m := range store.CancelMotives {
							if m.Code != "01" || (v.Replacement != nil && v.Replacement.Status == store.CompTimbrada) {
								<option value={ m.Code }>{ m.Code } - { m.Description }</option>
							}
						}
					</select>
				</label>
				if v.Replacement != nil && v.Replacement.Status == store.CompTimbrada {
					<input type="hidden" name="sustitucion" value={ v.Replacement.UUID }/>
					<p class="hint">Con el motivo 01 se indica que la sustituye { ComprobanteTitle(*v.Replacement) }.</p>
				}
				if v.Pago != nil && v.Pago.Status == store.CompTimbrada {
					<p class="hint">Esta factura tiene un comprobante de pago timbrado: el SAT no la cancela hasta que se cancele el pago.</p>
				}
				<button type="submit" class="danger" data-confirm="¿Pedir la cancelación ante el SAT? No se puede deshacer.">Cancelar ante el SAT</button>
			</form>
		</section>
	} else if c.Status == store.CompCancelPend {
		<form method="post" action={ templ.URL(facturaPath(c.ID) + "/consultar") } class="stage-form">
			<p>La cancelación espera que el receptor la acepte (tiene 72 horas; si no contesta, el SAT la cancela).</p>
			<button type="submit">Consultar el estado en el SAT</button>
		</form>
	}
}

// FacturasPage is the Facturas table (#63): every proyecto with the client's O.C.
// received and its Estado de facturación, in the style of Pronóstico.
templ FacturasPage(b Billing, lv ListView, customers, owners []string, user *NavUser) {
	@Layout("Facturas", user) {
		<div class="page-title">
			<h1>Facturas</h1>
			@HelpLink(HelpFacturas)
		</div>
		<p>Los proyectos con orden de compra recibida y su estado de facturación. Para facturar, abre el proyecto desde su número.</p>
		@listActiveFilters(lv)
		if len(b.Rows) == 0 {
			if lv.HasFilters() {
				<p>Ningún proyecto coincide con el filtro.</p>
			} else {
				<p>Todavía no hay proyectos con orden de compra recibida.</p>
			}
		} else {
			{{ totals := b.Totals() }}
			<div class="table-scroll">
				<table class="forecast-table">
					<thead>
						<tr>
							@sortHeader(lv, "No. de proyecto", "folio", false)
							@columnHeader(lv, "Estado de facturación", "estado", billingStateFilter)
							@columnHeader(lv, "Cliente", "cliente", choiceFilter(customers))
							@sortHeader(lv, "Costo sin IVA", "costo", true)
							@sortHeader(lv, "Precio de venta sin IVA", "precio", true)
							@sortHeader(lv, "Utilidad", "utilidad", true)
							@sortHeader(lv, "Margen", "margen", true)
							@columnHeader(lv, "Vendedor", "vendedor", choiceFilter(owners))
							@sortHeader(lv, "No. de O.C.", "oc", false)
							@sortHeader(lv, "Fecha de la O.C.", "fecha_oc", false)
							@sortHeader(lv, "Días pendiente", "dias", true)
							@sortHeader(lv, "Folio fiscal", "folio_fiscal", false)
						</tr>
					</thead>
					<tbody data-announce={ countAnnouncement(len(b.Rows), "proyecto", "proyectos") }>
						for _, r := range b.Rows {
							<tr id={ "p-" + r.Folio }>
								<th scope="row"><a href={ templ.URL(projectPath(r.Folio)) }>{ r.Label() }</a></th>
								<td>
									{ store.FacturacionLabels[r.States.Facturacion] }
									if w := ComplementoWarning(r, b.Today); w != "" {
										<br/>
										<strong class="overdue">{ w }</strong>
									}
								</td>
								<td class="customer">{ r.CustomerName }</td>
								<td class="num">{ r.Cost().String() }</td>
								<td class="num">{ r.Subtotal.String() }</td>
								<td class="num">{ r.Profit.String() }</td>
								<td class="num">{ ProjectMargin(r.Project) }</td>
								<td>{ r.UserName }</td>
								<td>{ r.OC.Number }</td>
								<td>
									if r.OC.Date != "" {
										{ dateText(r.OC.Date) }
									}
								</td>
								<td class="num">{ DaysPendingFactura(r.Project, b.Today) }</td>
								<td>
									if r.FacturaID != 0 {
										<a href={ templ.URL(facturaPath(r.FacturaID)) }><small>{ r.FolioFiscal }</small></a>
									} else {
										<small>{ r.FolioFiscal }</small>
									}
								</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr>
							<th scope="row">Total</th>
							<td colspan="2">{ countAnnouncementPlain(len(b.Rows), "proyecto", "proyectos") }</td>
							<td class="num">{ totals.Cost.String() }</td>
							<td class="num">{ totals.Price.String() }</td>
							<td class="num">{ totals.Profit.String() }</td>
							<td class="num">{ totals.Margin }</td>
							<td colspan="5"></td>
						</tr>
					</tfoot>
				</table>
			</div>
			<p><small>Totales sin IVA. El margen total es la suma de utilidades entre la suma de precios.</small></p>
		}
	}
}

// ProjectFacturas is the CFDI part of a proyecto's Facturación section.
templ ProjectFacturas(list []store.Comprobante) {
	if len(list) > 0 {
		<h3>CFDI</h3>
		<ul>
			for _, c := range list {
				<li>
					<a href={ templ.URL(facturaPath(c.ID)) }>{ ComprobanteTitle(c) }</a>
					{ " · " }
					@ComprobanteBadge(c.Status)
					{ " · " + c.Total.String() }
				</li>
			}
		</ul>
	}
}

// ManualFacturaForm records a factura issued outside the app (#63): its XML, required,
// its PDF, optional, and for P.U.E. that it was already paid and when. primary styles it
// as the section's main action (when the app doesn't stamp).
templ ManualFacturaForm(p store.Project, today string, primary bool) {
	<form method="post" action={ templ.URL(projectPath(p.Folio) + "/factura/manual") } enctype="multipart/form-data" class="stage-form">
		<h3>Registrar una factura hecha fuera de la app</h3>
		<p>Sube el XML timbrado de la factura. De él se toman el folio fiscal, la fecha, el total, el RFC y si es PUE o PPD. Con PUE el Estado de facturación pasa a Facturada; con PPD, a Pendiente complemento de pago.</p>
		<label>
			XML de la factura (obligatorio)
			<input type="file" name="xml" accept=".xml,text/xml,application/xml" required/>
		</label>
		<label>
			PDF de la factura (opcional)
			<input type="file" name="pdf" accept="application/pdf,.pdf"/>
		</label>
		<fieldset>
			<legend>Si la factura es PUE</legend>
			<p class="hint">Una factura PUE solo se emite cuando el cliente ya pagó: el pago se registra en Cobro con esta fecha. Si no se ha cobrado, la factura debe ser PPD.</p>
			<label>
				<input type="checkbox" name="cobrado" value="si"/>
				Ya se cobró
			</label>
			<label>
				Fecha del pago
				<input type="date" name="fecha_pago" max={ today }/>
			</label>
		</fieldset>
		<button type="submit" class={ templ.KV("primary", primary) }>Registrar factura</button>
	</form>
}

// ManualWarnings is what a factura recorded by hand says that doesn't match its proyecto:
// its total against the quote's, and its receptor's RFC against the customer's. The
// factura is what the SAT has, so these are warnings, not errors.
func ManualWarnings(c store.Comprobante) []string {
	if c.Origen != store.OrigenManual || c.Tipo != store.TipoFactura {
		return nil
	}
	var out []string
	if c.Total != c.QuoteTotal {
		out = append(out, "El total de la factura ("+c.Total.String()+") no coincide con el total con IVA de la cotización ("+c.QuoteTotal.String()+").")
	}
	x, err := cfdi.Parse(c.XML)
	if err != nil {
		return out
	}
	rfc, want := strings.ToUpper(strings.TrimSpace(x.Receptor.Rfc)), strings.ToUpper(strings.TrimSpace(c.Customer.RFC))
	switch {
	case want == "":
		out = append(out, "El cliente no tiene RFC en su ficha; la factura está a nombre del RFC "+rfc+".")
	case rfc != want:
		out = append(out, "El RFC de la factura ("+rfc+") no coincide con el del cliente ("+want+").")
	}
	return out
}

// manualConceptos are a manual factura's conceptos as its XML has them.
func manualConceptos(c store.Comprobante) []cfdi.Concepto {
	x, err := cfdi.Parse(c.XML)
	if err != nil {
		return nil
	}
	return x.Conceptos
}

// manualFacturaBody is the page of a factura recorded by hand: what doesn't match, its
// conceptos from the XML, its downloads, and for an admin, marking it cancelled.
templ manualFacturaBody(v FacturaView, admin bool) {
	{{ c := v.C }}
	if ws := ManualWarnings(c); len(ws) > 0 && c.Status == store.CompTimbrada {
		<div class="error" role="alert">
			<p><strong>Revisa la factura:</strong></p>
			<ul>
				for _, w := range ws {
					<li>{ w }</li>
				}
			</ul>
		</div>
	}
	if c.Tipo == store.TipoFactura {
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Clave de producto SAT</th>
						<th class="num">Cantidad</th>
						<th>Clave de unidad SAT</th>
						<th>Descripción</th>
						<th class="num">Valor unitario</th>
						<th class="num">Importe</th>
					</tr>
				</thead>
				<tbody>
					for _, l := range manualConceptos(c) {
						<tr>
							<td>{ l.ClaveProdServ }</td>
							<td class="num">{ l.Cantidad }</td>
							<td>{ l.ClaveUnidad }</td>
							<td>{ l.Descripcion }</td>
							<td class="num">{ l.ValorUnitario }</td>
							<td class="num">{ l.Importe }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	<p>
		if c.PDFFileID != 0 {
			<a href={ templ.URL(projectPath(c.ProjectFolio) + "/archivos/" + strconv.FormatInt(c.PDFFileID, 10)) }>Descargar PDF</a>
			{ " · " }
		}
		<a href={ templ.URL(facturaPath(c.ID) + "/pdf") } target="_blank">Ver representación impresa</a>
		· <a href={ templ.URL(facturaPath(c.ID) + "/xml") }>Descargar XML</a>
	</p>
	if admin && c.Status == store.CompTimbrada {
		<section id="cancelar">
			<h2>Cancelar</h2>
			<form method="post" action={ templ.URL(facturaPath(c.ID) + "/cancelar-manual") } class="stage-form">
				if c.Tipo == store.TipoPago {
					<p>Si el complemento se canceló fuera de la app, márcalo aquí. Deja de contar para el saldo de la factura. El pago registrado en Cobro se queda.</p>
				} else {
					<p>Si la factura se canceló fuera de la app, márcala aquí. El Estado de facturación regresa a Pendiente hasta que se registre la que la sustituye. Los pagos registrados se quedan.</p>
				}
				<label>
					Motivo de cancelación
					<select name="motivo" required>
						<option value="">Elige…</option>
						for _, m := range store.CancelMotives {
							<option value={ m.Code }>{ m.Code } - { m.Description }</option>
						}
					</select>
				</label>
				<label>
					¿Por qué se canceló?
					<textarea name="nota" rows="2" maxlength="2000" required></textarea>
				</label>
				if c.Tipo == store.TipoPago {
					<button type="submit" class="danger" data-confirm="¿Marcar el complemento como cancelado?">Marcar como cancelado</button>
				} else {
					<button type="submit" class="danger" data-confirm="¿Marcar la factura como cancelada?">Marcar como cancelada</button>
				}
			</form>
		</section>
	}
}

// complementosSection lists a P.P.D. factura's complementos de pago with the saldo they
// leave, and lets an admin record one issued outside the app (#63), linked to a payment
// already in Cobro or recording a new one.
templ complementosSection(v FacturaView, admin bool) {
	{{ c := v.C }}
	<section id="complementos">
		<h2>Complementos de pago</h2>
		if len(v.Pagos) == 0 {
			<p>Todavía no tiene complementos de pago.</p>
		} else {
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>Complemento</th>
							<th>Fecha del pago</th>
							<th class="num">Monto</th>
							<th>Estado</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range v.Pagos {
							<tr>
								<td><a href={ templ.URL(facturaPath(p.ID)) }>{ ComprobanteTitle(p) }</a></td>
								<td>{ dateText(p.PagoFecha) }</td>
								<td class="num">{ p.Total.String() }</td>
								<td>
									@ComprobanteBadge(p.Status)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<dl class="quote-info">
			<dt>Total de la factura</dt>
			<dd>{ c.Total.String() }</dd>
			<dt>Saldo pendiente</dt>
			<dd>{ v.Saldo.String() }</dd>
		</dl>
		if admin && c.Status == store.CompTimbrada && v.Saldo > 0 && c.ProjectStatus == store.StageEnCurso {
			<form method="post" action={ templ.URL(facturaPath(c.ID) + "/complemento-manual") } enctype="multipart/form-data" class="stage-form">
				<h3>Registrar complemento de pago</h3>
				<p>Sube el XML timbrado del complemento que se hizo fuera de la app. De él se toman la fecha del pago y lo que paga de esta factura. Cuando los complementos cubren el total, el proyecto queda Facturada.</p>
				<label>
					XML del complemento (obligatorio)
					<input type="file" name="xml" accept=".xml,text/xml,application/xml" required/>
				</label>
				<label>
					PDF del complemento (opcional)
					<input type="file" name="pdf" accept="application/pdf,.pdf"/>
				</label>
				<fieldset>
					<legend>¿Este pago ya está registrado en Cobro?</legend>
					for _, p := range v.Unlinked {
						<label>
							<input type="radio" name="pago" value={ strconv.FormatInt(p.ID, 10) } required/>
							{ "Sí, el pago de " + p.Amount.String() + " del " + dateText(p.PaidOn) }
						</label>
					}
					<label>
						<input type="radio" name="pago" value="nuevo" required checked?={ len(v.Unlinked) == 0 }/>
						No: registrar el pago en Cobro con los datos del complemento
					</label>
					<p class="hint">Elige el pago que ampara el complemento para no contarlo dos veces. Debe ser del mismo monto.</p>
				</fieldset>
				<button type="submit" class="primary">Registrar complemento</button>
			</form>
		}
	</section>
}
