package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// roleLabel returns the Spanish display label for a users.role value.
func roleLabel(role string) string {
	if role == "admin" {
		return "Administrador"
	}
	return "Vendedor"
}

templ UsersList(users []store.User, currentUserID int64, lv ListView, successMsg string, errorMsg string, user *NavUser) {
	@Layout("Usuarios", user) {
		<h1>
			Usuarios
			@HelpLink(HelpUsuarios)
		</h1>
		if successMsg != "" {
			<p class="success">{ successMsg }</p>
		}
		if errorMsg != "" {
			<p class="error">{ errorMsg }</p>
		}
		@listActiveFilters(lv)
		<table>
			<thead>
				<tr>
					@columnHeader(lv, "Usuario", "username", textFilter)
					@columnHeader(lv, "Nombre", "name", textFilter)
					@columnHeader(lv, "Rol", "role", userRoleFilter)
					@columnHeader(lv, "Estado", "status", userStatusFilter)
					<th></th>
				</tr>
			</thead>
			<tbody>
				for _, u := range users {
					<tr>
						<td>{ u.Username }</td>
						<td>{ u.Name }</td>
						<td>
							if u.ID == currentUserID {
								{ roleLabel(u.Role) }
							} else {
								<form method="post" action={ templ.URL("/usuarios/" + strconv.FormatInt(u.ID, 10) + "/rol") } style="display:inline">
									if u.Role == "admin" {
										<select name="role">
											<option value="admin" selected>Administrador</option>
											<option value="vendedor">Vendedor</option>
										</select>
									} else {
										<select name="role">
											<option value="admin">Administrador</option>
											<option value="vendedor" selected>Vendedor</option>
										</select>
									}
									<button type="submit">Guardar rol</button>
								</form>
							}
						</td>
						<td>
							if u.DisabledAt != nil {
								Deshabilitado
							} else {
								Activo
							}
						</td>
						<td>
							if u.ID == currentUserID {
								—
							} else if u.DisabledAt != nil {
								<form method="post" action={ templ.URL("/usuarios/" + strconv.FormatInt(u.ID, 10) + "/habilitar") } style="display:inline">
									<button type="submit">Habilitar</button>
								</form>
							} else {
								<form method="post" action={ templ.URL("/usuarios/" + strconv.FormatInt(u.ID, 10) + "/deshabilitar") } style="display:inline">
									<button type="submit" hx-confirm="¿Deshabilitar a este usuario?">Deshabilitar</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		@listPager(lv, false)
		<p><small>Crear usuarios y restablecer contraseñas se hace por línea de comandos (<code>cladex user add/passwd</code>) — ver el runbook de administración.</small></p>
	}
}
