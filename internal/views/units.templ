package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

templ UnitsList(units []store.Unit, lv ListView, successMsg string, errorMsg string, user *NavUser) {
	@Layout("Unidades", user) {
		<div class="page-title">
			<h1>Unidades</h1>
			@HelpLink(HelpUnidades)
		</div>
		@Flash(successMsg)
		@FormError(errorMsg)
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Código</th>
						<th>Nombre</th>
						<th>Clave de unidad SAT</th>
					</tr>
				</thead>
				<tbody>
					if len(units) == 0 {
						<tr>
							<td colspan="3">No hay unidades.</td>
						</tr>
					}
					for _, u := range units {
						<tr>
							<td>{ u.Code }</td>
							<td>{ u.Name }</td>
							<td>
								<form method="post" action={ templ.URL("/unidades/" + strconv.FormatInt(u.ID, 10) + "/sat") } class="inline-form">
									<input type="text" name="sat_code" value={ u.SATCode } size="4" maxlength="3" pattern="[A-Za-z0-9]{2,3}" placeholder="p. ej. MTR" aria-label={ "Clave de unidad SAT de " + u.Name }/>
									<button type="submit">Guardar<span class="visually-hidden">{ " clave de " + u.Name }</span></button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@listPager(lv, false)
		<h2>Nueva unidad</h2>
		<form method="post" action="/unidades">
			<label>
				Código
				<input type="text" name="code" placeholder="p. ej. caja" required/>
			</label>
			<label>
				Nombre
				<input type="text" name="name" placeholder="p. ej. Caja" required/>
			</label>
			<button type="submit" class="primary">Agregar</button>
		</form>
	}
}
