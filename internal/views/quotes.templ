package views

import (
	"strconv"
	"strings"
	"time"

	"github.com/gerrygoo/cladex-web/internal/money"
	"github.com/gerrygoo/cladex-web/internal/pricing"
	"github.com/gerrygoo/cladex-web/internal/store"
)

// QuoteLineView is the builder's per-line view-model: a computed line, whether it came
// from a persisted quote_lines row or an in-progress (unsaved) edit. Raw fields
// (QtyRaw, UnitPriceRaw) redisplay exactly what was typed, per the form convention; a
// non-empty Error means this line didn't price and doesn't count toward Totals.
type QuoteLineView struct {
	Key               string
	IsFree            bool
	ProductID         *int64
	ProductLabel      string
	Description       string
	UnitCode          string
	QtyRaw            string
	QtyMilli          money.Milli
	UnitPriceRaw      string
	UnitPriceMicros   money.Micros
	LineTotal         money.Centavos
	PricingInputsJSON *string
	Error             string
	Materials         []store.Material // the materials a cost-priced product line was priced from
	// Free lines (issue #27): the cost per unit, never printed, as typed and parsed, and
	// on QL the line's own margin. LineID is the stored row, for editing the cost of an
	// issued quote.
	CostRaw      string
	CostMicros   *money.Micros
	MarginRaw    string
	MarginMicros *money.Micros
	LineID       int64
	// KgPerUnit is the kg of material one unit of the product holds (its kg-priced
	// materials as priced), nil when it has none. CCS quotes show it (issue #34).
	KgPerUnit *money.Micros
}

templ QuotesList(quotes []store.Quote, lv ListView, customers, authors []string, successMsg string, user *NavUser) {
	@Layout("Cotizaciones", user) {
		<div class="page-title">
			<h1>Cotizaciones</h1>
			@HelpLink(HelpCotizaciones)
		</div>
		@Flash(successMsg)
		<div class="toolbar">
			<form method="get" action="/cotizaciones" role="search">
				<input
					type="search"
					name="q"
					placeholder="Buscar por folio o cliente…"
					aria-label="Buscar por folio o cliente"
					value={ lv.Query }
					hx-get="/cotizaciones"
					hx-trigger="keyup changed delay:400ms, search"
					hx-target="#cotizaciones-tbody"
					hx-swap="outerHTML"
					hx-include="closest form"
					hx-push-url="true"
				/>
				@listHiddenInputs(lv, "q")
				<button type="submit">Buscar</button>
			</form>
			<a class="button primary" href="/cotizaciones/nueva">Nueva cotización</a>
		</div>
		@listActiveFilters(lv)
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						@columnHeader(lv, "Folio", "folio", textFilter)
						@columnHeader(lv, "Cliente", "cliente", choiceFilter(customers))
						@columnHeader(lv, "Autor", "autor", choiceFilter(authors))
						@columnHeader(lv, "Estado", "estado", quoteStatusFilter)
						@columnHeader(lv, "Total", "total", numberFilter)
						@columnHeader(lv, "Fecha", "fecha", dateFilter)
					</tr>
				</thead>
				@QuotesTableBody(quotes)
			</table>
		</div>
		@listPager(lv, false)
	}
}

templ QuotesTableBody(quotes []store.Quote) {
	<tbody id="cotizaciones-tbody" data-announce={ countAnnouncement(len(quotes), "cotización", "cotizaciones") }>
		if len(quotes) == 0 {
			<tr>
				<td colspan="6">No se encontraron cotizaciones.</td>
			</tr>
		}
		for _, q := range quotes {
			<tr>
				<td><a href={ templ.URL("/cotizaciones/" + q.Folio) }>{ q.Folio }</a></td>
				<td>{ q.CustomerName }</td>
				<td>{ q.UserName }</td>
				<td>
					@StatusBadge(q.Status)
				</td>
				<td class="num">{ q.Total.String() }</td>
				<td>
					@Timestamp(q.CreatedAt)
				</td>
			</tr>
		}
	</tbody>
}

// NewCustomerValue is the customer list's "Agregar nuevo cliente" entry: picking it opens
// the new-customer form, which comes back here with the customer selected.
const NewCustomerValue = "nuevo"

// QuoteNewFormValues is the view-model for QuoteNewForm.
type QuoteNewFormValues struct {
	CustomerID string
	Prefix     string
}

templ QuoteNewForm(customers []store.Customer, series []store.Series, values QuoteNewFormValues, fieldErrors map[string]string, user *NavUser) {
	@Layout("Nueva cotización", user) {
		<div class="page-title">
			<h1>Nueva cotización</h1>
			@HelpLink(HelpCotizacionNueva)
		</div>
		<form method="post" action={ templ.URL("/cotizaciones/nueva") }>
			<label for="cliente">Cliente</label>
			// static/app.js turns the list into a combobox: type to search by name, RFC or
			// contact (ignoring case and accents) and the matches show right away, with
			// "Agregar nuevo cliente" always first (issue #29). Without JS it is this
			// plain list.
			<select name="customer_id" id="cliente" required data-combobox { errAttrs(fieldErrors, "customer_id")... }>
				<option value="">— Selecciona —</option>
				<option value={ NewCustomerValue } data-keep>➕ Agregar nuevo cliente</option>
				for _, c := range customers {
					<option
						value={ strconv.FormatInt(c.ID, 10) }
						data-search={ c.Name + " " + c.RFC + " " + c.ContactName }
						selected?={ strconv.FormatInt(c.ID, 10) == values.CustomerID }
						data-detail={ customerDetail(c) }
					>{ c.Name }</option>
				}
			</select>
			@FieldError(fieldErrors, "customer_id")
			<fieldset role="radiogroup" { errAttrs(fieldErrors, "prefix")... }>
				<legend>Serie de folio</legend>
				for _, sr := range series {
					<label>
						<input type="radio" name="prefix" value={ sr.Prefix } checked?={ sr.Prefix == values.Prefix }/>
						{ sr.PickerLabel() }
					</label>
				}
				@FieldError(fieldErrors, "prefix")
			</fieldset>
			<button type="submit" class="primary">Crear cotización</button>
			<a href="/cotizaciones">Cancelar</a>
		</form>
	}
}

// customerDetail is the second line of a customer in the combobox: its RFC and contact,
// whichever it has.
func customerDetail(c store.Customer) string {
	var parts []string
	for _, p := range []string{c.RFC, c.ContactName} {
		if p != "" {
			parts = append(parts, p)
		}
	}
	return strings.Join(parts, " · ")
}

// recalcularPath is the htmx/formaction target every line mutation posts to — never
// persists, just reprices the submitted set (see internal/web/quotes.go's Recalcular).
func recalcularPath(folio string) string {
	return "/cotizaciones/" + folio + "/recalcular"
}

// guardarPath is the formaction the one "Guardar borrador" button overrides to — the
// only control in the form that actually writes the draft.
func guardarPath(folio string) string {
	return "/cotizaciones/" + folio + "/guardar"
}

func lineKind(l QuoteLineView) string {
	if l.IsFree {
		return "free"
	}
	return "product"
}

func productIDValue(id *int64) string {
	if id == nil {
		return ""
	}
	return strconv.FormatInt(*id, 10)
}

func lineKeysValue(lines []QuoteLineView) string {
	keys := make([]string, len(lines))
	for i, l := range lines {
		keys[i] = l.Key
	}
	return strings.Join(keys, ",")
}

// lineFieldID is a stable id for one of a line's controls. htmx puts focus back on the
// element with the same id after it swaps the lines fragment, so tabbing out of a
// quantity (which recalculates) doesn't drop focus to the top of the page.
func lineFieldID(key, field string) string {
	return "linea-" + key + "-" + field
}

// lineLabel names a line for screen readers: its product, or the free line's description.
func lineLabel(line QuoteLineView) string {
	if line.IsFree {
		if line.Description == "" {
			return "línea libre"
		}
		return line.Description
	}
	return line.ProductLabel
}

// pickerAnnouncement is what the live region reads out after the product picker updates.
func pickerAnnouncement(picker ProductPicker) string {
	switch picker.Total {
	case 0:
		return "Ningún producto encontrado"
	case 1:
		return "1 producto"
	default:
		return strconv.Itoa(picker.Total) + " productos"
	}
}

// lineInput is one of a builder line's text inputs: it recalculates on change, and keeps
// its id so htmx puts focus back after the swap.
templ lineInput(folio string, line QuoteLineView, field, value, label, placeholder string) {
	<input
		type="text"
		inputmode="decimal"
		class="num"
		id={ lineFieldID(line.Key, field) }
		name={ "lines[" + line.Key + "][" + field + "]" }
		value={ value }
		aria-label={ label + ": " + lineLabel(line) }
		placeholder={ placeholder }
		size="8"
		hx-post={ recalcularPath(folio) }
		hx-trigger="change"
		hx-target="#quote-lines-fragment"
		hx-swap="outerHTML"
	/>
}

// quoteLineRow is one editable builder line. On QL (freeLinesOnly) a line takes its cost
// and margin and shows the price they give, read-only (issue #27); elsewhere a free
// line takes its price, and an optional cost below it that is never printed.
templ quoteLineRow(folio string, line QuoteLineView, freeLinesOnly, kg bool, partida int) {
	<tr>
		<td class="num">{ strconv.Itoa(partida) }</td>
		<td>
			<input type="hidden" name={ "lines[" + line.Key + "][kind]" } value={ lineKind(line) }/>
			if line.IsFree {
				<input
					type="text"
					id={ lineFieldID(line.Key, "description") }
					name={ "lines[" + line.Key + "][description]" }
					value={ line.Description }
					placeholder="Descripción"
					aria-label="Descripción de la línea libre"
					hx-post={ recalcularPath(folio) }
					hx-trigger="change"
					hx-target="#quote-lines-fragment"
					hx-swap="outerHTML"
				/>
			} else {
				<input type="hidden" name={ "lines[" + line.Key + "][product_id]" } value={ productIDValue(line.ProductID) }/>
				{ line.ProductLabel }
			}
		</td>
		<td class="num">
			<input
				type="text"
				inputmode="decimal"
				class="num"
				id={ lineFieldID(line.Key, "qty") }
				name={ "lines[" + line.Key + "][qty]" }
				value={ line.QtyRaw }
				aria-label={ "Cantidad: " + lineLabel(line) }
				size="6"
				hx-post={ recalcularPath(folio) }
				hx-trigger="change"
				hx-target="#quote-lines-fragment"
				hx-swap="outerHTML"
			/>
			if line.UnitCode != "" {
				{ line.UnitCode }
			}
		</td>
		if kg {
			<td class="num">{ KgPerUnitText(line) }</td>
			<td class="num">{ KgText(line) }</td>
		}
		if freeLinesOnly {
			<td class="num">
				@lineInput(folio, line, "cost", line.CostRaw, "Costo unitario", "p. ej. 1500")
			</td>
			<td class="num">
				@lineInput(folio, line, "margin", line.MarginRaw, "Margen %", "p. ej. 10")
			</td>
			<td class="num">
				if line.Error == "" {
					{ line.UnitPriceMicros.ToCentavosHalfUp().String() }
				}
			</td>
		} else {
			<td class="num">
				if line.IsFree {
					@lineInput(folio, line, "unit_price", line.UnitPriceRaw, "Precio unitario", "p. ej. 123.45")
					<label class="line-cost">
						Costo (opcional)
						@lineInput(folio, line, "cost", line.CostRaw, "Costo unitario, no sale en el PDF", "")
					</label>
				} else {
					{ line.UnitPriceMicros.ToCentavosHalfUp().String() }
				}
			</td>
		}
		<td class="num">{ line.LineTotal.String() }</td>
		<td class="actions">
			<button
				type="submit"
				class="danger"
				id={ lineFieldID(line.Key, "remove") }
				name="remove_key"
				value={ line.Key }
				hx-post={ recalcularPath(folio) }
				hx-target="#quote-lines-fragment"
				hx-swap="outerHTML"
			>
				Eliminar<span class="visually-hidden">{ " " + lineLabel(line) }</span>
			</button>
		</td>
	</tr>
	if line.Error != "" {
		<tr>
			<td colspan={ strconv.Itoa(lineColumns(freeLinesOnly, kg)) } class="error">{ line.Error }</td>
		</tr>
	}
}

// lineColumns is how many columns the editable lines table has: QL adds cost and margin,
// CCS kg por metro and kg.
func lineColumns(freeLinesOnly, kg bool) int {
	n := 6
	if freeLinesOnly {
		n += 2
	}
	if kg {
		n += 2
	}
	return n
}

// QuoteLinesFragment is the swappable line-table+totals partial — rendered both as part
// of the full QuoteBuilder page and as the direct htmx response from Recalcular. It
// carries line_keys, the ordered list of currently-present row keys that
// parseQuoteLineInputs reads back on the next submit; nothing here writes to the
// database. marginError is the margin dropdown's error, rendered here rather than next
// to the dropdown so that picking another option (which swaps only this fragment)
// clears it.
templ QuoteLinesFragment(quote store.Quote, lines []QuoteLineView, totals pricing.Totals, marginError string) {
	{{ kg := ShowsKg(quote) }}
	<div id="quote-lines-fragment" tabindex="-1" data-announce={ "Total: " + totals.Total.String() }>
		<input type="hidden" name="line_keys" value={ lineKeysValue(lines) }/>
		if marginError != "" {
			<p class="error">{ marginError }</p>
		}
		<div class="table-scroll">
			<table class={ templ.KV("kg-lines", kg) }>
				<caption class="visually-hidden">Líneas de la cotización</caption>
				<thead>
					<tr>
						<th class="num">Partida</th>
						if quote.SeriesFreeLines {
							<th>Descripción</th>
						} else {
							<th>Producto / Descripción</th>
						}
						if kg {
							<th class="num">Cantidad (m)</th>
							<th class="num">Kg por metro</th>
							<th class="num">Kg</th>
						} else {
							<th class="num">Cantidad</th>
						}
						if quote.SeriesFreeLines {
							<th class="num">Costo unitario</th>
							<th class="num">Margen %</th>
						}
						<th class="num">Precio unitario</th>
						<th class="num">Total</th>
						<th><span class="visually-hidden">Acciones</span></th>
					</tr>
				</thead>
				<tbody>
					if len(lines) == 0 {
						<tr>
							<td colspan={ strconv.Itoa(lineColumns(quote.SeriesFreeLines, kg)) }>Sin líneas todavía.</td>
						</tr>
					}
					for i, line := range lines {
						@quoteLineRow(quote.Folio, line, quote.SeriesFreeLines, kg, i+1)
					}
				</tbody>
				@quoteTotals(totals, lineColumns(quote.SeriesFreeLines, kg)-2, 1)
			</table>
		</div>
		if used := materialsInUse(lines); len(used) > 0 {
			<p class="hint">
				Precios de materiales:
				for i, m := range used {
					if i > 0 {
						{ " · " }
					}
					{ m.Name } { MaterialPrice(m) } ({ MaterialAge(m.UpdatedAt, time.Now()) })
				}
			</p>
		}
	</div>
}

// ProductPicker is the view-model for the builder's "add line" picker: one page of
// matching products plus what the pager needs. An empty Query means browsing — every
// product in the series family.
type ProductPicker struct {
	Folio      string
	Query      string
	Products   []store.Product
	Page       int
	TotalPages int
	Total      int
}

// productPickerPath is the htmx endpoint behind the picker's search box and pager.
func productPickerPath(folio string) string {
	return "/cotizaciones/" + folio + "/productos"
}

// ProductSearchResults is the "add line" picker's current page of products — each one a
// submit button that appends that product as a new line via add_product_id, priced by
// Recalcular server-side (never a client-supplied price). htmx swaps only the lines
// fragment, so the picker stays on the same page for adding several products in a row.
// Not scoped to the quote's own folio prefix; any product may be added to any quote.
templ ProductSearchResults(picker ProductPicker) {
	<div id="product-search-results" data-announce={ pickerAnnouncement(picker) }>
		if len(picker.Products) > 0 {
			<ul>
				for _, p := range picker.Products {
					<li>
						<button
							type="submit"
							name="add_product_id"
							value={ strconv.FormatInt(p.ID, 10) }
							hx-post={ recalcularPath(picker.Folio) }
							hx-target="#quote-lines-fragment"
							hx-swap="outerHTML"
						>
							{ p.SKU } — { p.Description } ({ productPriceDisplay(p) })
						</button>
					</li>
				}
			</ul>
			if picker.TotalPages > 1 {
				<nav class="pager" aria-label="Páginas de productos">
					if picker.Page > 1 {
						@productPickerPageButton(picker, picker.Page-1, "« Anterior")
					}
					<span>Página { strconv.Itoa(picker.Page) } de { strconv.Itoa(picker.TotalPages) } · { strconv.Itoa(picker.Total) } productos</span>
					if picker.Page < picker.TotalPages {
						@productPickerPageButton(picker, picker.Page+1, "Siguiente »")
					}
				</nav>
			}
		} else if picker.Query != "" {
			<p>Ningún producto coincide con «{ picker.Query }».</p>
		} else {
			<p>No hay productos en esta familia.</p>
		}
	</div>
}

// productPickerPageButton jumps the picker to another page. With htmx it re-fetches only
// the results fragment, keeping the current search; without JS it's a
// GET reload of the builder with ?pagina= (like "Buscar", that reload drops unsaved lines).
templ productPickerPageButton(picker ProductPicker, page int, label string) {
	<button
		type="submit"
		formmethod="get"
		formaction={ "/cotizaciones/" + picker.Folio }
		name="pagina"
		value={ strconv.Itoa(page) }
		hx-get={ productPickerPath(picker.Folio) }
		hx-include="#linea-form [name='q']"
		hx-target="#product-search-results"
		hx-swap="outerHTML"
	>
		{ label }
	</button>
}

// emitirPath is the formaction the "Emitir cotización" button overrides to — saves the
// submitted line set (same as Guardar) and then freezes the quote.
func emitirPath(folio string) string {
	return "/cotizaciones/" + folio + "/emitir"
}

// revisarPath is the action for the read-only "Revisar" button on an issued quote —
// creates a new editable "<folio>-R<n>" draft and redirects into it.
func revisarPath(folio string) string {
	return "/cotizaciones/" + folio + "/revisar"
}

// QuoteLinesReadOnly renders an issued or revised quote's frozen lines — no qty
// inputs, no remove buttons, nothing that implies the row can still change. Used
// instead of QuoteLinesFragment once a quote leaves 'borrador'.
templ QuoteLinesReadOnly(lines []QuoteLineView, totals pricing.Totals, kg bool) {
	{{ costs := anyLineCost(lines) }}
	{{ lead := 4 }}
	if costs {
		{{ lead += 2 }}
	}
	if kg {
		{{ lead += 2 }}
	}
	<div class="table-scroll">
		<table class={ templ.KV("kg-lines", kg) }>
			<thead>
				<tr>
					<th class="num">Partida</th>
					<th>Producto / Descripción</th>
					if kg {
						<th class="num">Cantidad (m)</th>
						<th class="num">Kg por metro</th>
						<th class="num">Kg</th>
					} else {
						<th class="num">Cantidad</th>
					}
					if costs {
						<th class="num">Costo unitario <small>(no sale en el PDF)</small></th>
						<th class="num">Margen</th>
					}
					<th class="num">Precio unitario</th>
					<th class="num">Total</th>
				</tr>
			</thead>
			<tbody>
				if len(lines) == 0 {
					<tr>
						<td colspan={ strconv.Itoa(lead + 1) }>Sin líneas.</td>
					</tr>
				}
				for i, line := range lines {
					<tr>
						<td class="num">{ strconv.Itoa(i + 1) }</td>
						<td>
							if line.IsFree {
								{ line.Description }
							} else {
								{ line.ProductLabel }
							}
						</td>
						<td class="num">
							{ line.QtyMilli.String() }
							if line.UnitCode != "" {
								{ " " + line.UnitCode }
							}
						</td>
						if kg {
							<td class="num">{ KgPerUnitText(line) }</td>
							<td class="num">{ KgText(line) }</td>
						}
						if costs {
							<td class="num">
								if line.CostMicros != nil {
									{ line.CostMicros.ToCentavosHalfUp().String() }
								}
							</td>
							<td class="num">{ lineMarginText(line) }</td>
						}
						<td class="num">{ line.UnitPriceMicros.ToCentavosHalfUp().String() }</td>
						<td class="num">{ line.LineTotal.String() }</td>
					</tr>
				}
			</tbody>
			@quoteTotals(totals, lead, 0)
		</table>
	</div>
}

// anyLineCost reports whether any line carries a cost, which adds the cost and margin
// columns to the read-only lines.
func anyLineCost(lines []QuoteLineView) bool {
	for _, l := range lines {
		if l.CostMicros != nil {
			return true
		}
	}
	return false
}

// lineMarginText is a free line's margin as it stands: its profit over its price, so it
// follows a cost updated after issue. Empty without a cost.
func lineMarginText(l QuoteLineView) string {
	if l.CostMicros == nil {
		return ""
	}
	return marginPercentText(int64(l.UnitPriceMicros-*l.CostMicros), int64(l.UnitPriceMicros))
}

// quoteTotals is the Subtotal / IVA / Total rows at the foot of a lines table, the
// figures under the Total column. lead is the number of columns before Total, trailing
// the number after it (the editable table's actions column).
templ quoteTotals(totals pricing.Totals, lead, trailing int) {
	<tfoot>
		@quoteTotalRow("Subtotal", totals.Subtotal.String(), lead, trailing, false)
		@quoteTotalRow("IVA (16%)", totals.IVA.String(), lead, trailing, false)
		@quoteTotalRow("Total", totals.Total.String(), lead, trailing, true)
	</tfoot>
}

templ quoteTotalRow(label, amount string, lead, trailing int, grand bool) {
	<tr class={ templ.KV("grand", grand) }>
		<th scope="row" colspan={ strconv.Itoa(lead) } class="num">{ label }</th>
		<td class="num">{ amount }</td>
		if trailing > 0 {
			<td colspan={ strconv.Itoa(trailing) }></td>
		}
	</tr>
}

// QuoteBuilder is the main /cotizaciones/{folio} page. A draft ('borrador') gets the
// full editable form: every mutating control lives inside the one
// <form id="linea-form">, whose default action is Recalcular (a pure recompute, never
// persisted); "Guardar borrador" and "Emitir cotización" are the only two buttons that
// override their own formaction to actually write. The product picker is rendered
// server-side (browsing the series family until something is typed); ?q=/?pagina= page
// reloads are its no-JS fallback — htmx otherwise enhances the same controls into
// in-place requests against BuscarProductos.
//
// An issued quote ('emitida' and every later stage) or a revised ('revisada') one is
// immutable, so it renders a read-only summary instead: QuoteLinesReadOnly, the frozen
// issue metadata, the button that moves it to the next stage (with an admin-only one to
// go back), a "Revisar" button while it is 'emitida' (the active version), or a note
// pointing at whichever revision superseded it (revisada).
// validUntilValue is the quote's validity date as a date input's value: the ISO date,
// or empty while none is set.
func validUntilValue(quote store.Quote) string {
	if quote.ValidUntil == nil {
		return ""
	}
	return *quote.ValidUntil
}

// MarginControls is the builder's margin dropdown and "Otro margen" fields. oob renders
// it as an htmx out-of-band swap, for a recalculation whose lines changed what the price
// per kg is measured against (a QG quote, issue #43). margin_kg_ref sends back the cost
// per kg the page shows, so the server can tell.
templ MarginControls(quote store.Quote, margin MarginPicker, oob bool) {
	<div
		id="margin-controls"
		class="quote-meta"
		data-copper-cost={ margin.KgCost }
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		<input type="hidden" name="margin_kg_ref" value={ margin.KgCost }/>
		<label>
			Margen
			<select
				id="margin-select"
				name="margin_option_id"
				hx-post={ recalcularPath(quote.Folio) }
				hx-trigger="change"
				hx-target="#quote-lines-fragment"
				hx-swap="outerHTML"
			>
				if margin.NoneChosen {
					<option value="" selected>— Elige un margen —</option>
				}
				for _, c := range margin.Choices {
					<option value={ marginChoiceValue(c.ID) } data-pct={ c.Pct } selected?={ c.Selected }>{ c.Label }</option>
				}
				if margin.AllowCustom {
					<option value={ CustomMarginValue } selected?={ margin.Custom }>{ margin.CustomOptionLabel() }</option>
				}
			</select>
		</label>
		if margin.AllowCustom {
			<span id="margin-custom" hidden?={ !margin.Custom && !margin.HasKgPrice }>
				<input type="hidden" name="margin_edited" id="margin-edited" value=""/>
				<label>
					Margen (%)
					<input
						type="text"
						inputmode="decimal"
						name="margin_pct"
						id="margin-pct"
						readonly?={ !margin.Custom }
						value={ margin.CustomPct }
						hx-post={ recalcularPath(quote.Folio) }
						hx-trigger="change"
						hx-target="#quote-lines-fragment"
						hx-swap="outerHTML"
					/>
				</label>
				if margin.HasKgPrice {
					<label>
						{ margin.KgPriceLabel() }
						<input
							type="text"
							inputmode="decimal"
							name="copper_price"
							id="copper-price"
							readonly?={ !margin.Custom }
							value={ margin.KgPrice }
							hx-post={ recalcularPath(quote.Folio) }
							hx-trigger="change"
							hx-target="#quote-lines-fragment"
							hx-swap="outerHTML"
						/>
					</label>
				} else if margin.KgPriceHint != "" {
					<span class="hint" id="kg-price-hint">{ margin.KgPriceHint }</span>
				}
			</span>
		}
	</div>
}

templ QuoteBuilder(quote store.Quote, lines []QuoteLineView, totals pricing.Totals, margin MarginPicker, successMsg string, fieldErrs map[string]string, picker ProductPicker, comments []store.QuoteComment, commentsLV ListView, user *NavUser, supplier SupplierQuoteView, dup DuplicateQuoteForm) {
	@Layout("Cotización "+quote.Folio, user) {
		<script src="/static/margin.js" defer></script>
		<div class="page-title">
			<h1>Cotización { quote.Folio }</h1>
			@HelpLink(quoteHelpTopic(quote.Status))
		</div>
		<p>Cliente: { quote.CustomerName }</p>
		if quote.SupersedesFolio != "" {
			<p>Esta es una revisión de <a href={ templ.URL("/cotizaciones/" + quote.SupersedesFolio) }>{ quote.SupersedesFolio }</a>.</p>
		}
		if quote.Status == "borrador" && quote.ProjectID != nil {
			<p>Proyecto: <a href={ templ.URL(projectPath(quote.ProjectFolio)) }>{ quote.ProjectFolio }</a>. Al emitirla será su cotización vigente.</p>
		}
		@Flash(successMsg)
		if quote.Status == "borrador" {
			<form
				id="linea-form"
				method="post"
				action={ templ.URL(recalcularPath(quote.Folio)) }
				data-guard-unsaved
			>
				// Enter in any text field (e.g. iOS's "Ir" key on a qty input) does an
				// implicit submit through the form's first submit button. Without this, that
				// was "Buscar" — a GET reload from the DB that dropped every unsaved line.
				// Visually hidden rather than display:none, which Safari skips as a default.
				<button
					type="submit"
					class="visually-hidden"
					tabindex="-1"
					aria-hidden="true"
					hx-post={ recalcularPath(quote.Folio) }
					hx-target="#quote-lines-fragment"
					hx-swap="outerHTML"
				>
					Recalcular
				</button>
				// QL has no quote margin: each line carries its own (issue #27).
				if !quote.SeriesFreeLines {
					@MarginControls(quote, margin, false)
				}
				if store.RequiresDeliveryTime(quote.SeriesTerms) {
					<div class="quote-meta">
						<label>
							Tiempo de entrega (obligatorio para emitir)
							<input
								type="text"
								name="delivery_time"
								id="delivery-time"
								value={ quote.DeliveryTime }
								maxlength="120"
								placeholder="p. ej. 5 días hábiles"
								{ errAttrs(fieldErrs, "delivery_time")... }
							/>
						</label>
						@FieldError(fieldErrs, "delivery_time")
					</div>
				}
				if store.RequiresCurrency(quote.SeriesTerms) {
					<div class="quote-meta">
						<label>
							Moneda (obligatoria para emitir)
							<select name="currency" id="currency" { errAttrs(fieldErrs, "currency")... }>
								<option value="" selected?={ quote.Currency == "" }>Elige la moneda</option>
								for _, c := range store.Currencies {
									<option value={ c } selected?={ quote.Currency == c }>{ c }</option>
								}
							</select>
						</label>
						<p class="hint">Los precios de las líneas se escriben en esta moneda; no se convierte nada.</p>
						@FieldError(fieldErrs, "currency")
					</div>
				}
				if quote.SeriesFreeLines {
					<div class="quote-meta">
						<label>
							Vigencia: válida hasta (obligatoria para emitir)
							<input
								type="date"
								name="valid_until"
								id="valid-until"
								value={ validUntilValue(quote) }
								{ errAttrs(fieldErrs, "valid_until")... }
							/>
						</label>
						@FieldError(fieldErrs, "valid_until")
					</div>
					<div class="quote-meta">
						<label>
							Términos y condiciones adicionales (opcional)
							<span class="hint">Cada renglón sale como una viñeta en el PDF, después de los términos de la serie.</span>
							<textarea name="extra_terms" id="extra-terms" rows="3" maxlength="2000">{ quote.ExtraTerms }</textarea>
						</label>
					</div>
					@SupplierQuoteSection(supplier, true)
					// The button to add a line sits right above the lines on QL, which has no
					// catalog picker below them (issue #25).
					<p class="picker-free">
						@addFreeLineButton(quote.Folio)
					</p>
				}
				@QuoteLinesFragment(quote, lines, totals, margin.Error)
				<div class="quote-actions">
					<button type="submit" formaction={ guardarPath(quote.Folio) } data-guard-save>
						Guardar borrador
					</button>
					<button
						type="submit"
						class="primary"
						formaction={ emitirPath(quote.Folio) }
						data-guard-save
						data-confirm="¿Emitir la cotización? Sus precios quedan congelados; para cambiarla después habrá que crear una revisión."
					>
						Emitir cotización
					</button>
					<span
						class="save-status saved"
						data-unsaved-status
						data-saved-text="Todos los cambios guardados."
						data-unsaved-text="Hay cambios sin guardar."
						data-busy-text="Recalculando…"
					>Todos los cambios guardados.</span>
				</div>
				if !quote.SeriesFreeLines {
					<section class="quote-add" aria-labelledby="agregar-lineas">
						<h2 id="agregar-lineas">Agregar líneas</h2>
						<div class="toolbar">
							<input
								type="search"
								name="q"
								placeholder="Buscar producto por SKU o descripción…"
								aria-label="Buscar producto por SKU o descripción"
								value={ picker.Query }
								hx-get={ productPickerPath(quote.Folio) }
								hx-trigger="keyup changed delay:400ms, search"
								data-guard-ignore
								hx-target="#product-search-results"
								hx-swap="outerHTML"
							/>
							<button type="submit" formmethod="get" formaction={ "/cotizaciones/" + quote.Folio }>Buscar</button>
						</div>
						@ProductSearchResults(picker)
						<p class="picker-free">
							¿No está en el catálogo?
							@addFreeLineButton(quote.Folio)
						</p>
					</section>
				}
			</form>
		} else {
			@QuoteInfo(quote, lines)
			@QuoteLinesReadOnly(lines, totals, ShowsKg(quote))
			@SupplierQuoteSection(supplier, false)
			if quote.Revisable() {
				<form method="post" action={ templ.URL(revisarPath(quote.Folio)) }>
					<button type="submit">Revisar</button>
				</form>
			} else if quote.Status == "emitida" {
				if quote.Stage == "perdido" {
					<p>Esta cotización ya no se puede revisar: su proyecto se marcó como perdido.</p>
				} else {
					<p>Esta cotización ya no se puede revisar: su proyecto está en { statusLabel(quote.Stage) }.</p>
				}
			} else if quote.Status == "revisada" && quote.SupersededByFolio != "" {
				<p>Esta cotización fue revisada. Ver <a href={ templ.URL("/cotizaciones/" + quote.SupersededByFolio) }>{ quote.SupersededByFolio }</a>.</p>
			}
		}
		@SupplierQuoteForm(supplier)
		@DuplicateQuoteButton(dup)
		<p>
			<a href={ templ.URL("/cotizaciones/" + quote.Folio + "/pdf") } target="_blank">Descargar PDF</a> ·
			<a href="/cotizaciones">Volver a cotizaciones</a>
		</p>
		if quote.Status == "borrador" {
			<p class="hint pdf-note" data-unsaved-note>El PDF muestra lo último guardado, sin los cambios de la pantalla.</p>
		}
		@QuoteComments(quote.ProjectFolio, comments, commentsLV)
	}
}

// addFreeLineButton appends an empty free line, priced on the next recalculation.
templ addFreeLineButton(folio string) {
	<button
		type="submit"
		name="add_free"
		value="1"
		hx-post={ recalcularPath(folio) }
		hx-target="#quote-lines-fragment"
		hx-swap="outerHTML"
	>
		Línea libre
	</button>
}

// QuoteInfo is the issued quote's summary: who issued it and when, its status, and the
// margin and profit it was priced with, all from what was frozen at issue.
templ QuoteInfo(quote store.Quote, lines []QuoteLineView) {
	<dl class="quote-info">
		<dt>Estado</dt>
		<dd>
			@StatusBadge(quote.Status)
		</dd>
		if quote.ProjectID != nil {
			<dt>Proyecto</dt>
			<dd>
				<a href={ templ.URL(projectPath(quote.ProjectFolio)) }>{ quote.ProjectFolio }</a>
				{ " " }
				@StatusBadge(quote.Stage)
				if quote.Status == "emitida" {
					<br/>
					<small>El seguimiento (etapa y probabilidad de cierre) se lleva en el proyecto.</small>
				}
			</dd>
		}
		<dt>Emitió</dt>
		<dd>
			if quote.VendedorSnapshot != nil {
				{ *quote.VendedorSnapshot }
			} else {
				{ quote.UserName }
			}
		</dd>
		if quote.IssuedAt != nil {
			<dt>Emitida</dt>
			<dd>
				@Timestamp(*quote.IssuedAt)
			</dd>
		}
		if quote.ValidUntil != nil {
			<dt>Vigencia</dt>
			<dd>{ dateText(*quote.ValidUntil) }</dd>
		}
		if quote.MarginNameSnapshot != nil && quote.MarginSnapshotMicros != nil {
			{{ f := QuoteMetrics(lines, *quote.MarginSnapshotMicros, quote.Subtotal) }}
			if !quote.SeriesFreeLines {
				<dt>Margen</dt>
				<dd>{ MarginLabel(*quote.MarginNameSnapshot, *quote.MarginSnapshotMicros) }</dd>
			}
			<dt>Costo total</dt>
			<dd>{ f.Cost.String() }</dd>
			<dt>Utilidad</dt>
			<dd>{ f.Profit.String() }</dd>
			if quote.SeriesFreeLines {
				<dt>Margen</dt>
				<dd>{ f.Margin }</dd>
			}
		}
	</dl>
}

// QuoteFigures is what a quote costs and earns before IVA, and the margin that profit is
// of its subtotal.
type QuoteFigures struct {
	Cost, Profit money.Centavos
	Margin       string
}

// QuoteMetrics works out a quote's QuoteFigures: catalog lines earn their total times the
// margin they were priced with (a fraction of the sale price); a free line with a cost
// earns its total less that cost (issue #27), one without a cost earns nothing; the cost
// is the rest of the subtotal. It is the same figure as store's quoteProfitSQL.
func QuoteMetrics(lines []QuoteLineView, margin money.Micros, subtotal money.Centavos) QuoteFigures {
	var priced, free money.Centavos
	for _, l := range lines {
		switch {
		case !l.IsFree:
			priced += l.LineTotal
		case l.CostMicros != nil:
			free += l.LineTotal - money.LineTotalCentavos(*l.CostMicros, l.QtyMilli)
		}
	}
	profit := money.Centavos(money.RoundHalfUp(int64(priced)*int64(margin), 1_000_000)) + free
	return QuoteFigures{Cost: subtotal - profit, Profit: profit, Margin: marginPercentText(int64(profit), int64(subtotal))}
}

// QuoteComments is the read-only comments list at the foot of every quote: everyone's
// comments, newest first, a page at a time. Comments are written from the proyecto, so
// there is no form here, only a pointer to it (projectFolio is "" for a draft that has no
// proyecto). Each comment leads with its text; who wrote it and when sit below in a
// smaller, muted line, since the list's order already says which came first.
templ QuoteComments(projectFolio string, comments []store.QuoteComment, lv ListView) {
	<section id="comentarios">
		<h2>Comentarios</h2>
		if projectFolio != "" {
			<p class="hint">Los comentarios se escriben desde el <a href={ templ.URL(projectPath(projectFolio) + "#historial") }>proyecto { projectFolio }</a>.</p>
		}
		if len(comments) == 0 {
			<p class="comments-empty">Sin comentarios.</p>
		} else {
			<ol class="comments">
				for _, c := range comments {
					<li>
						<p class="comment-body">{ c.Body }</p>
						<p class="comment-meta">
							{ c.UserName + " · " }
							@Timestamp(c.CreatedAt)
						</p>
					</li>
				}
			</ol>
		}
		@listPager(lv, false)
	</section>
}

// Timestamp renders a stored UTC timestamp as 28/09/2026 - 16:42. The server can't know
// the viewer's time zone, so it writes UTC into a <time> element and /static/time.js
// rewrites it in the browser's zone.
templ Timestamp(iso string) {
	<time class="ts" datetime={ iso }>{ timestampFallback(iso) }</time>
}
