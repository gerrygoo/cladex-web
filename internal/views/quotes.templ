package views

import (
	"strconv"
	"strings"

	"github.com/gerrygoo/cladex-web/internal/money"
	"github.com/gerrygoo/cladex-web/internal/pricing"
	"github.com/gerrygoo/cladex-web/internal/store"
)

// QuoteLineView is the builder's per-line view-model: a computed line, whether it came
// from a persisted quote_lines row or an in-progress (unsaved) edit. Raw fields
// (QtyRaw, UnitPriceRaw) redisplay exactly what was typed, per the form convention; a
// non-empty Error means this line didn't price and doesn't count toward Totals.
type QuoteLineView struct {
	Key               string
	IsFree            bool
	ProductID         *int64
	ProductLabel      string
	Description       string
	UnitCode          string
	QtyRaw            string
	QtyMilli          money.Milli
	UnitPriceRaw      string
	UnitPriceMicros   money.Micros
	LineTotal         money.Centavos
	PricingInputsJSON *string
	Error             string
}

// quotesSortHeader is a plain full-page link, not htmx — see productsSortHeader's doc
// comment for why.
templ quotesSortHeader(label, col, query, sort, dir string) {
	<th>
		<a href={ templ.URL(SortHref("/cotizaciones", query, col, sort, dir)) }>{ label } { SortIndicator(col, sort, dir) }</a>
	</th>
}

templ QuotesList(quotes []store.Quote, query string, sort string, dir string, successMsg string, user *NavUser) {
	@Layout("Cotizaciones", user) {
		<h1>Cotizaciones</h1>
		if successMsg != "" {
			<p class="success">{ successMsg }</p>
		}
		<div class="toolbar">
			<form method="get" action="/cotizaciones" role="search">
				<input
					type="search"
					name="q"
					placeholder="Buscar por folio o cliente…"
					value={ query }
					hx-get="/cotizaciones"
					hx-trigger="keyup changed delay:400ms, search"
					hx-target="#cotizaciones-tbody"
					hx-swap="outerHTML"
					hx-push-url="true"
				/>
				<button type="submit">Buscar</button>
			</form>
			<a href="/cotizaciones/nueva"><button type="button">Nueva cotización</button></a>
		</div>
		<table>
			<thead>
				<tr>
					@quotesSortHeader("Folio", "folio", query, sort, dir)
					@quotesSortHeader("Cliente", "cliente", query, sort, dir)
					@quotesSortHeader("Estado", "estado", query, sort, dir)
					@quotesSortHeader("Total", "total", query, sort, dir)
					@quotesSortHeader("Fecha", "fecha", query, sort, dir)
				</tr>
			</thead>
			@QuotesTableBody(quotes)
		</table>
	}
}

templ QuotesTableBody(quotes []store.Quote) {
	<tbody id="cotizaciones-tbody">
		if len(quotes) == 0 {
			<tr>
				<td colspan="5">No se encontraron cotizaciones.</td>
			</tr>
		}
		for _, q := range quotes {
			<tr>
				<td><a href={ templ.URL("/cotizaciones/" + q.Folio) }>{ q.Folio }</a></td>
				<td>{ q.CustomerName }</td>
				<td>{ q.Status }</td>
				<td>{ q.Total.String() }</td>
				<td>{ q.CreatedAt }</td>
			</tr>
		}
	</tbody>
}

// QuoteNewFormValues is the view-model for QuoteNewForm.
type QuoteNewFormValues struct {
	CustomerID string
	Prefix     string
}

// quotePrefixOptions labels the three folio series a new quote can start in — a free
// choice per the user's decision, not a restriction on which products the quote can
// later contain (see docs/PLAN.md's M2.2 notes).
var quotePrefixOptions = []struct{ Code, Label string }{
	{"QA", "QA — Cable CCA"},
	{"QS", "QS — Cable CCS & AC"},
	{"QI", "QI — Alumbrado"},
}

templ QuoteNewForm(customers []store.Customer, values QuoteNewFormValues, fieldErrors map[string]string, user *NavUser) {
	@Layout("Nueva cotización", user) {
		<h1>Nueva cotización</h1>
		<form method="post" action={ templ.URL("/cotizaciones/nueva") }>
			<label>
				Cliente
				<select name="customer_id" required>
					<option value="">— Selecciona —</option>
					for _, c := range customers {
						if strconv.FormatInt(c.ID, 10) == values.CustomerID {
							<option value={ strconv.FormatInt(c.ID, 10) } selected>{ c.Name }</option>
						} else {
							<option value={ strconv.FormatInt(c.ID, 10) }>{ c.Name }</option>
						}
					}
				</select>
			</label>
			if fieldErrors["customer_id"] != "" {
				<p class="error">{ fieldErrors["customer_id"] }</p>
			}
			<fieldset>
				<legend>Serie de folio</legend>
				for _, opt := range quotePrefixOptions {
					<label>
						if opt.Code == values.Prefix {
							<input type="radio" name="prefix" value={ opt.Code } checked/>
						} else {
							<input type="radio" name="prefix" value={ opt.Code }/>
						}
						{ opt.Label }
					</label>
				}
			</fieldset>
			if fieldErrors["prefix"] != "" {
				<p class="error">{ fieldErrors["prefix"] }</p>
			}
			<button type="submit">Crear cotización</button>
			<a href="/cotizaciones">Cancelar</a>
		</form>
	}
}

// recalcularPath is the htmx/formaction target every line mutation posts to — never
// persists, just reprices the submitted set (see internal/web/quotes.go's Recalcular).
func recalcularPath(folio string) string {
	return "/cotizaciones/" + folio + "/recalcular"
}

// guardarPath is the formaction the one "Guardar borrador" button overrides to — the
// only control in the form that actually writes the draft.
func guardarPath(folio string) string {
	return "/cotizaciones/" + folio + "/guardar"
}

func lineKind(l QuoteLineView) string {
	if l.IsFree {
		return "free"
	}
	return "product"
}

func productIDValue(id *int64) string {
	if id == nil {
		return ""
	}
	return strconv.FormatInt(*id, 10)
}

func lineKeysValue(lines []QuoteLineView) string {
	keys := make([]string, len(lines))
	for i, l := range lines {
		keys[i] = l.Key
	}
	return strings.Join(keys, ",")
}

templ quoteLineRow(folio string, line QuoteLineView) {
	<tr>
		<td>
			<input type="hidden" name={ "lines[" + line.Key + "][kind]" } value={ lineKind(line) }/>
			if line.IsFree {
				<input
					type="text"
					name={ "lines[" + line.Key + "][description]" }
					value={ line.Description }
					placeholder="Descripción"
					hx-post={ recalcularPath(folio) }
					hx-trigger="change"
					hx-target="#quote-lines-fragment"
					hx-swap="outerHTML"
				/>
			} else {
				<input type="hidden" name={ "lines[" + line.Key + "][product_id]" } value={ productIDValue(line.ProductID) }/>
				{ line.ProductLabel }
			}
		</td>
		<td>
			<input
				type="text"
				name={ "lines[" + line.Key + "][qty]" }
				value={ line.QtyRaw }
				size="6"
				hx-post={ recalcularPath(folio) }
				hx-trigger="change"
				hx-target="#quote-lines-fragment"
				hx-swap="outerHTML"
			/>
			if line.UnitCode != "" {
				{ line.UnitCode }
			}
		</td>
		<td>
			if line.IsFree {
				<input
					type="text"
					name={ "lines[" + line.Key + "][unit_price]" }
					value={ line.UnitPriceRaw }
					placeholder="p. ej. 123.45"
					hx-post={ recalcularPath(folio) }
					hx-trigger="change"
					hx-target="#quote-lines-fragment"
					hx-swap="outerHTML"
				/>
			} else {
				{ line.UnitPriceMicros.ToCentavosHalfUp().String() }
			}
		</td>
		<td>{ line.LineTotal.String() }</td>
		<td>
			<button
				type="submit"
				name="remove_key"
				value={ line.Key }
				hx-post={ recalcularPath(folio) }
				hx-target="#quote-lines-fragment"
				hx-swap="outerHTML"
			>
				Eliminar
			</button>
		</td>
	</tr>
	if line.Error != "" {
		<tr>
			<td colspan="5" class="error">{ line.Error }</td>
		</tr>
	}
}

// QuoteLinesFragment is the swappable line-table+totals partial — rendered both as part
// of the full QuoteBuilder page and as the direct htmx response from Recalcular. It
// carries line_keys, the ordered list of currently-present row keys that
// parseQuoteLineInputs reads back on the next submit; nothing here writes to the
// database.
templ QuoteLinesFragment(quote store.Quote, lines []QuoteLineView, totals pricing.Totals) {
	<div id="quote-lines-fragment">
		<input type="hidden" name="line_keys" value={ lineKeysValue(lines) }/>
		<table>
			<thead>
				<tr>
					<th>Producto / Descripción</th>
					<th>Cantidad</th>
					<th>Precio unitario</th>
					<th>Total</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				if len(lines) == 0 {
					<tr>
						<td colspan="5">Sin líneas todavía.</td>
					</tr>
				}
				for _, line := range lines {
					@quoteLineRow(quote.Folio, line)
				}
			</tbody>
		</table>
		<div class="quote-totals">
			<p>Subtotal: { totals.Subtotal.String() }</p>
			<p>IVA (16%): { totals.IVA.String() }</p>
			<p><strong>Total: { totals.Total.String() }</strong></p>
		</div>
	</div>
}

// ProductSearchResults is the "add line" picker's search results — each result is a
// submit button that appends that product as a new line via add_product_id, priced by
// Recalcular server-side (never a client-supplied price). Not scoped to the quote's own
// folio prefix; any product may be added to any quote.
templ ProductSearchResults(products []store.Product) {
	<div id="product-search-results">
		if len(products) > 0 {
			<ul>
				for _, p := range products {
					<li>
						<button type="submit" name="add_product_id" value={ strconv.FormatInt(p.ID, 10) }>
							{ p.SKU } — { p.Description } ({ productPriceDisplay(p) })
						</button>
					</li>
				}
			</ul>
		}
	</div>
}

// emitirPath is the formaction the "Emitir cotización" button overrides to — saves the
// submitted line set (same as Guardar) and then freezes the quote.
func emitirPath(folio string) string {
	return "/cotizaciones/" + folio + "/emitir"
}

// revisarPath is the action for the read-only "Revisar" button on an issued quote —
// creates a new editable "<folio>-R<n>" draft and redirects into it.
func revisarPath(folio string) string {
	return "/cotizaciones/" + folio + "/revisar"
}

// QuoteLinesReadOnly renders an issued or revised quote's frozen lines — no qty
// inputs, no remove buttons, nothing that implies the row can still change. Used
// instead of QuoteLinesFragment once a quote leaves 'borrador'.
templ QuoteLinesReadOnly(lines []QuoteLineView, totals pricing.Totals) {
	<table>
		<thead>
			<tr>
				<th>Producto / Descripción</th>
				<th>Cantidad</th>
				<th>Precio unitario</th>
				<th>Total</th>
			</tr>
		</thead>
		<tbody>
			if len(lines) == 0 {
				<tr>
					<td colspan="4">Sin líneas.</td>
				</tr>
			}
			for _, line := range lines {
				<tr>
					<td>
						if line.IsFree {
							{ line.Description }
						} else {
							{ line.ProductLabel }
						}
					</td>
					<td>
						{ line.QtyMilli.String() }
						if line.UnitCode != "" {
							{ " " + line.UnitCode }
						}
					</td>
					<td>{ line.UnitPriceMicros.ToCentavosHalfUp().String() }</td>
					<td>{ line.LineTotal.String() }</td>
				</tr>
			}
		</tbody>
	</table>
	<div class="quote-totals">
		<p>Subtotal: { totals.Subtotal.String() }</p>
		<p>IVA (16%): { totals.IVA.String() }</p>
		<p><strong>Total: { totals.Total.String() }</strong></p>
	</div>
}

// QuoteBuilder is the main /cotizaciones/{folio} page. A draft ('borrador') gets the
// full editable form: every mutating control lives inside the one
// <form id="linea-form">, whose default action is Recalcular (a pure recompute, never
// persisted); "Guardar borrador" and "Emitir cotización" are the only two buttons that
// override their own formaction to actually write. searchQuery/searchResults are the
// no-JS fallback for the product picker (a real page reload with ?q=) — htmx otherwise
// enhances the same input into a live, in-place search against BuscarProductos.
//
// An issued ('emitida') or revised ('revisada') quote is immutable, so it renders a
// read-only summary instead: QuoteLinesReadOnly, the frozen issue metadata, and either
// a "Revisar" button (emitida — the active version) or a note pointing at whichever
// revision superseded it (revisada).
templ QuoteBuilder(quote store.Quote, lines []QuoteLineView, totals pricing.Totals, successMsg string, searchQuery string, searchResults []store.Product, user *NavUser) {
	@Layout("Cotización "+quote.Folio, user) {
		<h1>Cotización { quote.Folio }</h1>
		<p>
			Cliente: { quote.CustomerName } ·
			Serie: { quote.Prefix } ·
			Estado: { quote.Status }
		</p>
		if quote.SupersedesFolio != "" {
			<p>Esta es una revisión de <a href={ templ.URL("/cotizaciones/" + quote.SupersedesFolio) }>{ quote.SupersedesFolio }</a>.</p>
		}
		if successMsg != "" {
			<p class="success">{ successMsg }</p>
		}
		if quote.Status == "borrador" {
			<form id="linea-form" method="post" action={ templ.URL(recalcularPath(quote.Folio)) }>
				<div class="toolbar">
					<input
						type="search"
						name="q"
						placeholder="Buscar producto por SKU o descripción…"
						value={ searchQuery }
						hx-get={ "/cotizaciones/" + quote.Folio + "/productos" }
						hx-trigger="keyup changed delay:400ms, search"
						hx-target="#product-search-results"
						hx-swap="outerHTML"
					/>
					<button type="submit" formmethod="get" formaction={ "/cotizaciones/" + quote.Folio }>Buscar</button>
					<button
						type="submit"
						name="add_free"
						value="1"
						hx-post={ recalcularPath(quote.Folio) }
						hx-target="#quote-lines-fragment"
						hx-swap="outerHTML"
					>
						Línea libre
					</button>
				</div>
				@ProductSearchResults(searchResults)
				@QuoteLinesFragment(quote, lines, totals)
				<button type="submit" formaction={ guardarPath(quote.Folio) }>
					Guardar borrador
				</button>
				<button type="submit" formaction={ emitirPath(quote.Folio) }>
					Emitir cotización
				</button>
			</form>
		} else {
			@QuoteLinesReadOnly(lines, totals)
			<p>
				if quote.IssuedAt != nil {
					Emitida: { *quote.IssuedAt } ·
				}
				if quote.ValidUntil != nil {
					Vigencia: { *quote.ValidUntil } ·
				}
				if quote.FxRateUsedMicros != nil {
					Tipo de cambio usado: { quote.FxRateUsedMicros.String() }
				}
			</p>
			if quote.Status == "emitida" {
				<form method="post" action={ templ.URL(revisarPath(quote.Folio)) }>
					<button type="submit">Revisar</button>
				</form>
			} else if quote.Status == "revisada" && quote.SupersededByFolio != "" {
				<p>Esta cotización fue revisada. Ver <a href={ templ.URL("/cotizaciones/" + quote.SupersededByFolio) }>{ quote.SupersededByFolio }</a>.</p>
			}
		}
		<p>
			<a href={ templ.URL("/cotizaciones/" + quote.Folio + "/pdf") } target="_blank">Descargar PDF</a> ·
			<a href="/cotizaciones">Volver a cotizaciones</a>
		</p>
	}
}
