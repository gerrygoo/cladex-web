package views

templ Login(errorMsg string, username string) {
	@Layout("Iniciar sesión", nil) {
		<div class="login">
			<h1>Iniciar sesión</h1>
			@FormError(errorMsg)
			<form method="post" action="/login">
				<label>
					Usuario
					<input type="text" name="username" value={ username } required autofocus autocomplete="username" autocapitalize="none"/>
				</label>
				<label>
					Contraseña
					<input type="password" name="password" required autocomplete="current-password"/>
				</label>
				<button type="submit" class="primary">Entrar</button>
			</form>
		</div>
	}
}
