package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// FamiliaFormValues is the create form's state, kept when validation sends it back.
type FamiliaFormValues struct {
	Name          string
	Series        string
	SeriesLabel   string
	Terms         string
	FreeLinesOnly bool
}

templ FamiliasList(families []store.Family, values FamiliaFormValues, fieldErrors map[string]string, successMsg string, user *NavUser) {
	@Layout("Familias", user) {
		<div class="page-title">
			<h1>Familias</h1>
			@HelpLink(HelpFamilias)
		</div>
		@Flash(successMsg)
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Familia</th>
						<th>Serie</th>
						<th>Descripción de la serie</th>
						<th>Productos</th>
						<th><span class="visually-hidden">Acciones</span></th>
					</tr>
				</thead>
				<tbody>
					for _, f := range families {
						<tr>
							<td>{ f.Name }</td>
							<td>{ f.Series }</td>
							<td>{ f.SeriesLabel }</td>
							<td>
								if f.FreeLinesOnly {
									Solo líneas libres
								} else {
									De catálogo
								}
							</td>
							<td><a href={ templ.URL("/familias/" + strconv.FormatInt(f.ID, 10)) }>Editar términos<span class="visually-hidden"> de { f.Name }</span></a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<h2>Nueva familia</h2>
		<p>Al crear una familia se crea también su serie de folio (p. ej. QF0001).</p>
		<form method="post" action="/familias">
			<label>
				Nombre
				<input type="text" name="name" value={ values.Name } required { errAttrs(fieldErrors, "name")... }/>
			</label>
			@FieldError(fieldErrors, "name")
			<label>
				Serie (dos letras, empieza con Q)
				<input type="text" name="series" value={ values.Series } maxlength="2" pattern="[Qq][A-Za-z]" placeholder="p. ej. QF" required { errAttrs(fieldErrors, "series")... }/>
			</label>
			@FieldError(fieldErrors, "series")
			<label>
				Descripción de la serie (opcional)
				<input type="text" name="series_label" value={ values.SeriesLabel } placeholder="p. ej. Cobijas ignífugas"/>
			</label>
			<label>
				Términos y condiciones del PDF (uno por línea)
				<textarea name="terms" rows="6">{ values.Terms }</textarea>
			</label>
			<label>
				<input type="checkbox" name="free_lines_only" value="1" checked?={ values.FreeLinesOnly }/>
				Sin productos de catálogo: solo se cotiza con líneas libres
			</label>
			<button type="submit" class="primary">Crear familia</button>
		</form>
	}
}

templ FamiliaEdit(f store.Family, seriesLabel string, terms string, user *NavUser) {
	@Layout("Editar "+f.Name, user) {
		<div class="page-title">
			<h1>Editar familia { f.Name }</h1>
			@HelpLink(HelpFamilias)
		</div>
		<p>Serie <strong>{ f.Series }</strong>. El nombre y la serie no se pueden cambiar.</p>
		<p>Los cambios se usan en los borradores y en las cotizaciones que se emitan de ahora en adelante; las ya emitidas conservan los términos con que salieron.</p>
		<form method="post" action={ templ.URL("/familias/" + strconv.FormatInt(f.ID, 10)) }>
			<label>
				Descripción de la serie (opcional)
				<input type="text" name="series_label" value={ seriesLabel }/>
			</label>
			<label>
				Términos y condiciones del PDF (uno por línea)
				<textarea name="terms" rows="10">{ terms }</textarea>
			</label>
			<button type="submit" class="primary">Guardar</button>
			<a href="/familias">Cancelar</a>
		</form>
	}
}
