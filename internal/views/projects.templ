package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

func projectPath(folio string) string {
	return "/proyectos/" + folio
}

// seguimientoPath is the action of a prospecto's follow-up form (probabilidad de cierre
// and its two dates), see store.FollowUpProject.
func seguimientoPath(folio string) string {
	return projectPath(folio) + "/seguimiento"
}

// receiveOCHint says what receiving the purchase order does to a prospecto.
const receiveOCHint = "Cuando el cliente mande su orden de compra, captura sus datos para pasar el proyecto a En curso. Desde ese momento la cotización ya no se puede revisar."

templ ProjectsList(projects []store.Project, today string, lv ListView, customers, owners []string, user *NavUser) {
	@Layout("Proyectos", user) {
		<div class="page-title">
			<h1>Proyectos</h1>
			@HelpLink(HelpProyectos)
		</div>
		<div class="toolbar">
			<form method="get" action="/proyectos" role="search">
				<input
					type="search"
					name="q"
					placeholder="Buscar por folio, cliente o nombre del proyecto…"
					aria-label="Buscar por folio, cliente o nombre del proyecto"
					value={ lv.Query }
					hx-get="/proyectos"
					hx-trigger="keyup changed delay:400ms, search"
					hx-target="#proyectos-tbody"
					hx-swap="outerHTML"
					hx-include="closest form"
					hx-push-url="true"
				/>
				@listHiddenInputs(lv, "q")
				<button type="submit">Buscar</button>
			</form>
		</div>
		@listActiveFilters(lv)
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						@columnHeader(lv, "Proyecto", "folio", textFilter)
						@columnHeader(lv, "Cliente", "cliente", choiceFilter(customers))
						@columnHeader(lv, "Vendedor", "vendedor", choiceFilter(owners))
						@columnHeader(lv, "Etapa", "etapa", projectStageFilter)
						@columnHeader(lv, "Probabilidad", "probabilidad", projectProbabilityFilter)
						@sortHeader(lv, "Próximo seguimiento", "seguimiento", false)
						@columnHeader(lv, "Cobro", "cobro", projectCobroFilter)
						@columnHeader(lv, "Total", "total", numberFilter)
						@columnHeader(lv, "Abierto", "fecha", dateFilter)
					</tr>
				</thead>
				@ProjectsTableBody(projects, today)
			</table>
		</div>
		@listPager(lv, false)
	}
}

// ProjectsTableBody is the rows of the Proyectos list. today is the viewer's day, to
// mark a prospecto whose next follow-up has already passed.
templ ProjectsTableBody(projects []store.Project, today string) {
	<tbody id="proyectos-tbody" data-announce={ countAnnouncement(len(projects), "proyecto", "proyectos") }>
		if len(projects) == 0 {
			<tr>
				<td colspan="9">No se encontraron proyectos. Un proyecto se abre al emitir una cotización.</td>
			</tr>
		}
		for _, p := range projects {
			<tr>
				<td><a href={ templ.URL(projectPath(p.Folio)) }>{ p.Label() }</a></td>
				<td>{ p.CustomerName }</td>
				<td>{ p.UserName }</td>
				<td>
					@StatusBadge(p.Stage())
				</td>
				<td>
					if p.Status == "prospecto" {
						{ probabilityText(p.Probability) }
						if p.ForecastRelevant() {
							<br/>
							<strong class="forecast">{ forecastLabel }</strong>
						}
					}
				</td>
				<td>
					// As on the proyecto's page, the follow-up date only means something
					// while it is a prospecto (#61).
					if p.Status == "prospecto" {
						@dateWarningCell(p.NextFollowUpDate, FollowUpOverdue(p, today))
					}
				</td>
				<td>
					if p.Status == store.StageEnCurso {
						{ store.CobroLabels[p.States.Cobro] }
					}
				</td>
				<td class="num">{ p.Total.String() }</td>
				<td>
					@Timestamp(p.CreatedAt)
				</td>
			</tr>
		}
	</tbody>
}

// projectNameForm sets or changes the proyecto's name (issue #73): optional, up to
// store.MaxProjectName characters, with a count of what's left as it is typed
// (static/app.js). Any user can, at any stage.
templ projectNameForm(p store.Project) {
	<form method="post" action={ templ.URL(projectPath(p.Folio) + "/nombre") } class="stage-form project-name-form">
		<label>
			Nombre del proyecto (opcional)
			<input type="text" name="name" value={ p.Name } maxlength={ strconv.Itoa(store.MaxProjectName) } placeholder="p. ej. Capuchinas" data-char-count={ "nombre-count-" + p.Folio } aria-describedby={ "nombre-count-" + p.Folio }/>
		</label>
		<small class="hint" id={ "nombre-count-" + p.Folio } aria-live="polite">{ strconv.Itoa(len([]rune(p.Name))) } / { strconv.Itoa(store.MaxProjectName) }</small>
		<button type="submit">Guardar nombre</button>
	</form>
}

// ProjectPage is a proyecto: where it stands (its stage and, once en curso, its Estado
// de facturación, de entrega and de cobro), its follow-up and history, its factura,
// supplier O.C.s, their delivery (Entrega) and payments (Cobro), every quote it has had,
// and the admin's tools at the bottom.
templ ProjectPage(p store.Project, today string, quotes []store.Quote, files []store.ProjectFile, receipt store.OCReceipt, comments []store.ProjectComment, commentsLV ListView, facturas []store.Comprobante, factEnabled bool, user *NavUser, supplier SupplierQuoteView, adminPanel *AdminPanel, pos ProjectPOs, entrega ProjectEntrega, cobro ProjectCobro) {
	@Layout("Proyecto "+p.Label(), user) {
		<div class="page-title">
			<h1>Proyecto { p.Label() }</h1>
			@HelpLink(HelpProyecto)
		</div>
		<p>Cliente: { p.CustomerName }</p>
		@projectNameForm(p)
		<dl class="quote-info">
			<dt>Etapa</dt>
			<dd>
				@StatusBadge(p.Stage())
			</dd>
			if p.Status == "prospecto" {
				<dt>Probabilidad</dt>
				<dd>
					{ probabilityText(p.Probability) }
					if p.ForecastRelevant() {
						· <strong class="forecast">{ forecastLabel }</strong>
					}
					<br/>
					<small>
						{ "Actualizada " }
						@Timestamp(p.ProbabilityUpdatedAt)
					</small>
				</dd>
			}
			if p.Status == "prospecto" {
				<dt>O.C. esperada</dt>
				<dd>
					if p.ExpectedOCDate != "" {
						{ dateText(p.ExpectedOCDate) }
					} else {
						Sin fecha
					}
				</dd>
				<dt>Próximo seguimiento</dt>
				<dd>
					if p.NextFollowUpDate != "" {
						{ dateText(p.NextFollowUpDate) }
						if p.FollowUpDue(today) {
							· <strong class="overdue">toca darle seguimiento</strong>
						}
					} else {
						Sin fecha
					}
				</dd>
			}
			<dt>Vendedor</dt>
			<dd>{ p.UserName }</dd>
			<dt>Abierto</dt>
			<dd>
				@Timestamp(p.CreatedAt)
			</dd>
			<dt>Cotización vigente</dt>
			<dd>
				<a href={ templ.URL("/cotizaciones/" + p.CurrentQuoteFolio) }>{ p.CurrentQuoteFolio }</a>
				if p.CurrentQuoteStatus == store.QuoteBorrador {
					· revisión en borrador, aún sin emitir
				}
				· <a href={ templ.URL(duplicarPath(p.CurrentQuoteFolio)) }>Duplicar</a>
			</dd>
			<dt>Total con IVA</dt>
			<dd>{ p.Total.String() }</dd>
			<dt>Precio de venta sin IVA</dt>
			<dd>{ p.Subtotal.String() }</dd>
			// What the current quote costs and earns before IVA (issue #46), as in the
			// pronóstico; a revision in draft has no margin frozen yet, so it earns nothing.
			if p.CurrentQuoteStatus != store.QuoteBorrador {
				<dt>Costo sin IVA</dt>
				<dd>{ p.Cost().String() }</dd>
				<dt>Utilidad</dt>
				<dd>{ p.Profit.String() }</dd>
				<dt>Margen</dt>
				<dd>{ ProjectMargin(p) }</dd>
			}
			// The three states of a proyecto en curso (#66, #67), derived from its records
			// and only read here.
			if p.Status == store.StageEnCurso {
				<dt>Estado de facturación</dt>
				<dd>{ store.FacturacionLabels[p.States.Facturacion] }</dd>
				<dt>Estado de entrega</dt>
				<dd>
					@EntregaState(p, entrega)
				</dd>
				<dt>Estado de cobro</dt>
				<dd>{ cobroText(p) }</dd>
			}
		</dl>
		if p.Status == store.StagePerdido {
			<h2>Proyecto perdido</h2>
			<dl class="quote-info">
				<dt>Motivo</dt>
				<dd class="comment-body">{ p.LostReason }</dd>
				<dt>Se perdió</dt>
				<dd>
					@Timestamp(p.LostAt)
					{ " · estaba en " + store.StageLabels[p.LostFrom] }
				</dd>
			</dl>
			if user != nil {
				<form method="post" action={ templ.URL(projectPath(p.Folio) + "/reabrir") } class="stage-form">
					if p.LostFrom == "prospecto" {
						<fieldset class="probability">
							<legend>Reabrir con probabilidad de cierre</legend>
							for _, st := range store.ProbabilitySteps {
								<label>
									<input type="radio" name="probabilidad" value={ strconv.Itoa(st.Percent) } checked?={ st.Percent == p.Probability } required/>
									{ st.Label }
									<small>{ strconv.Itoa(st.Percent) }%</small>
								</label>
							}
						</fieldset>
					}
					<label>
						Comentario
						<textarea name="note" rows="2" maxlength="2000" required></textarea>
					</label>
					<button type="submit">Reabrir como { store.StageLabels[p.LostFrom] }</button>
				</form>
			}
		}
		if p.Status == store.StageCancelado {
			<h2>Proyecto cancelado</h2>
			<dl class="quote-info">
				<dt>Motivo</dt>
				<dd class="comment-body">{ p.CancelReason }</dd>
				<dt>Se canceló</dt>
				<dd>
					@Timestamp(p.CancelledAt)
					{ " · estaba en " + store.StageLabels[p.CancelledFrom] }
				</dd>
			</dl>
			if user != nil && user.IsAdmin {
				<form method="post" action={ templ.URL(projectPath(p.Folio) + "/reactivar") } class="stage-form">
					<label>
						Motivo
						<textarea name="reason" rows="2" maxlength="2000" required></textarea>
					</label>
					<button type="submit">Reactivar como { store.StageLabels[p.CancelledFrom] }</button>
				</form>
			} else {
				<p>Solo un administrador puede reactivarlo.</p>
			}
		}
		@followUpAndComments(p, today, files, receipt, comments, commentsLV)
		if p.Status == store.StageEnCurso && p.HasOC() || p.Invoice.Ref != "" || len(facturas) > 0 {
			<section id="facturacion">
				<h2>Facturación</h2>
				if p.Invoice.Ref != "" {
					<dl class="quote-info">
						if p.PaymentMethod != "" {
							<dt>Método de pago</dt>
							<dd>{ paymentMethodText(p.PaymentMethod) }</dd>
						}
						<dt>Factura</dt>
						<dd>{ p.Invoice.Ref + " · " + dateText(p.Invoice.Date) }</dd>
					</dl>
				}
				@ProjectFacturas(facturas)
				if p.Status == store.StageEnCurso && !hasActiveFactura(facturas) && p.States.Facturacion == store.FacturacionPendiente {
					if user != nil && user.IsAdmin {
						if factEnabled {
							<form method="post" action={ templ.URL(projectPath(p.Folio) + "/factura/nueva") } class="stage-form">
								<h3>Facturar</h3>
								<p>Crea la factura con las partidas de la cotización. Al timbrarla, el Estado de facturación pasa a Facturada (o a Pendiente complemento de pago, si es P.P.D.).</p>
								<button type="submit" class="primary">Crear factura</button>
							</form>
						}
						@ManualFacturaForm(p, today, !factEnabled)
					} else {
						<p>Un administrador registra la factura.</p>
					}
				}
			</section>
		}
		@ProjectPOSection(p, pos)
		if p.Status == store.StageEnCurso && len(entrega.Orders) > 0 {
			@ProjectEntregaSection(p, entrega, today)
		}
		if p.Status == store.StageEnCurso || len(cobro.Payments) > 0 {
			@ProjectCobroSection(p, cobro, today)
		}
		@SupplierQuoteSection(supplier, false)
		@SupplierQuoteForm(supplier)
		<h2>Cotizaciones</h2>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Folio</th>
						<th>Estado</th>
						<th class="num">Total</th>
						<th>Emitida</th>
					</tr>
				</thead>
				<tbody>
					for _, q := range quotes {
						<tr>
							<td><a href={ templ.URL("/cotizaciones/" + q.Folio) }>{ q.Folio }</a></td>
							<td>
								@StatusBadge(q.Status)
							</td>
							<td class="num">{ q.Total.String() }</td>
							<td>
								if q.IssuedAt != nil {
									@Timestamp(*q.IssuedAt)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		@AdminPanelSection(adminPanel)
		<p><a href="/proyectos">Volver a proyectos</a></p>
	}
}

// ProjectCobro is the proyecto page's Cobro section (#67): its payments, and who may
// record one (the proyecto's vendedor and the admins) and delete one (the admins).
type ProjectCobro struct {
	Payments  []store.Payment
	CanRecord bool
	CanDelete bool
}

// ProjectCobroSection lists the client's payments with the total with IVA, what is paid
// and what is left, and, while something is left, "Registrar pago": a disclosure that
// opens the form (the day, by default today and never later; the amount, by default the
// saldo; and whether to upload the comprobante, which static/app.js shows when Sí is
// picked). An admin deletes a payment from its row, with a motivo.
templ ProjectCobroSection(p store.Project, c ProjectCobro, today string) {
	<section id="cobro">
		<h2>Cobro</h2>
		if len(c.Payments) == 0 {
			<p>Todavía no hay pagos registrados.</p>
		} else {
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">Fecha de pago</th>
							<th scope="col" class="num">Monto</th>
							<th scope="col">Comprobante</th>
							<th scope="col">Registró</th>
							if c.CanDelete {
								<th scope="col">Eliminar</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, pm := range c.Payments {
							<tr>
								<td>{ dateText(pm.PaidOn) }</td>
								<td class="num">{ pm.Amount.String() }</td>
								<td>
									if pm.FileID != 0 {
										<a href={ templ.URL(projectFilePath(p.Folio, pm.FileID)) }>{ pm.FileName }</a>
									} else {
										Sin comprobante
									}
								</td>
								<td>
									{ pm.CreatedByName + " · " }
									@Timestamp(pm.CreatedAt)
								</td>
								if c.CanDelete {
									<td>
										<details class="disclosure">
											<summary>Eliminar<span class="visually-hidden">{ " el pago de " + pm.Amount.String() + " del " + dateText(pm.PaidOn) }</span></summary>
											<form method="post" action={ templ.URL(projectPath(p.Folio) + "/pagos/" + strconv.FormatInt(pm.ID, 10) + "/eliminar") } class="stage-form">
												<label>
													Motivo
													<textarea name="reason" rows="2" maxlength="2000" required></textarea>
												</label>
												<button type="submit" class="danger" data-confirm={ "¿Eliminar el pago de " + pm.Amount.String() + " del " + dateText(pm.PaidOn) + "?" }>Eliminar pago</button>
											</form>
										</details>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<dl class="quote-info">
			<dt>Total del proyecto (con IVA)</dt>
			<dd>{ p.Total.String() }</dd>
			<dt>Pagado</dt>
			<dd>{ p.States.Paid.String() }</dd>
			<dt>Saldo pendiente</dt>
			<dd>{ p.Balance().String() }</dd>
		</dl>
		if p.Status == store.StageEnCurso && p.Balance() > 0 {
			if c.CanRecord {
				<details class="disclosure" id="registrar-pago">
					<summary>Registrar pago</summary>
					<form method="post" action={ templ.URL(projectPath(p.Folio) + "/pagos") } enctype="multipart/form-data" class="stage-form" data-comprobante-form>
						<div class="followup-dates">
							<label>
								Fecha de pago
								<input type="date" name="fecha" value={ today } max={ today } required/>
							</label>
							<label>
								Monto (con IVA)
								<input type="number" name="monto" value={ centavosValue(p.Balance()) } min="0.01" max={ centavosValue(p.Balance()) } step="0.01" inputmode="decimal" required/>
							</label>
						</div>
						<fieldset class="probability">
							<legend>¿Quieres subir un comprobante de pago?</legend>
							<label>
								<input type="radio" name="comprobante" value="si"/>
								Sí
							</label>
							<label>
								<input type="radio" name="comprobante" value="no" checked/>
								No
							</label>
						</fieldset>
						<label data-comprobante-file hidden>
							Comprobante de pago (PDF, JPG o PNG de hasta 10 MB)
							<input type="file" name="archivo" accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png"/>
						</label>
						<button type="submit" class="primary">Guardar</button>
					</form>
				</details>
			} else {
				<p class="hint">El vendedor del proyecto o un administrador registra los pagos.</p>
			}
		}
	</section>
}

// followUpAndComments is the proyecto's one place to write (issue #22): a prospecto's
// follow-up form, or past prospecto a plain comment box, each with a single Guardar, and
// right below it the history of comments, typed and automatic. En curso (issue #61) the
// probabilidad de cierre stays in view, fixed at Orden colocada 100%, the dates of the
// follow-up are gone, and the purchase order received sits above the comment box.
templ followUpAndComments(p store.Project, today string, files []store.ProjectFile, receipt store.OCReceipt, comments []store.ProjectComment, commentsLV ListView) {
	<section id="historial">
		<h2>Seguimiento y comentarios</h2>
		if p.Status == "prospecto" {
			@FollowUpForm(p, today)
		} else {
			if p.Status == store.StageEnCurso {
				@probabilitySteps()
			}
			if p.HasOC() || p.Status == store.StageEnCurso {
				@ocReceived(p, today, files, receipt)
			}
			<form method="post" action={ templ.URL(projectPath(p.Folio) + "/comentarios") } class="stage-form">
				<label>
					Comentario
					<textarea name="comment" rows="2" maxlength="2000" required></textarea>
				</label>
				<button type="submit">Guardar<span class="visually-hidden">{ " comentario de " + p.Folio }</span></button>
			</form>
		}
		<h3 class="visually-hidden">Historial</h3>
		if len(comments) == 0 {
			<p class="comments-empty">Sin comentarios.</p>
		} else {
			<ol class="comments">
				for _, c := range comments {
					<li>
						<p class="comment-body">{ c.Body }</p>
						<p class="comment-meta">
							{ c.UserName + " · " }
							@Timestamp(c.CreatedAt)
							{ " · en " }
							<a href={ templ.URL("/cotizaciones/" + c.QuoteFolio) }>{ c.QuoteFolio }</a>
						</p>
					</li>
				}
			</ol>
		}
		@listPager(commentsLV, false)
	</section>
}

// FollowUpForm is where a prospecto's follow-up is kept: the probabilidad de cierre as
// radio buttons, the day the purchase order is expected, the day to follow up next and
// the comment that records it. The comment and the next follow-up day are required. The
// radios also show "Orden colocada 100%", which is only reached by receiving the purchase
// order and can't be picked, and "Perdida", which asks for its Motivo instead of the dates
// and comment (static/app.js swaps the fields; without it the server still checks
// everything). today is the viewer's day, so the next follow-up must be after it. The
// dates come filled in with the current ones, so while the next follow-up is still ahead,
// writing the comment is all it takes to save one. O.C. esperada only shows with
// Inminente 90% picked; hidden, it still sends the date it has, so it is kept as it is.
//
// In Inminente 90% the step to receive the purchase order sits between the dates and the
// comment (issue #61). It is a form of its own, and forms don't nest, so the comment
// and Guardar come after it and belong to the follow-up form through their form
// attribute.
templ FollowUpForm(p store.Project, today string) {
	{{ formID := "seguimiento-" + p.Folio }}
	<div class="followup" data-followup>
		<form id={ formID } method="post" action={ templ.URL(seguimientoPath(p.Folio)) } class="stage-form">
			<fieldset class="probability">
				<legend>Probabilidad de cierre</legend>
				for _, st := range store.ProbabilitySteps {
					<label>
						<input type="radio" name="probabilidad" value={ strconv.Itoa(st.Percent) } checked?={ st.Percent == p.Probability } required/>
						{ st.Label }
						<small>{ strconv.Itoa(st.Percent) }%</small>
					</label>
				}
				<label>
					<input type="radio" name="probabilidad_oc" value="100" disabled/>
					Orden colocada
					<small>100%</small>
				</label>
				<label>
					<input type="radio" name="probabilidad" value="perdida" required/>
					Perdida
				</label>
			</fieldset>
			<p class="hint">Desde Alta, el proyecto es relevante para pronóstico: es de los que se revisan cuando el equipo ve qué está por cerrar. En Inminente 90% aparece aquí abajo el paso para recibir la orden de compra, que es lo único que lleva el proyecto a Orden colocada 100%.</p>
			<label data-lost-only hidden>
				Motivo de la pérdida
				<textarea name="reason" rows="2" maxlength="2000"></textarea>
			</label>
			<div class="followup-dates" data-not-lost>
				<label data-imminent-only hidden?={ p.Probability != store.ReceiveOCProbability }>
					O.C. esperada
					<input type="date" name="oc_esperada" value={ p.ExpectedOCDate }/>
				</label>
				<label>
					Próximo seguimiento
					<input type="date" name="proximo_seguimiento" value={ p.NextFollowUpDate } min={ nextDay(today) } required/>
				</label>
			</div>
		</form>
		// The purchase order is only asked for once the sale is about to close.
		if p.Probability == store.ReceiveOCProbability {
			<section class="receive-oc" data-not-lost>
				<h3>Recibir la orden de compra</h3>
				if p.CurrentQuoteStatus != store.QuoteEmitida {
					<p>Para pasarlo a { store.StageLabels[store.StageEnCurso] }, primero emite la revisión <a href={ templ.URL("/cotizaciones/" + p.CurrentQuoteFolio) }>{ p.CurrentQuoteFolio }</a>.</p>
				} else {
					<p>{ receiveOCHint }</p>
					@OCForm(p, today, "Pasar a "+store.StageLabels[store.StageEnCurso], true, false)
				}
			</section>
		}
		<div class="followup-note">
			<label data-not-lost>
				Comentario
				<textarea form={ formID } name="note" rows="2" maxlength="2000" required></textarea>
			</label>
			<button type="submit" form={ formID }>Guardar<span class="visually-hidden">{ " seguimiento de " + p.Folio }</span></button>
		</div>
	</div>
}

// probabilitySteps shows the probabilidad de cierre of a proyecto en curso: every step,
// fixed, with "Orden colocada 100%" checked, all disabled (issue #61).
templ probabilitySteps() {
	<fieldset class="probability" disabled>
		<legend>Probabilidad de cierre</legend>
		for _, st := range store.ProbabilitySteps {
			<label>
				<input type="radio" name="probabilidad_paso" value={ strconv.Itoa(st.Percent) } disabled/>
				{ st.Label }
				<small>{ strconv.Itoa(st.Percent) }%</small>
			</label>
		}
		<label>
			<input type="radio" name="probabilidad_oc" value="100" checked disabled/>
			Orden colocada
			<small>100%</small>
		</label>
	</fieldset>
}

// ocReceived is the purchase order of a proyecto past prospecto (issue #61): its number,
// date and file to open or download, and who put it on record and when. While the
// proyecto is en curso and its facturación still pendiente, a disclosure below it
// corrects the data; one that got there before the data was asked for gets the form open.
templ ocReceived(p store.Project, today string, files []store.ProjectFile, receipt store.OCReceipt) {
	<section id="oc" class="oc-received">
		<h3>Orden de compra recibida</h3>
		if p.HasOC() {
			<dl class="quote-info">
				<dt>No. de O.C.</dt>
				<dd>{ p.OC.Number }</dd>
				<dt>Fecha de la O.C.</dt>
				<dd>{ dateText(p.OC.Date) }</dd>
				<dt>Archivo</dt>
				<dd>
					if len(files) == 0 {
						Sin archivo
					}
					for i, f := range files {
						if i > 0 {
							<br/>
						}
						<a href={ templ.URL(projectFilePath(p.Folio, f.ID)) }>{ f.Filename }</a>
						{ " · " }
						<a href={ templ.URL(projectFilePath(p.Folio, f.ID) + "?descargar=1") }>Descargar<span class="visually-hidden">{ " " + f.Filename }</span></a>
						<small>
							{ " · " + fileSizeText(f.Size) }
							if len(files) > 1 {
								{ " · " + f.UploadedByName + " · " }
								@Timestamp(f.UploadedAt)
								if i == 0 {
									{ " · el vigente" }
								}
							}
						</small>
					}
				</dd>
				<dt>Registró</dt>
				<dd>
					if receipt.UserName != "" {
						{ receipt.UserName + " · " }
						@Timestamp(receipt.At)
					} else {
						Sin registro
					}
				</dd>
			</dl>
		} else {
			<p>Este proyecto pasó a En curso antes de que se pidieran los datos de la orden. Captúralos para poder continuar.</p>
		}
		if p.Status == store.StageEnCurso && p.States.Facturacion == store.FacturacionPendiente {
			if p.HasOC() {
				<details class="disclosure">
					<summary>Corregir la orden de compra</summary>
					@OCForm(p, today, "Guardar O.C.", false, true)
				</details>
			} else {
				@OCForm(p, today, "Guardar O.C.", true, true)
			}
		}
	</section>
}

// ForecastPage is the Pronóstico view, the page the team goes over when it reviews what
// is about to close: one row per prospecto with its dates, cost, price, profit and margin
// and its latest comment, sortable by every column and filterable by vendedor. Nothing is
// edited here: the project number leads to the proyecto page, where follow-up is kept.
// Totals close the table, and the cells that need attention carry a warning in words.
templ ForecastPage(f Forecast, lv ListView, owners []string, user *NavUser) {
	@Layout("Pronóstico", user) {
		<div class="page-title">
			<h1>Pronóstico</h1>
			@HelpLink(HelpPronostico)
		</div>
		if f.All {
			<p>
				Todos los prospectos.
				<a href="/pronostico">Ver solo los relevantes para pronóstico</a>
			</p>
		} else {
			<p>
				Prospectos relevantes para pronóstico (probabilidad Alta o Inminente).
				<a href="/pronostico?todos=1">Ver todos los prospectos</a>
			</p>
		}
		<p class="hint">Para actualizar la probabilidad, las fechas o comentar, abre el proyecto desde su número.</p>
		@listActiveFilters(lv)
		if len(f.Projects) == 0 {
			if lv.HasFilters() {
				<p>Ningún prospecto coincide con el filtro.</p>
			} else if f.All {
				<p>No hay prospectos. Un proyecto se abre al emitir una cotización.</p>
			} else {
				<p>Ningún prospecto es relevante para pronóstico todavía.</p>
			}
		}
		if len(f.Projects) > 0 {
			{{ totals := f.Totals() }}
			<div class="table-scroll">
				<table class="forecast-table">
					<thead>
						<tr>
							@sortHeader(lv, "No. de proyecto", "folio", false)
							@sortHeader(lv, "Cliente", "cliente", false)
							@columnHeader(lv, "Vendedor", "vendedor", choiceFilter(owners))
							@sortHeader(lv, "Probabilidad de cierre", "probabilidad", false)
							@sortHeader(lv, "Próximo seguimiento", "seguimiento", false)
							@sortHeader(lv, "O.C. esperada", "oc", false)
							@sortHeader(lv, "Vigencia", "vigencia", false)
							@sortHeader(lv, "Días sin actualizar", "dias", true)
							@sortHeader(lv, "Costo sin IVA", "costo", true)
							@sortHeader(lv, "Precio de venta sin IVA", "precio", true)
							@sortHeader(lv, "Utilidad", "utilidad", true)
							@sortHeader(lv, "Margen", "margen", true)
							@sortHeader(lv, "Último comentario", "comentario", false)
						</tr>
					</thead>
					<tbody data-announce={ countAnnouncement(len(f.Projects), "prospecto", "prospectos") }>
						for _, p := range f.Projects {
							<tr id={ "p-" + p.Folio }>
								<th scope="row"><a href={ templ.URL(projectPath(p.Folio)) }>{ p.Label() }</a></th>
								<td class="customer">{ p.CustomerName }</td>
								<td>{ p.UserName }</td>
								<td>
									{ probabilityText(p.Probability) }
								</td>
								<td>
									@dateWarningCell(p.NextFollowUpDate, FollowUpWarning(p, f.Today))
								</td>
								<td>
									@dateWarningCell(p.ExpectedOCDate, OCWarning(p, f.Today))
								</td>
								<td>
									@dateWarningCell(p.QuoteValidUntil, VigenciaWarning(p, f.Today))
								</td>
								<td class="num">{ DaysWithoutUpdate(p, f.Today) }</td>
								<td class="num">{ p.Cost().String() }</td>
								<td class="num">{ p.Subtotal.String() }</td>
								<td class="num">{ p.Profit.String() }</td>
								<td class="num">{ ProjectMargin(p) }</td>
								<td class="last-comment">
									if p.LastBody != "" {
										<span class="comment-body">{ p.LastBody }</span>
										<small class="comment-meta">
											{ p.LastUserName + " · " }
											@Timestamp(p.LastAt)
										</small>
									} else {
										Sin comentarios
									}
								</td>
							</tr>
						}
					</tbody>
					<tfoot>
						<tr>
							<th scope="row">Total</th>
							<td colspan="7">{ strconv.Itoa(len(f.Projects)) + " prospectos" }</td>
							<td class="num">{ totals.Cost.String() }</td>
							<td class="num">{ totals.Price.String() }</td>
							<td class="num">{ totals.Profit.String() }</td>
							<td class="num">{ totals.Margin }</td>
							<td></td>
						</tr>
					</tfoot>
				</table>
			</div>
			<p><small>El margen total es la suma de utilidades entre la suma de precios.</small></p>
		}
	}
}

// sortHeader is a table header that only sorts (no filter funnel); num right-aligns it
// over a number column.
templ sortHeader(lv ListView, label, col string, num bool) {
	<th class={ "col-header", templ.KV("num", num) } scope="col">
		<a href={ templ.URL(lv.SortHref(col)) }>{ label } { lv.SortIndicator(col) }</a>
	</th>
}

// dateWarningCell shows a day, or "Sin fecha" when there is none, and marks a warning in
// words, so the colour is not the only signal. A missing day is itself the warning when
// warning is set.
templ dateWarningCell(day, warning string) {
	if day == "" {
		if warning != "" {
			<strong class="overdue">Sin fecha</strong>
		} else {
			Sin fecha
		}
	} else {
		{ dateText(day) }
		if warning != "" {
			<br/>
			<strong class="overdue">{ warning }</strong>
		}
	}
}

// OCForm captures the client's purchase order: number, date, its file (required to
// receive it on a prospecto) and a comment when withNote (receiving the order has none).
// The método de pago is chosen with the factura, not here (issue #61). On a prospecto its button is what moves the proyecto to en curso;
// afterwards the same form corrects the data. primary styles the button as the page's
// main action.
templ OCForm(p store.Project, today, button string, primary, withNote bool) {
	<form method="post" action={ templ.URL(projectPath(p.Folio) + "/oc") } enctype="multipart/form-data" class="stage-form">
		<div class="followup-dates">
			<label>
				No. de O.C.
				<input type="text" name="oc_numero" value={ p.OC.Number } maxlength="100" required/>
			</label>
			<label>
				Fecha de la O.C.
				<input type="date" name="oc_fecha" value={ ocDateValue(p, today) } required/>
			</label>
		</div>
		<label>
			if p.HasOC() {
				Archivo nuevo de la O.C. (opcional; PDF, JPG o PNG de hasta 10 MB)
			} else if p.Status == "prospecto" {
				Archivo de la O.C. (obligatorio; PDF, JPG o PNG de hasta 10 MB)
			} else {
				Archivo de la O.C. (opcional; PDF, JPG o PNG de hasta 10 MB)
			}
			<input type="file" name="archivo" accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" required?={ p.Status == "prospecto" }/>
		</label>
		if withNote {
			<label>
				Comentario (opcional)
				<textarea name="note" rows="2" maxlength="2000"></textarea>
			</label>
		}
		<button type="submit" class={ templ.KV("primary", primary) }>{ button }</button>
	</form>
}
