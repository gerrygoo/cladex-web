package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

func projectPath(folio string) string {
	return "/proyectos/" + folio
}

// etapaPath is the action for the stage buttons on a proyecto — moves it one step along
// the flow, see store.MoveProject.
func etapaPath(folio string) string {
	return projectPath(folio) + "/etapa"
}

// seguimientoPath is the action of a prospecto's follow-up form (probabilidad de cierre
// and its two dates), see store.FollowUpProject.
func seguimientoPath(folio string) string {
	return projectPath(folio) + "/seguimiento"
}

// stageHint says what moving a proyecto out of its current stage means.
func stageHint(stage string) string {
	switch stage {
	case "prospecto":
		return "Cuando el cliente mande su orden de compra, captura sus datos para pasar el proyecto a O.C. recibida. Desde ese momento la cotización ya no se puede revisar."
	case "oc_recibida":
		return "Para pasarlo a Facturado, registra la factura en Facturación y pago, aquí abajo. Sin factura no se puede entregar."
	case "facturado":
		return "Pásalo a En entrega cuando el pedido ya va en camino o se le entregó al cliente."
	case "en_entrega":
		return "Ciérralo cuando el pedido ya se entregó completo. El pago ya está registrado."
	}
	return ""
}

templ ProjectsList(projects []store.Project, lv ListView, customers, owners []string, user *NavUser) {
	@Layout("Proyectos", user) {
		<div class="page-title">
			<h1>Proyectos</h1>
			@HelpLink(HelpProyectos)
		</div>
		<div class="toolbar">
			<form method="get" action="/proyectos" role="search">
				<input
					type="search"
					name="q"
					placeholder="Buscar por folio o cliente…"
					aria-label="Buscar por folio o cliente"
					value={ lv.Query }
					hx-get="/proyectos"
					hx-trigger="keyup changed delay:400ms, search"
					hx-target="#proyectos-tbody"
					hx-swap="outerHTML"
					hx-include="closest form"
					hx-push-url="true"
				/>
				@listHiddenInputs(lv, "q")
				<button type="submit">Buscar</button>
			</form>
		</div>
		@listActiveFilters(lv)
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						@columnHeader(lv, "Proyecto", "folio", textFilter)
						@columnHeader(lv, "Cliente", "cliente", choiceFilter(customers))
						@columnHeader(lv, "Vendedor", "vendedor", choiceFilter(owners))
						@columnHeader(lv, "Etapa", "etapa", projectStageFilter)
						@columnHeader(lv, "Probabilidad", "probabilidad", projectProbabilityFilter)
						@columnHeader(lv, "Pago", "pago", projectPaymentFilter)
						@columnHeader(lv, "Total", "total", numberFilter)
						@columnHeader(lv, "Abierto", "fecha", dateFilter)
					</tr>
				</thead>
				@ProjectsTableBody(projects)
			</table>
		</div>
		@listPager(lv, false)
	}
}

templ ProjectsTableBody(projects []store.Project) {
	<tbody id="proyectos-tbody" data-announce={ countAnnouncement(len(projects), "proyecto", "proyectos") }>
		if len(projects) == 0 {
			<tr>
				<td colspan="8">No se encontraron proyectos. Un proyecto se abre al emitir una cotización.</td>
			</tr>
		}
		for _, p := range projects {
			<tr>
				<td><a href={ templ.URL(projectPath(p.Folio)) }>{ p.Folio }</a></td>
				<td>{ p.CustomerName }</td>
				<td>{ p.UserName }</td>
				<td>
					@StatusBadge(p.Status)
				</td>
				<td>
					if p.Status == "prospecto" {
						{ probabilityText(p.Probability) }
						if p.ForecastRelevant() {
							<br/>
							<strong class="forecast">{ forecastLabel }</strong>
						}
					}
				</td>
				<td>
					if p.Status == "facturado" || p.Status == "en_entrega" || p.Status == "cerrado" {
						{ store.PaymentStatusLabels[p.PaymentStatus] }
					}
				</td>
				<td class="num">{ p.Total.String() }</td>
				<td>
					@Timestamp(p.CreatedAt)
				</td>
			</tr>
		}
	</tbody>
}

// ProjectPage is a proyecto: where it stands, the controls that move it (probability
// while it is a prospecto, the next stage, and an admin-only step back), every quote it
// has had, and its history — the comments of all those quotes in one timeline.
templ ProjectPage(p store.Project, today string, quotes []store.Quote, files []store.ProjectFile, comments []store.ProjectComment, commentsLV ListView, user *NavUser) {
	@Layout("Proyecto "+p.Folio, user) {
		<div class="page-title">
			<h1>Proyecto { p.Folio }</h1>
			@HelpLink(HelpProyecto)
		</div>
		<p>Cliente: { p.CustomerName }</p>
		<dl class="quote-info">
			<dt>Etapa</dt>
			<dd>
				@StatusBadge(p.Status)
			</dd>
			if p.Status == "prospecto" {
				<dt>Probabilidad</dt>
				<dd>
					{ probabilityText(p.Probability) }
					if p.ForecastRelevant() {
						· <strong class="forecast">{ forecastLabel }</strong>
					}
					<br/>
					<small>
						{ "Actualizada " }
						@Timestamp(p.ProbabilityUpdatedAt)
					</small>
				</dd>
			}
			if p.Status == "prospecto" {
				<dt>O.C. esperada</dt>
				<dd>
					if p.ExpectedOCDate != "" {
						{ dateText(p.ExpectedOCDate) }
					} else {
						Sin fecha
					}
				</dd>
				<dt>Próximo seguimiento</dt>
				<dd>
					if p.NextFollowUpDate != "" {
						{ dateText(p.NextFollowUpDate) }
						if p.FollowUpDue(today) {
							· <strong class="overdue">toca darle seguimiento</strong>
						}
					} else {
						Sin fecha
					}
				</dd>
			}
			<dt>Vendedor</dt>
			<dd>{ p.UserName }</dd>
			<dt>Abierto</dt>
			<dd>
				@Timestamp(p.CreatedAt)
			</dd>
			<dt>Cotización vigente</dt>
			<dd>
				<a href={ templ.URL("/cotizaciones/" + p.CurrentQuoteFolio) }>{ p.CurrentQuoteFolio }</a>
				if p.CurrentQuoteStatus == "borrador" {
					· revisión en borrador, aún sin emitir
				}
			</dd>
			<dt>Total</dt>
			<dd>{ p.Total.String() }</dd>
		</dl>
		if p.Status == "perdido" {
			<h2>Proyecto perdido</h2>
			<dl class="quote-info">
				<dt>Motivo</dt>
				<dd class="comment-body">{ p.LostReason }</dd>
				<dt>Se perdió</dt>
				<dd>
					@Timestamp(p.LostAt)
					{ " · estaba en " + store.StageLabels[p.LostFrom] }
				</dd>
			</dl>
			if user != nil && user.IsAdmin {
				<form method="post" action={ templ.URL(projectPath(p.Folio) + "/reabrir") } class="stage-form">
					<label>
						Comentario (opcional)
						<textarea name="note" rows="2" maxlength="2000"></textarea>
					</label>
					<button type="submit">Reabrir como { store.StageLabels[p.LostFrom] }</button>
				</form>
			} else {
				<p class="hint">Si el proyecto revive, pídele a un administrador que lo reabra.</p>
			}
		}
		if p.Status == "prospecto" || store.NextStage(p.Status) != "" {
			<h2>Seguimiento</h2>
		}
		if p.Status == "prospecto" {
			@FollowUpForm(p, "")
		}
		if p.Status == "prospecto" {
			if p.CurrentQuoteStatus != "emitida" {
				<p>Para pasarlo a { store.StageLabels["oc_recibida"] }, primero emite la revisión <a href={ templ.URL("/cotizaciones/" + p.CurrentQuoteFolio) }>{ p.CurrentQuoteFolio }</a>.</p>
			} else {
				<h2>Recibir la orden de compra</h2>
				<p>{ stageHint(p.Status) }</p>
				@OCForm(p, today, "Pasar a O.C. recibida", true)
			}
		} else if p.Status == "oc_recibida" {
			if !p.HasOC() {
				<p>Para facturarlo, primero captura la orden de compra del cliente, aquí abajo.</p>
			} else {
				<p>{ stageHint(p.Status) }</p>
			}
		} else if next := store.NextStage(p.Status); next != "" {
			if next == "cerrado" && !p.Paid() && p.Invoice.Ref == "" {
				<p>Este proyecto llegó a En entrega antes de que se pidiera la factura. Para cerrarlo, pídele a un administrador que lo regrese a O.C. recibida y registra ahí su factura y su pago.</p>
			} else if next == "cerrado" && !p.Paid() {
				<p>Para cerrarlo, primero registra el pago completado en <a href="#pago">Facturación y pago</a>.</p>
			} else {
				<form method="post" action={ templ.URL(etapaPath(p.Folio)) } class="stage-form">
					<p>{ stageHint(p.Status) }</p>
					<input type="hidden" name="to" value={ next }/>
					<label>
						Comentario (opcional)
						<textarea name="note" rows="2" maxlength="2000"></textarea>
					</label>
					<button type="submit" class="primary">Pasar a { store.StageLabels[next] }</button>
				</form>
			}
		} else if p.Status == "cerrado" {
			<p>Este proyecto está cerrado.</p>
		}
		if p.HasOC() && (p.Status == "oc_recibida" || p.Invoice.Ref != "") {
			<section id="pago">
				<h2>Facturación y pago</h2>
				<dl class="quote-info">
					<dt>Forma de pago</dt>
					<dd>{ paymentMethodText(p.OC.PaymentMethod) }</dd>
					<dt>Estado de pago</dt>
					<dd>
						<span class={ "badge", "badge-pago-" + paymentBadge(p.PaymentStatus) }>{ store.PaymentStatusLabels[p.PaymentStatus] }</span>
					</dd>
					if p.Invoice.Ref != "" {
						<dt>{ invoiceLabel(p.OC.PaymentMethod) }</dt>
						<dd>{ p.Invoice.Ref + " · " + dateText(p.Invoice.Date) }</dd>
					}
					if p.PaymentRef != "" {
						<dt>Comprobante de pago</dt>
						<dd>{ p.PaymentRef }</dd>
					}
					if p.PaidAt != "" {
						<dt>Pagado el</dt>
						<dd>{ dateText(p.PaidAt) }</dd>
					}
				</dl>
				if p.Status == "oc_recibida" {
					<form method="post" action={ templ.URL(projectPath(p.Folio) + "/factura") } class="stage-form">
						if p.OC.PaymentMethod == "PUE" {
							<h3>Registrar pago y factura</h3>
							<p>La orden es P.U.E.: cuando el cliente pague y se emita la factura, regístralo aquí. El proyecto pasa a Facturado y queda pagado.</p>
						} else {
							<h3>Registrar factura de anticipo</h3>
							<p>La orden es P.P.D.: cuando se emita la factura de anticipo, regístrala aquí. El proyecto pasa a Facturado y se puede entregar; el pago completado se registra después.</p>
						}
						<div class="followup-dates">
							<label>
								{ "Folio de la " + invoiceWord(p.OC.PaymentMethod) }
								<input type="text" name="folio" maxlength="100" required/>
							</label>
							<label>
								if p.OC.PaymentMethod == "PUE" {
									Fecha de pago
								} else {
									Fecha de la factura
								}
								<input type="date" name="fecha" value={ today } required/>
							</label>
						</div>
						<label>
							Comentario (opcional)
							<textarea name="note" rows="2" maxlength="2000"></textarea>
						</label>
						<button type="submit" class="primary">
							if p.OC.PaymentMethod == "PUE" {
								Registrar pago y pasar a Facturado
							} else {
								Registrar factura y pasar a Facturado
							}
						</button>
					</form>
				} else if p.PaymentStatus == store.PaymentAdvanceInvoiced && (p.Status == "facturado" || p.Status == "en_entrega") {
					<form method="post" action={ templ.URL(projectPath(p.Folio) + "/pago") } class="stage-form">
						<h3>Registrar pago completado</h3>
						<p>Cuando el cliente termine de pagar y se emita el comprobante de pago, regístralo aquí. Sin esto el proyecto no se puede cerrar.</p>
						<div class="followup-dates">
							<label>
								Folio del comprobante de pago
								<input type="text" name="folio" maxlength="100" required/>
							</label>
							<label>
								Fecha de pago
								<input type="date" name="fecha" value={ today } required/>
							</label>
						</div>
						<label>
							Comentario (opcional)
							<textarea name="note" rows="2" maxlength="2000"></textarea>
						</label>
						<button type="submit" class="primary">Registrar pago completado</button>
					</form>
				}
			</section>
		}
		if p.HasOC() || p.Status == "oc_recibida" {
			<section id="oc">
				<h2>Orden de compra del cliente</h2>
				if p.HasOC() {
					<dl class="quote-info">
						<dt>No. de O.C.</dt>
						<dd>{ p.OC.Number }</dd>
						<dt>Fecha</dt>
						<dd>{ dateText(p.OC.Date) }</dd>
						<dt>Forma de pago</dt>
						<dd>{ paymentMethodText(p.OC.PaymentMethod) }</dd>
						<dt>Archivo</dt>
						<dd>
							if len(files) == 0 {
								Sin archivo
							}
							for i, f := range files {
								if i > 0 {
									<br/>
								}
								<a href={ templ.URL(projectFilePath(p.Folio, f.ID)) }>{ f.Filename }</a>
								<small>
									{ " · " + fileSizeText(f.Size) + " · " + f.UploadedByName + " · " }
									@Timestamp(f.UploadedAt)
									if i == 0 && len(files) > 1 {
										{ " · el vigente" }
									}
								</small>
							}
						</dd>
					</dl>
				} else {
					<p>Este proyecto llegó a O.C. recibida antes de que se pidieran los datos de la orden. Captúralos para poder continuar.</p>
				}
				if p.Status == "oc_recibida" {
					if p.HasOC() {
						<h3>Corregir la orden de compra</h3>
						@OCForm(p, today, "Guardar O.C.", false)
					} else {
						@OCForm(p, today, "Guardar O.C.", true)
					}
				}
			</section>
		}
		if prev := store.PrevStage(p.Status); prev != "" && user != nil && user.IsAdmin {
			<form method="post" action={ templ.URL(etapaPath(p.Folio)) } class="stage-form">
				<input type="hidden" name="to" value={ prev }/>
				<button type="submit">Regresar a { store.StageLabels[prev] }</button>
			</form>
		}
		if store.CanLose(p.Status) {
			<form method="post" action={ templ.URL(projectPath(p.Folio) + "/perder") } class="stage-form">
				<h2>Perder el proyecto</h2>
				<p>Márcalo como perdido si el cliente ya no va a comprar. Sale de las etapas activas y su cotización ya no se puede revisar.</p>
				<label>
					Motivo
					<textarea name="reason" rows="2" maxlength="2000" required></textarea>
				</label>
				<button type="submit" class="danger" data-confirm="¿Marcar este proyecto como perdido?">Marcar como perdido</button>
			</form>
		}
		<h2>Cotizaciones</h2>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Folio</th>
						<th>Estado</th>
						<th class="num">Total</th>
						<th>Emitida</th>
					</tr>
				</thead>
				<tbody>
					for _, q := range quotes {
						<tr>
							<td><a href={ templ.URL("/cotizaciones/" + q.Folio) }>{ q.Folio }</a></td>
							<td>
								@StatusBadge(q.Status)
							</td>
							<td class="num">{ q.Total.String() }</td>
							<td>
								if q.IssuedAt != nil {
									@Timestamp(*q.IssuedAt)
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p><a href="/proyectos">Volver a proyectos</a></p>
		<section id="historial">
			<h2>Historial</h2>
			<form method="post" action={ templ.URL(projectPath(p.Folio) + "/comentarios") }>
				<label>
					Agregar un comentario
					<textarea name="comment" rows="3" maxlength="2000" required></textarea>
				</label>
				<button type="submit">Comentar</button>
			</form>
			if len(comments) == 0 {
				<p class="comments-empty">Sin comentarios.</p>
			} else {
				<ol class="comments">
					for _, c := range comments {
						<li>
							<p class="comment-body">{ c.Body }</p>
							<p class="comment-meta">
								{ c.UserName + " · " }
								@Timestamp(c.CreatedAt)
								{ " · en " }
								<a href={ templ.URL("/cotizaciones/" + c.QuoteFolio) }>{ c.QuoteFolio }</a>
							</p>
						</li>
					}
				</ol>
			}
			@listPager(commentsLV, false)
		</section>
	}
}

// FollowUpForm is where a prospecto's follow-up is kept: the probabilidad de cierre as
// five radio buttons, the day the purchase order is expected, the day to follow up next
// and an optional note. volver says where saving returns to ("" is the proyecto's page).
templ FollowUpForm(p store.Project, volver string) {
	<form method="post" action={ templ.URL(seguimientoPath(p.Folio)) } class="stage-form">
		if volver != "" {
			<input type="hidden" name="volver" value={ volver }/>
		}
		<fieldset class="probability">
			<legend>Probabilidad de cierre</legend>
			for _, st := range store.ProbabilitySteps {
				<label>
					<input type="radio" name="probabilidad" value={ strconv.Itoa(st.Percent) } checked?={ st.Percent == p.Probability } required/>
					{ st.Label }
					<small>{ strconv.Itoa(st.Percent) }%</small>
				</label>
			}
		</fieldset>
		if volver == "" {
			<p class="hint">Desde Alta, el proyecto es relevante para pronóstico: es de los que se revisan cuando el equipo ve qué está por cerrar.</p>
		}
		<div class="followup-dates">
			<label>
				O.C. esperada
				<input type="date" name="oc_esperada" value={ p.ExpectedOCDate }/>
			</label>
			<label>
				Próximo seguimiento
				<input type="date" name="proximo_seguimiento" value={ p.NextFollowUpDate }/>
			</label>
		</div>
		<label>
			Comentario (opcional)
			<textarea name="note" rows="2" maxlength="2000"></textarea>
		</label>
		<button type="submit">Guardar seguimiento<span class="visually-hidden">{ " de " + p.Folio }</span></button>
	</form>
}

// ForecastPage is the Pronóstico view, the page the team goes over when it reviews what
// is about to close: each prospecto with its dates, what comes next, its latest news and
// contact, and its follow-up form to update on the spot. Totals close the page.
templ ForecastPage(f Forecast, user *NavUser) {
	@Layout("Pronóstico", user) {
		<div class="page-title">
			<h1>Pronóstico</h1>
			@HelpLink(HelpPronostico)
		</div>
		if f.All {
			<p>
				Todos los prospectos, por fecha esperada de O.C.
				<a href="/pronostico">Ver solo los relevantes para pronóstico</a>
			</p>
		} else {
			<p>
				Prospectos relevantes para pronóstico (probabilidad Alta o Inminente), por fecha esperada de O.C.
				<a href="/pronostico?todos=1">Ver todos los prospectos</a>
			</p>
		}
		if len(f.Projects) == 0 {
			if f.All {
				<p>No hay prospectos. Un proyecto se abre al emitir una cotización.</p>
			} else {
				<p>Ningún prospecto es relevante para pronóstico todavía.</p>
			}
		}
		for _, p := range f.Projects {
			<article class="forecast-card" id={ "p-" + p.Folio }>
				<h2>
					<a href={ templ.URL(projectPath(p.Folio)) }>{ p.Folio }</a>
					{ " · " + p.CustomerName }
				</h2>
				<p class="overview-figure">
					<strong>{ p.Total.String() }</strong>
					{ " · " + probabilityText(p.Probability) }
					if p.ForecastRelevant() {
						· <strong class="forecast">{ forecastLabel }</strong>
					}
				</p>
				<dl class="quote-info">
					<dt>Vendedor</dt>
					<dd>{ p.UserName }</dd>
					<dt>Cotización</dt>
					<dd>
						<a href={ templ.URL("/cotizaciones/" + p.CurrentQuoteFolio) }>{ p.CurrentQuoteFolio }</a>
						if p.CurrentQuoteStatus == "borrador" {
							· revisión en borrador, aún sin emitir
						} else if p.QuoteIssuedAt != "" {
							{ " · emitida " }
							@Timestamp(p.QuoteIssuedAt)
						}
						if p.QuoteValidUntil != "" {
							{ " · vigencia " + dateText(p.QuoteValidUntil) }
						}
					</dd>
					<dt>O.C. esperada</dt>
					<dd>
						if p.ExpectedOCDate != "" {
							{ dateText(p.ExpectedOCDate) }
						} else {
							Sin fecha
						}
					</dd>
					<dt>Próximo evento</dt>
					<dd>
						if next := NextProjectEvent(p, f.Today); next != nil {
							{ next.Label + " · " + dateText(next.Date) }
							if next.Date == f.Today {
								· <strong>hoy</strong>
							}
						} else {
							Ninguno con fecha
						}
						for _, e := range OverdueProjectEvents(p, f.Today) {
							<br/>
							<strong class="overdue">Vencido: { e.Label + " · " + dateText(e.Date) }</strong>
						}
					</dd>
					<dt>Última novedad</dt>
					<dd>
						if p.LastBody != "" {
							<span class="comment-body">{ p.LastBody }</span>
							<br/>
							<small>
								{ p.LastUserName + " · " }
								@Timestamp(p.LastAt)
							</small>
						} else {
							Sin comentarios
						}
					</dd>
					<dt>Contacto</dt>
					<dd>
						if p.ContactName == "" && p.ContactPhone == "" && p.ContactEmail == "" {
							Sin contacto capturado
						} else {
							{ joinNonEmpty(" · ", p.ContactName, p.ContactPhone, p.ContactEmail) }
						}
					</dd>
					<dt>Probabilidad actualizada</dt>
					<dd>
						@Timestamp(p.ProbabilityUpdatedAt)
					</dd>
				</dl>
				@FollowUpForm(p, f.forecastReturn())
			</article>
		}
		if len(f.Projects) > 0 {
			{{ total, weighted := f.Total() }}
			<dl class="quote-info forecast-totals">
				<dt>Proyectos</dt>
				<dd>{ strconv.Itoa(len(f.Projects)) }</dd>
				<dt>Total</dt>
				<dd>{ total }</dd>
				<dt>Total ponderado</dt>
				<dd>
					{ weighted }
					<br/>
					<small>Cada total por su probabilidad de cierre.</small>
				</dd>
			</dl>
		}
	}
}

// OCForm captures the client's purchase order: number, date, forma de pago and,
// optionally, its file. On a prospecto its button is what moves the proyecto to O.C.
// recibida; afterwards the same form corrects the data. primary styles the button as
// the page's main action.
templ OCForm(p store.Project, today, button string, primary bool) {
	<form method="post" action={ templ.URL(projectPath(p.Folio) + "/oc") } enctype="multipart/form-data" class="stage-form">
		<div class="followup-dates">
			<label>
				No. de O.C.
				<input type="text" name="oc_numero" value={ p.OC.Number } maxlength="100" required/>
			</label>
			<label>
				Fecha de la O.C.
				<input type="date" name="oc_fecha" value={ ocDateValue(p, today) } required/>
			</label>
		</div>
		<fieldset class="probability">
			<legend>Forma de pago</legend>
			for _, m := range store.PaymentMethods {
				<label>
					<input type="radio" name="forma_pago" value={ m } checked?={ m == p.OC.PaymentMethod } required/>
					{ paymentMethodText(m) }
				</label>
			}
		</fieldset>
		<label>
			if p.HasOC() {
				Archivo nuevo de la O.C. (opcional; PDF, JPG o PNG de hasta 10 MB)
			} else {
				Archivo de la O.C. (opcional; PDF, JPG o PNG de hasta 10 MB)
			}
			<input type="file" name="archivo" accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png"/>
		</label>
		<label>
			Comentario (opcional)
			<textarea name="note" rows="2" maxlength="2000"></textarea>
		</label>
		<button type="submit" class={ templ.KV("primary", primary) }>{ button }</button>
	</form>
}
