package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

templ CustomersList(customers []store.Customer, lv ListView, successMsg string, user *NavUser) {
	@Layout("Clientes", user) {
		<div class="page-title">
			<h1>Clientes</h1>
			@HelpLink(HelpClientes)
		</div>
		@Flash(successMsg)
		<div class="toolbar">
			<form method="get" action="/clientes" role="search">
				<input
					type="search"
					name="q"
					placeholder="Buscar por nombre, RFC o contacto…"
					aria-label="Buscar por nombre, RFC o contacto"
					value={ lv.Query }
					hx-get="/clientes"
					hx-trigger="keyup changed delay:400ms, search"
					hx-target="#clientes-tbody"
					hx-swap="outerHTML"
					hx-include="closest form"
					hx-push-url="true"
				/>
				@listHiddenInputs(lv, "q")
				<button type="submit">Buscar</button>
			</form>
			<a class="button primary" href="/clientes/nuevo">Nuevo cliente</a>
		</div>
		@listActiveFilters(lv)
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						@columnHeader(lv, "Nombre", "name", textFilter)
						@columnHeader(lv, "RFC", "rfc", textFilter)
						@columnHeader(lv, "Contacto", "contact_name", textFilter)
						@columnHeader(lv, "Teléfono", "phone", textFilter)
						@columnHeader(lv, "Email", "email", textFilter)
						<th><span class="visually-hidden">Acciones</span></th>
					</tr>
				</thead>
				@CustomersTableBody(customers, user != nil && user.IsAdmin)
			</table>
		</div>
		@listPager(lv, false)
	}
}

// CustomersTableBody lists customers. Any user may edit one; only an admin may delete
// it (issue #41).
templ CustomersTableBody(customers []store.Customer, canDelete bool) {
	<tbody id="clientes-tbody" data-announce={ countAnnouncement(len(customers), "cliente", "clientes") }>
		if len(customers) == 0 {
			<tr>
				<td colspan="6">No se encontraron clientes.</td>
			</tr>
		}
		for _, c := range customers {
			<tr>
				<td>{ c.Name }</td>
				<td>{ c.RFC }</td>
				<td>{ c.ContactName }</td>
				<td>{ c.Phone }</td>
				<td>{ c.Email }</td>
				<td class="actions">
					<a class="button" href={ templ.URL("/clientes/" + strconv.FormatInt(c.ID, 10)) }>Editar<span class="visually-hidden">{ " " + c.Name }</span></a>
					if canDelete {
						<form
							method="post"
							action={ templ.URL("/clientes/" + strconv.FormatInt(c.ID, 10) + "/eliminar") }
						>
							<button type="submit" class="danger" data-confirm="¿Eliminar este cliente?">Eliminar<span class="visually-hidden">{ " " + c.Name }</span></button>
						</form>
					}
				</td>
			</tr>
		}
	</tbody>
}

// CustomerFormValues is the view-model for CustomerForm — raw strings so a validation
// error can redisplay exactly what the user typed.
type CustomerFormValues struct {
	Name        string
	RFC         string
	ContactName string
	Phone       string
	Email       string
	Address     string
	PostalCode  string
	TaxRegime   string
	Notes       string
	LegalName   string
	CFDIUse     string
	// Volver and Serie carry a trip from Nueva cotización (issue #29) through the form;
	// CancelHref is where Cancelar goes then ("" for the catalog).
	Volver     string
	Serie      string
	Folio      string
	CancelHref string
}

// SimilarCustomer is an existing customer the new one may duplicate, and where "Usar
// este cliente" takes the user: back to the quote with it selected, or to the catalog.
type SimilarCustomer struct {
	store.Customer
	UseHref string
}

func cancelHref(v CustomerFormValues) string {
	if v.CancelHref != "" {
		return v.CancelHref
	}
	return "/clientes"
}

// similarText is how a possible duplicate is listed: "SONEPAR — RFC: (sin RFC) —
// Contacto: Alfonso Felix".
func similarText(c store.Customer) string {
	rfc := c.RFC
	if rfc == "" {
		rfc = "(sin RFC)"
	}
	t := c.Name + " — RFC: " + rfc
	if c.ContactName != "" {
		t += " — Contacto: " + c.ContactName
	}
	return t
}

// CustomerHistoryEntry is one line of a customer's Historial (issue #41): its creation,
// or an edit with the fields it changed. Who is "" when nobody is recorded, and At is
// "" when not even the date is.
type CustomerHistoryEntry struct {
	Who     string
	At      string // ISO-8601 UTC
	Created bool
	Changes []CustomerFieldChange
}

// CustomerFieldChange is one field an edit changed, with its values as shown on screen.
type CustomerFieldChange struct {
	Label, Old, New string
}

// CustomerForm is the new and edit customer form. similar, on a new one, lists the
// customers it may duplicate (issue #29): a warning, not a block, with a way to use each
// of them, to create the new one anyway (confirmar=1 resubmits the same values) or to go
// back to editing. history, on an existing one, is its Historial, newest first.
templ CustomerForm(title string, action string, values CustomerFormValues, fieldErrors map[string]string, similar []SimilarCustomer, successMsg string, history []CustomerHistoryEntry, user *NavUser) {
	@Layout(title, user) {
		<div class="page-title">
			<h1>{ title }</h1>
			if action == "/clientes/nuevo" {
				@HelpLink(HelpClienteNuevo)
			} else {
				@HelpLink(HelpClienteEditar)
			}
		</div>
		@Flash(successMsg)
		<form method="post" action={ templ.URL(action) }>
			if values.Volver != "" {
				<input type="hidden" name="volver" value={ values.Volver }/>
				<input type="hidden" name="serie" value={ values.Serie }/>
				<input type="hidden" name="folio" value={ values.Folio }/>
			}
			if len(similar) > 0 {
				<div class="notice warning" id="posible-duplicado" role="alert" tabindex="-1">
					<p><strong>Este cliente podría estar duplicado.</strong> Encontramos clientes parecidos ya dados de alta:</p>
					<ul>
						for _, c := range similar {
							<li>
								{ similarText(c.Customer) + " " }
								<a href={ templ.URL(c.UseHref) } class="button">Usar este cliente<span class="visually-hidden">{ " " + c.Name }</span></a>
							</li>
						}
					</ul>
					<p>¿Estás seguro de que quieres darlo de alta?</p>
					<p>
						<button type="submit" name="confirmar" value="1" class="primary">Sí, darlo de alta de todos modos</button>
						<a href="#nombre" class="button" data-dismiss="posible-duplicado">Regresar a editar</a>
					</p>
				</div>
			}
			<label>
				Nombre
				<input type="text" id="nombre" name="name" value={ values.Name } required { errAttrs(fieldErrors, "name")... }/>
			</label>
			@FieldError(fieldErrors, "name")
			<label>
				RFC (opcional)
				<input type="text" name="rfc" value={ values.RFC } { errAttrs(fieldErrors, "rfc")... }/>
			</label>
			@FieldError(fieldErrors, "rfc")
			<label>
				Contacto (opcional)
				<input type="text" name="contact_name" value={ values.ContactName }/>
			</label>
			<label>
				Teléfono (opcional)
				<input type="text" name="phone" value={ values.Phone }/>
			</label>
			<label>
				Email (opcional)
				<input type="text" name="email" value={ values.Email } { errAttrs(fieldErrors, "email")... }/>
			</label>
			@FieldError(fieldErrors, "email")
			<label>
				Dirección (opcional)
				<input type="text" name="address" value={ values.Address }/>
			</label>
			<fieldset>
				<legend>Datos fiscales (opcionales; se piden al facturar)</legend>
				<label>
					Razón social (opcional)
					<span class="hint">Como aparece en la constancia de situación fiscal, sin el régimen de capital (sin "S.A. de C.V.").</span>
					<input type="text" name="legal_name" value={ values.LegalName }/>
				</label>
				<label>
					Código postal fiscal (opcional)
					<input type="text" name="postal_code" value={ values.PostalCode } inputmode="numeric" maxlength="5"/>
				</label>
				<label>
					Régimen fiscal (opcional)
					<select name="tax_regime" { errAttrs(fieldErrors, "tax_regime")... }>
						<option value="">— Sin definir —</option>
						for _, c := range store.TaxRegimes {
							<option value={ c.Code } selected?={ c.Code == values.TaxRegime }>{ c.Code + " - " + c.Description }</option>
						}
					</select>
				</label>
				@FieldError(fieldErrors, "tax_regime")
				<label>
					Uso de CFDI predeterminado (opcional)
					<select name="cfdi_use" { errAttrs(fieldErrors, "cfdi_use")... }>
						<option value="">— Sin definir —</option>
						for _, c := range store.CFDIUses {
							<option value={ c.Code } selected?={ c.Code == values.CFDIUse }>{ c.Code + " - " + c.Description }</option>
						}
					</select>
				</label>
				@FieldError(fieldErrors, "cfdi_use")
			</fieldset>
			<label>
				Notas (opcional)
				<input type="text" name="notes" value={ values.Notes }/>
			</label>
			<button type="submit" class="primary">Guardar</button>
			<a href={ templ.URL(cancelHref(values)) }>Cancelar</a>
		</form>
		if len(history) > 0 {
			@customerHistory(history)
		}
	}
}

// customerHistory is the read-only Historial at the bottom of a customer's page.
templ customerHistory(entries []CustomerHistoryEntry) {
	<div class="section-title">
		<h2 id="historial">Historial</h2>
	</div>
	<ol class="comments history" aria-labelledby="historial">
		for _, e := range entries {
			<li>
				if e.Created {
					if e.At == "" {
						Creado: sin registro
					} else if e.Who == "" {
						{ "Creado: " }
						@Timestamp(e.At)
					} else {
						{ "Creado por " + e.Who + " · " }
						@Timestamp(e.At)
					}
				} else {
					<strong>{ e.Who }</strong>
					{ "· " }
					@Timestamp(e.At)
					<ul>
						for _, c := range e.Changes {
							<li>{ c.Label + ": " + c.Old + " → " + c.New }</li>
						}
					</ul>
				}
			</li>
		}
	</ol>
}
