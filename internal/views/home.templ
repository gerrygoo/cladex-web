package views

import (
	"strconv"
	"time"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// forecastLabel marks a prospecto that counts for the forecast (store.ForecastRelevant).
const forecastLabel = "Relevante para pronóstico"

templ Home(built, now time.Time, buildSHA string, d *store.Dashboard, user *NavUser) {
	@Layout("Inicio", user) {
		// The logo in the header already says where you are; the h1 stays for screen
		// readers and the heading outline, and the first section heading carries the help.
		<h1 class="visually-hidden">Inicio</h1>
		<div class="page-title">
			<h2>Vendedores</h2>
			@HelpLink(HelpInicio)
		</div>
		<p><small>Solo proyectos activos: los que siguen en seguimiento, sin orden de compra recibida y sin estar perdidos. Ordenados por monto sin seguimiento. Un proyecto está sin seguimiento si no tiene fecha de próximo seguimiento o esa fecha es hoy o ya pasó.</small></p>
		<div class="table-scroll">
			<table class="seller-table">
				<thead>
					<tr>
						<th scope="col">Vendedor</th>
						<th scope="col" class="num">Proyectos totales</th>
						<th scope="col" class="num">Pipeline total (sin IVA)</th>
						<th scope="col" class="num">Margen pipeline (sin IVA)</th>
						<th scope="col" class="num">Monto para pronóstico (sin IVA)</th>
						<th scope="col" class="num">Proyectos en pronóstico</th>
						<th scope="col" class="num">Sin seguimiento</th>
						<th scope="col" class="num">Monto sin seguimiento (sin IVA)</th>
						<th scope="col" class="num">O.C. vencidas</th>
					</tr>
				</thead>
				<tbody>
					for _, v := range d.Sellers {
						<tr>
							<th scope="row">{ v.Name }</th>
							<td class="num">
								@folioList(v.Projects, "Proyectos de "+v.Name)
							</td>
							<td class="num">{ v.Pipeline.String() }</td>
							<td class="num">{ SellerMargin(v) }</td>
							<td class="num">{ v.ForecastAmount.String() }</td>
							<td class="num">{ strconv.Itoa(v.ForecastCount) }</td>
							<td class="num">
								@folioList(v.Untracked, "Proyectos sin seguimiento de "+v.Name)
							</td>
							<td class="num">{ v.UntrackedAmount.String() }</td>
							<td class="num">
								@folioList(v.OverdueOC, "Proyectos con O.C. vencida de "+v.Name)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<footer class="build-footer">
			<small title={ "commit " + buildSHA }>
				if built.IsZero() {
					Compilación local (dev)
				} else {
					Compilado el
					@Timestamp(isoTime(built))
					({ BuildAge(built, now) })
				}
			</small>
		</footer>
	}
}

// folioList is a count that opens the list of its proyectos, biggest first: folio
// (leading to its page), client and amount before IVA. Zero is just "0", with nothing to open. It is a native <details>, so it works
// without JS.
templ folioList(folios []store.DashboardProject, label string) {
	if len(folios) == 0 {
		0
	} else {
		<details class="folio-list">
			<summary aria-label={ label + ": " + strconv.Itoa(len(folios)) }>{ strconv.Itoa(len(folios)) }</summary>
			<ul>
				for _, f := range folios {
					<li><a href={ templ.URL(projectPath(f.Folio)) }>{ f.Folio }</a>{ " · " + f.Customer + " · " + f.Amount.String() }</li>
				}
			</ul>
		</details>
	}
}
