package views

import (
	"strconv"
	"time"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// stageLabels names each lifecycle stage as a heading on the home overview; the
// singular status words become plural since each card counts quotes.
var stageLabels = map[string]string{
	"emitida":    "Emitidas",
	"pipeline":   "Pipeline",
	"oc_emitida": "OC emitidas",
	"entregada":  "Entregadas",
	"cerrada":    "Entregadas y cerradas",
	"revisada":   "Revisadas",
}

// vendedorColumns are the per-status counts of the salesperson table, in order.
var vendedorColumns = []string{"emitida", "pipeline", "oc_emitida", "entregada", "cerrada", "revisada"}

templ Home(built, now time.Time, buildSHA string, ov *store.Overview, user *NavUser) {
	@Layout("Inicio", user) {
		// The logo in the header already says where you are; the h1 stays for screen
		// readers and the heading outline, and the first section heading carries the help.
		<h1 class="visually-hidden">Inicio</h1>
		<div class="page-title">
			<h2>Cotizaciones por etapa</h2>
			@HelpLink(HelpInicio)
		</div>
		<div class="overview-stages">
			for _, st := range ov.Stages {
				<section class="overview-stage">
					<h3>{ stageLabels[st.Status] }</h3>
					<p class="overview-figure"><strong>{ strconv.Itoa(st.Count) }</strong> · { st.Total.String() }</p>
					if len(st.Top) == 0 {
						<p><small>Ninguna.</small></p>
					} else {
						<ol>
							for _, q := range st.Top {
								<li>
									<a href={ templ.URL("/cotizaciones/" + q.Folio) }>{ q.Folio }</a>
									{ q.Total.String() }
									<br/>
									<small>{ q.CustomerName } · { q.UserName }</small>
								</li>
							}
						</ol>
					}
				</section>
			}
		</div>
		<h2>Vendedores</h2>
		if len(ov.Vendedores) == 0 {
			<p>Aún no hay cotizaciones.</p>
		} else {
			<p><small>Ordenados por monto en pipeline. Cuenta a quien creó cada cotización, sea vendedor o administrador.</small></p>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th class="num">#</th>
							<th>Vendedor</th>
							<th class="num">Monto en pipeline</th>
							<th class="num">Monto emitido</th>
							for _, st := range vendedorColumns {
								<th class="num">{ stageLabels[st] }</th>
							}
						</tr>
					</thead>
					<tbody>
						for i, v := range ov.Vendedores {
							<tr>
								<td class="num">{ strconv.Itoa(i + 1) }</td>
								<td>{ v.Name }</td>
								<td class="num">{ v.Total["pipeline"].String() }</td>
								<td class="num">{ v.Total["emitida"].String() }</td>
								for _, st := range vendedorColumns {
									<td class="num">{ strconv.Itoa(v.Count[st]) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<footer class="build-footer">
			<small title={ "commit " + buildSHA }>
				if built.IsZero() {
					Compilación local (dev)
				} else {
					Compilado el
					@Timestamp(isoTime(built))
					({ BuildAge(built, now) })
				}
			</small>
		</footer>
	}
}

templ Saludo(mensaje string) {
	<p>{ mensaje }</p>
}
