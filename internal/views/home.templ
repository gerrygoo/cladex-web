package views

import (
	"strconv"
	"time"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// stageLabels names each proyecto stage as a heading on the home overview; the singular
// stage words become plural since each card counts proyectos.
var stageLabels = map[string]string{
	"prospecto":   "Prospectos",
	"oc_recibida": "O.C. recibidas",
	"en_entrega":  "En entrega",
	"cerrado":     "Cerrados",
}

// forecastLabel marks a prospecto that counts for the forecast (store.ForecastRelevant).
const forecastLabel = "Relevante para pronóstico"

templ Home(built, now time.Time, buildSHA string, ov *store.Overview, user *NavUser) {
	@Layout("Inicio", user) {
		// The logo in the header already says where you are; the h1 stays for screen
		// readers and the heading outline, and the first section heading carries the help.
		<h1 class="visually-hidden">Inicio</h1>
		<div class="page-title">
			<h2>Proyectos por etapa</h2>
			@HelpLink(HelpInicio)
		</div>
		<div class="overview-stages">
			for _, st := range ov.Stages {
				<section class="overview-stage">
					<h3><a href={ templ.URL("/proyectos?f.etapa=" + st.Status) }>{ stageLabels[st.Status] }</a></h3>
					<p class="overview-figure"><strong>{ strconv.Itoa(st.Count) }</strong> · { st.Total.String() }</p>
					if st.Status == "prospecto" {
						<p><small>{ forecastLabel }: { strconv.Itoa(st.ForecastCount) } · { st.ForecastTotal.String() }</small></p>
					}
					if len(st.Top) == 0 {
						<p><small>Ninguno.</small></p>
					} else {
						<ol>
							for _, q := range st.Top {
								<li>
									<a href={ templ.URL(projectPath(q.Folio)) }>{ q.Folio }</a>
									{ q.Total.String() }
									<br/>
									<small>{ q.CustomerName } · { q.UserName }</small>
									if q.Status == "prospecto" {
										<br/>
										@ProbabilityTag(q.Probability)
									}
								</li>
							}
						</ol>
					}
				</section>
			}
		</div>
		<h2>Vendedores</h2>
		if len(ov.Vendedores) == 0 {
			<p>Aún no hay proyectos: se abre uno al emitir una cotización.</p>
		} else {
			<p><small>Ordenados por monto relevante para pronóstico. Cuenta a quien creó la cotización que abrió cada proyecto, sea vendedor o administrador.</small></p>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th class="num">#</th>
							<th>Vendedor</th>
							<th class="num">Monto para pronóstico</th>
							<th class="num">Monto en prospectos</th>
							for _, st := range store.ProjectFlow {
								<th class="num">{ stageLabels[st] }</th>
							}
						</tr>
					</thead>
					<tbody>
						for i, v := range ov.Vendedores {
							<tr>
								<td class="num">{ strconv.Itoa(i + 1) }</td>
								<td>{ v.Name }</td>
								<td class="num">{ v.Forecast.String() }</td>
								<td class="num">{ v.Total["prospecto"].String() }</td>
								for _, st := range store.ProjectFlow {
									<td class="num">{ strconv.Itoa(v.Count[st]) }</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<footer class="build-footer">
			<small title={ "commit " + buildSHA }>
				if built.IsZero() {
					Compilación local (dev)
				} else {
					Compilado el
					@Timestamp(isoTime(built))
					({ BuildAge(built, now) })
				}
			</small>
		</footer>
	}
}

templ Saludo(mensaje string) {
	<p>{ mensaje }</p>
}
