package views

import "fmt"

templ Home(buildLabel, buildSHA string, quoteCount int, user *NavUser) {
	@Layout("Inicio", user) {
		<h1>
			Cladex
			@HelpLink(HelpInicio)
		</h1>
		<p>{ fmt.Sprintf("%d cotizaciones", quoteCount) }</p>
		<button hx-get="/saludo" hx-target="#saludo-resultado" hx-swap="innerHTML">
			Probar htmx
		</button>
		<div id="saludo-resultado"></div>
		<footer><small title={ "commit " + buildSHA }>{ buildLabel }</small></footer>
	}
}

templ Saludo(mensaje string) {
	<p>{ mensaje }</p>
}
