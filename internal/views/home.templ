package views

import (
	"strconv"
	"time"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// stageLabels names each lifecycle stage as a heading on the home overview.
var stageLabels = map[string]string{
	"emitida":  "Emitidas",
	"revisada": "Revisadas",
}

templ Home(built, now time.Time, buildSHA string, ov *store.Overview, user *NavUser) {
	@Layout("Inicio", user) {
		<h1>
			Cladex
			@HelpLink(HelpInicio)
		</h1>
		<div class="toolbar">
			<h2>Cotizaciones por etapa</h2>
			<a href="/cotizaciones/nueva"><button type="button">Nueva cotización</button></a>
		</div>
		<div class="overview-stages">
			for _, st := range ov.Stages {
				<section class="overview-stage">
					<h3>{ stageLabels[st.Status] }</h3>
					<p class="overview-figure"><strong>{ strconv.Itoa(st.Count) }</strong> · { st.Total.String() }</p>
					if len(st.Top) == 0 {
						<p><small>Ninguna.</small></p>
					} else {
						<ol>
							for _, q := range st.Top {
								<li>
									<a href={ templ.URL("/cotizaciones/" + q.Folio) }>{ q.Folio }</a>
									{ q.Total.String() }
									<br/>
									<small>{ q.CustomerName } · { q.UserName }</small>
								</li>
							}
						</ol>
					}
				</section>
			}
		</div>
		<h2>Vendedores</h2>
		if len(ov.Vendedores) == 0 {
			<p>Aún no hay cotizaciones.</p>
		} else {
			<p><small>Ordenados por monto emitido. Cuenta a quien creó cada cotización, sea vendedor o administrador.</small></p>
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th>#</th>
							<th>Vendedor</th>
							<th>Monto emitido</th>
							<th>Emitidas</th>
							<th>Revisadas</th>
						</tr>
					</thead>
					<tbody>
						for i, v := range ov.Vendedores {
							<tr>
								<td>{ strconv.Itoa(i + 1) }</td>
								<td>{ v.Name }</td>
								<td>{ v.MontoEmitido.String() }</td>
								<td>{ strconv.Itoa(v.Emitidas) }</td>
								<td>{ strconv.Itoa(v.Revisadas) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<footer class="build-footer">
			<small title={ "commit " + buildSHA }>
				if built.IsZero() {
					Compilación local (dev)
				} else {
					Compilado el
					@Timestamp(isoTime(built))
					({ BuildAge(built, now) })
				}
			</small>
		</footer>
	}
}

templ Saludo(mensaje string) {
	<p>{ mensaje }</p>
}
