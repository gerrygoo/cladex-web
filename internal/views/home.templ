package views

import "fmt"

templ Home(buildSHA string, quoteCount int) {
	@Layout("Inicio") {
		<h1>Cladex</h1>
		<p>{ fmt.Sprintf("%d cotizaciones", quoteCount) }</p>
		<button hx-get="/saludo" hx-target="#saludo-resultado" hx-swap="innerHTML">
			Probar htmx
		</button>
		<div id="saludo-resultado"></div>
		<footer><small>{ "build " + buildSHA }</small></footer>
	}
}

templ Saludo(mensaje string) {
	<p>{ mensaje }</p>
}
