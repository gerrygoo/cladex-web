package views

import (
	"strconv"

	"github.com/gerrygoo/cladex-web/internal/store"
)

// productPriceDisplay renders a product's pre-margin cost for the list table: its flat
// cost, marked "+ materiales" when materials add to it, or just "materiales" for a
// product costed only from what it's made of — see migrations/0002_add_product_cost.sql
// and 0008_materials.sql. The quote's margin goes on top of either.
func productPriceDisplay(p store.Product) string {
	switch {
	case p.CostMicros != nil && p.HasMaterials:
		return p.CostMicros.ToCentavosHalfUp().String() + " + materiales"
	case p.CostMicros != nil:
		return p.CostMicros.ToCentavosHalfUp().String()
	case p.HasMaterials:
		return "materiales"
	default:
		return "—"
	}
}

// ProductEditSections is what the edit form shows below the product's own fields: its
// unit conversions and its materials, each with the error of a refused change to it.
// The create form leaves it zero, since those sections need an existing product.
type ProductEditSections struct {
	Conversions      []store.ProductUnitConversion
	ConversionsError string
	Materials        []store.ProductMaterial
	AllMaterials     []store.Material
	MaterialsError   string
}

templ ProductsList(products []store.Product, lv ListView, families []FilterOption, units []FilterOption, successMsg string, user *NavUser) {
	@Layout("Productos", user) {
		<div class="page-title">
			<h1>Productos</h1>
			@HelpLink(HelpProductos)
		</div>
		@Flash(successMsg)
		<div class="toolbar">
			<form method="get" action="/productos" role="search">
				<input
					type="search"
					name="q"
					placeholder="Buscar por SKU o descripción…"
					aria-label="Buscar por SKU o descripción"
					value={ lv.Query }
					hx-get="/productos"
					hx-trigger="keyup changed delay:400ms, search"
					hx-target="#productos-tbody"
					hx-swap="outerHTML"
					hx-include="closest form"
					hx-push-url="true"
				/>
				@listHiddenInputs(lv, "q")
				<button type="submit">Buscar</button>
			</form>
			<a class="button" href="/productos/nuevo">Nuevo producto</a>
		</div>
		@listActiveFilters(lv)
		<table>
			<thead>
				<tr>
					@columnHeader(lv, "SKU", "sku", textFilter)
					@columnHeader(lv, "Descripción", "description", textFilter)
					@columnHeader(lv, "Familia", "familia", enumFilter(families...))
					@columnHeader(lv, "Costo", "costo", numberFilter)
					@columnHeader(lv, "Unidad", "unidad", enumFilter(units...))
					<th><span class="visually-hidden">Acciones</span></th>
				</tr>
			</thead>
			@ProductsTableBody(products)
		</table>
	}
}

templ ProductsTableBody(products []store.Product) {
	<tbody id="productos-tbody" data-announce={ countAnnouncement(len(products), "producto", "productos") }>
		if len(products) == 0 {
			<tr>
				<td colspan="6">No se encontraron productos.</td>
			</tr>
		}
		for _, p := range products {
			<tr>
				<td>{ p.SKU }</td>
				<td>{ p.Description }</td>
				<td>{ p.FamilyName }</td>
				<td>{ productPriceDisplay(p) }</td>
				<td>{ p.UnitCode }</td>
				<td>
					<a href={ templ.URL("/productos/" + strconv.FormatInt(p.ID, 10)) }>Editar<span class="visually-hidden">{ " " + p.SKU }</span></a>
					<form
						method="post"
						action={ templ.URL("/productos/" + strconv.FormatInt(p.ID, 10) + "/eliminar") }
						style="display:inline"
					>
						<button type="submit" data-confirm="¿Eliminar este producto?">Eliminar<span class="visually-hidden">{ " " + p.SKU }</span></button>
					</form>
				</td>
			</tr>
		}
	</tbody>
}

// ProductFormValues is the view-model for ProductForm — raw strings so a validation
// error can redisplay exactly what the user typed, per the plan's form convention.
type ProductFormValues struct {
	FamilyID    string
	SKU         string
	Description string
	Cost        string
	KgPerM      string
	UnitID      string
}

// ProductForm renders the create/edit form. productID is 0 for the create form, which
// omits the unit-conversions section below it — conversions reference an existing
// product, so they only make sense once one exists (see ProductConversionsSection).
templ ProductForm(title string, action string, values ProductFormValues, fieldErrors map[string]string, successMsg string, families []store.ProductFamily, units []store.Unit, productID int64, sections ProductEditSections, user *NavUser) {
	@Layout(title, user) {
		<div class="page-title">
			<h1>{ title }</h1>
			if productID == 0 {
				@HelpLink(HelpProductoNuevo)
			} else {
				@HelpLink(HelpProductoEditar)
			}
		</div>
		@Flash(successMsg)
		<form method="post" action={ templ.URL(action) }>
			<label>
				SKU
				<input type="text" name="sku" value={ values.SKU } required { errAttrs(fieldErrors, "sku")... }/>
			</label>
			@FieldError(fieldErrors, "sku")
			<label>
				Descripción
				<input type="text" name="description" value={ values.Description } required { errAttrs(fieldErrors, "description")... }/>
			</label>
			@FieldError(fieldErrors, "description")
			<label>
				Familia
				<select name="family_id" required { errAttrs(fieldErrors, "family_id")... }>
					<option value="">— Selecciona —</option>
					for _, f := range families {
						if strconv.FormatInt(f.ID, 10) == values.FamilyID {
							<option value={ strconv.FormatInt(f.ID, 10) } selected>{ f.Name }</option>
						} else {
							<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Name }</option>
						}
					}
				</select>
			</label>
			@FieldError(fieldErrors, "family_id")
			<label>
				Costo (pesos, sin margen — opcional si el producto tiene materiales)
				<input type="text" name="cost" value={ values.Cost } placeholder="p. ej. 45.00" { errAttrs(fieldErrors, "cost")... }/>
			</label>
			@FieldError(fieldErrors, "cost")
			<label>
				Peso (kg/m, opcional — solo informativo, no cambia el precio)
				<input type="text" name="kg_per_m" value={ values.KgPerM } placeholder="p. ej. 0.123" { errAttrs(fieldErrors, "kg_per_m")... }/>
			</label>
			@FieldError(fieldErrors, "kg_per_m")
			<label>
				Unidad (opcional)
				<select name="unit_id">
					<option value="">— Ninguna —</option>
					for _, u := range units {
						if strconv.FormatInt(u.ID, 10) == values.UnitID {
							<option value={ strconv.FormatInt(u.ID, 10) } selected>{ u.Name }</option>
						} else {
							<option value={ strconv.FormatInt(u.ID, 10) }>{ u.Name }</option>
						}
					}
				</select>
			</label>
			<button type="submit">Guardar</button>
			<a href="/productos">Cancelar</a>
		</form>
		if productID != 0 {
			@ProductMaterialsSection(productID, sections.Materials, sections.AllMaterials, sections.MaterialsError)
			@ProductConversionsSection(productID, sections.Conversions, units, sections.ConversionsError)
		}
	}
}

// ProductConversionsSection lists a product's unit conversion rates and offers a form
// to add another. rate_micros is displayed and entered as a plain decimal (the amount
// of "A" per 1 "De" — see migrations/0003_add_units_and_conversions.sql).
templ ProductConversionsSection(productID int64, conversions []store.ProductUnitConversion, units []store.Unit, errorMsg string) {
	<div class="section-title">
		<h2>Conversiones de unidades</h2>
		@SectionHelpLink(HelpConversiones, "conversiones de unidades")
	</div>
	@FormError(errorMsg)
	<div class="table-scroll">
		<table>
			<thead>
				<tr>
					<th>De</th>
					<th>A</th>
					<th>Tasa (A por 1 De)</th>
					<th><span class="visually-hidden">Acciones</span></th>
				</tr>
			</thead>
			<tbody>
				if len(conversions) == 0 {
					<tr>
						<td colspan="4">Sin conversiones registradas.</td>
					</tr>
				}
				for _, c := range conversions {
					<tr>
						<td>{ c.FromUnitCode }</td>
						<td>{ c.ToUnitCode }</td>
						<td>{ c.RateMicros.String() }</td>
						<td>
							<form
								method="post"
								action={ templ.URL("/productos/" + strconv.FormatInt(productID, 10) + "/conversiones/" + strconv.FormatInt(c.ID, 10) + "/eliminar") }
								style="display:inline"
							>
								<button type="submit" data-confirm="¿Eliminar esta conversión?">Eliminar<span class="visually-hidden">{ " " + ("conversión " + c.FromUnitCode + " a " + c.ToUnitCode) }</span></button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<form method="post" action={ templ.URL("/productos/" + strconv.FormatInt(productID, 10) + "/conversiones") }>
		<label>
			De
			<select name="from_unit_id" required>
				for _, u := range units {
					<option value={ strconv.FormatInt(u.ID, 10) }>{ u.Code }</option>
				}
			</select>
		</label>
		<label>
			A
			<select name="to_unit_id" required>
				for _, u := range units {
					<option value={ strconv.FormatInt(u.ID, 10) }>{ u.Code }</option>
				}
			</select>
		</label>
		<label>
			Tasa
			<input type="text" name="rate" placeholder="p. ej. 100" required/>
		</label>
		<button type="submit">Agregar conversión</button>
	</form>
}

// ProductMaterialsSection lists what one unit of the product is made of, and offers a
// form to add another material. A product's cost is its Costo field plus each
// material's quantity x current price; see internal/pricing.
templ ProductMaterialsSection(productID int64, materials []store.ProductMaterial, all []store.Material, errorMsg string) {
	<div class="section-title">
		<h2>Materiales</h2>
		@SectionHelpLink(HelpProductoMateriales, "los materiales del producto")
	</div>
	@FormError(errorMsg)
	<div class="table-scroll">
		<table>
			<thead>
				<tr>
					<th>Material</th>
					<th>Cantidad por unidad del producto</th>
					<th>Precio del material</th>
					<th><span class="visually-hidden">Acciones</span></th>
				</tr>
			</thead>
			<tbody>
				if len(materials) == 0 {
					<tr>
						<td colspan="4">Sin materiales registrados.</td>
					</tr>
				}
				for _, m := range materials {
					<tr>
						<td>{ m.Material.Name }</td>
						<td>{ m.QtyPerUnitMicros.String() } { m.Material.UnitCode }</td>
						<td>{ MaterialPrice(m.Material) }</td>
						<td>
							<form
								method="post"
								action={ templ.URL("/productos/" + strconv.FormatInt(productID, 10) + "/materiales/" + strconv.FormatInt(m.ID, 10) + "/eliminar") }
								style="display:inline"
							>
								<button type="submit" data-confirm="¿Quitar este material?">Eliminar<span class="visually-hidden">{ " " + m.Material.Name }</span></button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	if len(all) > 0 {
		<form method="post" action={ templ.URL("/productos/" + strconv.FormatInt(productID, 10) + "/materiales") }>
			<label>
				Material
				<select name="material_id" required>
					for _, m := range all {
						<option value={ strconv.FormatInt(m.ID, 10) }>{ m.Name } ({ m.UnitCode })</option>
					}
				</select>
			</label>
			<label>
				Cantidad por unidad del producto
				<input type="text" name="qty" placeholder="p. ej. 0.1723" required/>
			</label>
			<button type="submit">Agregar material</button>
		</form>
	}
}
